      "name": "Festival Intro",
      "settings": {
        "section_width": "page-width",
        "background_color": "#ffffff",
        "text_color": "#17191a",
        "accent_color": "#c7a85e",
        "heading": "Festival Jewelry Start Exploring",
        "heading_size": 35,
        "description": "<p>Seasonal jewelry gives brands and retailers a timely way to refresh collections around key shopping moments. Craftaurum supports custom and wholesale development for Christmas, Halloween, Thanksgiving and Black Friday programs, helping you prepare distinctive pieces around your audience, price point and launch schedule.</p>",
        "body_size": 16,
