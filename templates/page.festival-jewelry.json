    "black_friday": {
      "type": "image-text-feature",
      "name": "图文介绍",
      "settings": {
        "section_width": "page-width",
        "background_color": "#17191a",
        "text_color": "#f8f7f4",
        "accent_color": "#c7a85e",
        "heading": "Black Friday Jewelry",
