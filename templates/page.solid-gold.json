          "settings": {
            "title": "10K Gold Jewelry",
            "gold_content": "41.7% GOLD",
            "description": "<p>The lowest gold content in this guide and generally the hardest option. It is suitable for frequent wear and projects where durability and a more accessible material cost are priorities.</p>"
          }
        },
        "k14": {
          "type": "karat",
          "settings": {
            "title": "14K Gold Jewelry",
            "gold_content": "58.5% GOLD",
            "description": "<p>A widely used balance of gold content, durability and everyday wearability. It is a practical choice for rings, earrings, necklaces and other daily-wear fine jewelry.</p>"
          }
        },
        "k18": {
          "type": "karat",
          "settings": {
            "title": "18K Gold Jewelry",
            "gold_content": "75% GOLD",
            "description": "<p>A common premium fine-jewelry standard with richer gold color and higher gold content while retaining enough alloy strength for many jewelry applications.</p>"
          }
        },
        "k20": {
          "type": "karat",
          "settings": {
            "title": "20K Gold Jewelry",
            "gold_content": "83.3% GOLD",
            "description": "<p>A higher-purity option positioned between 18K and 24K. It offers a deeper gold character while requiring more consideration around softness and construction.</p>"
          }
        },
