    "indexed_guide": {
      "type": "content-guide",
      "blocks": {
        "k10": {
          "type": "item",
          "settings": {
            "value": "41.7%",
            "heading": "10K Gold Jewelry",
            "description": "<p>With the lowest gold content in this guide, 10K offers greater hardness and durability. It is well suited to frequent wear and more cost-conscious fine-jewelry programs.</p>",
            "meta_label": "Best For",
            "meta_value": "Everyday Wear"
          }
        },
        "k14": {
          "type": "item",
          "settings": {
            "value": "58.5%",
            "heading": "14K Gold Jewelry",
            "description": "<p>A popular middle ground that balances recognizable gold value with practical durability, making it versatile across rings, earrings and necklaces.</p>",
            "meta_label": "Best For",
            "meta_value": "Daily Fine Jewelry"
          }
        },
        "k18": {
          "type": "item",
          "settings": {
            "value": "75%",
            "heading": "18K Gold Jewelry",
            "description": "<p>A premium fine-jewelry standard with richer gold color and higher gold content while retaining practical alloy strength for many jewelry applications.</p>",
            "meta_label": "Best For",
            "meta_value": "Premium Collections"
          }
        },
        "k20": {
          "type": "item",
          "settings": {
            "value": "83.3%",
            "heading": "20K Gold Jewelry",
            "description": "<p>A higher-purity option with deeper gold character, positioned between 18K and 24K while requiring more consideration around softness and construction.</p>",
            "meta_label": "Best For",
            "meta_value": "High-Purity Pieces"
          }
        },
        "k24": {
          "type": "item",
          "settings": {
            "value": "99.9%",
            "heading": "24K Gold Jewelry",
            "description": "<p>Nearly pure gold with the richest natural gold color and highest gold content, but also the greatest softness and malleability.</p>",
            "meta_label": "Best For",
            "meta_value": "Pure Gold Positioning"
          }
        }
      },
      "block_order": [
        "k10",
        "k14",
        "k18",
        "k20",
        "k24"
      ],
