    "hero": {
      "type": "image-text-feature",
      "name": "Personalized Jewelry Hero",
      "settings": {
        "section_width": "page-width",
        "background_color": "#f8f7f4",
        "text_color": "#17191a",
        "accent_color": "#c7a85e",
        "heading": "Custom Personalized Jewelry Manufacturer",
        "heading_size": 35,
        "subtitle_size": 12,
        "body_size": 16,
        "animation_style": "fade-in",
        "heading_position": "content",
        "subtitle": "PERSONALIZED JEWELRY DEVELOPMENT",
        "top_label": "",
        "top_url": "",
        "top_button_style": "button",
        "body": "<p>Create jewelry that carries a personal story. Craftaurum works with jewelry brands, designers and wholesale partners to develop initials, birthstones, zodiac motifs and meaningful numbers into distinctive collections.</p><p>From early concepts and sampling to production coordination, our team helps translate your ideas into jewelry designed for your market, materials and brand identity.</p>",
        "image": "",
        "image_position": "right",
        "image_ratio": "landscape",
        "cta_label": "Discuss Your Collection",
        "cta_url": "shopify://pages/contact",
        "cta_button_style": "button-unstyled",
        "padding_top": 88,
        "padding_bottom": 88
      }
    },
