    "initial": {
      "type": "image-text-feature",
      "name": "Custom Initial & Name Jewelry",
      "settings": {
        "section_width": "page-width",
        "background_color": "#ffffff",
        "text_color": "#17191a",
        "accent_color": "#c7a85e",
