{% comment %}
  Shared borderless carousel chevrons.
  Render directly after the carousel track inside a .ca-carousel-stage wrapper.
  track_selector, desktop, mobile, tablet determine which viewports show arrows.
{% endcomment %}
<ca-scroll-controls
  class="ca-scroll-controls{% if desktop %} ca-scroll-controls--desktop{% endif %}{% if mobile %} ca-scroll-controls--mobile{% endif %}{% if tablet %} ca-scroll-controls--tablet{% endif %}"
  data-track="{{ track_selector | escape }}"
  aria-label="Carousel navigation"
>
  <button type="button" class="ca-scroll-controls__button" data-direction="previous" aria-label="Previous slide">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 4 7 12l8 8"/></svg>
  </button>
  <button type="button" class="ca-scroll-controls__button" data-direction="next" aria-label="Next slide">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 4 8 8-8 8"/></svg>
  </button>
</ca-scroll-controls>
