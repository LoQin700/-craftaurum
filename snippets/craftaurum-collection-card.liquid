{%- doc -%}
  Shared card for the Craftaurum image collection section.
  Uses only the card's manually configured image, title, and optional link.
  Params: block, attributes (boolean).
{%- enddoc -%}
{% liquid
  assign card_title = block.settings.title
  assign card_image = block.settings.image
  assign card_link = block.settings.link
%}
<div class="ca-collection__item"{% if attributes %} {{ block.shopify_attributes }}{% endif %}>
  {% if card_link != blank %}
    <a class="ca-collection__card" href="{{ card_link }}" aria-label="{{ card_title | default: 'Jewelry category' | escape }}">
  {% else %}
    <div class="ca-collection__card">
  {% endif %}
      {% if card_image != blank %}
        {{
          card_image
          | image_url: width: 1400
          | image_tag:
            loading: 'lazy',
            class: 'ca-collection__image',
            widths: '240, 360, 520, 720, 960, 1200, 1400',
            sizes: '(min-width: 750px) 46vw, (min-width: 480px) 45vw, 95vw'
        }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'ca-collection__placeholder' }}
      {% endif %}
      <span class="ca-collection__shade" aria-hidden="true"></span>
      {% if card_title != blank %}
        <span class="ca-collection__card-title">{{ card_title | escape }}</span>
      {% endif %}
  {% if card_link != blank %}</a>{% else %}</div>{% endif %}
</div>
