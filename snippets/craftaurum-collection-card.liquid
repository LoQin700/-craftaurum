{%- doc -%}
  Shared card for the Craftaurum image collection section.
  Uses the collection's native image and title as fallback, preserving block controls.
  Params: block, card_title_preset, attributes (boolean).
{%- enddoc -%}
{% liquid
  assign selected_collection = block.settings.collection
  assign card_title = block.settings.title
  if card_title == blank and selected_collection != blank
    assign card_title = selected_collection.title
  endif
  assign card_image = block.settings.image
  if card_image == blank and selected_collection != blank
    assign card_image = selected_collection.featured_image
  endif
  assign card_link = block.settings.link
  if card_link == blank and selected_collection != blank
    assign card_link = selected_collection.url
  endif
  assign title_preset = card_title_preset | default: 'h3'
%}
<div class="ca-collection__item"{% if attributes %} {{ block.shopify_attributes }}{% endif %}>
  {% if card_link != blank %}
    <a class="ca-collection__card" href="{{ card_link }}" aria-label="{{ card_title | default: selected_collection.title | escape }}">
  {% else %}
    <div class="ca-collection__card">
  {% endif %}
      {% if card_image != blank %}
        {{
          card_image
          | image_url: width: 1400
          | image_tag:
            loading: 'lazy',
            class: 'ca-collection__image',
            widths: '240, 360, 520, 720, 960, 1200, 1400',
            sizes: '(min-width: 750px) 46vw, (min-width: 480px) 45vw, 95vw'
        }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'ca-collection__placeholder' }}
      {% endif %}
      <span class="ca-collection__shade" aria-hidden="true"></span>
      <span class="ca-collection__outline" aria-hidden="true"></span>
      {% if card_title != blank %}
        <span class="ca-collection__card-title {{ title_preset }}">{{ card_title | escape }}</span>
      {% endif %}
  {% if card_link != blank %}</a>{% else %}</div>{% endif %}
</div>
