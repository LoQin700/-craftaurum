<section
  id="FestivalIntro-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} ca-festival-intro"
  style="
    --ca-festival-bg: {{ section.settings.background_color }};
    --ca-festival-text: {{ section.settings.text_color }};
    --ca-festival-accent: {{ section.settings.accent_color }};
    --ca-festival-heading-size: {{ section.settings.heading_size }}px;
    --ca-festival-body-size: {{ section.settings.body_size }}px;
    --ca-festival-padding-top: {{ section.settings.padding_top }}px;
    --ca-festival-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="ca-festival-intro__surface">
    <div class="ca-festival-intro__inner" data-ca-reveal="{{ section.settings.animation_style | default: 'fade-in' }}">
      {% if section.settings.heading != blank %}
        <h1 class="ca-festival-intro__heading">{{ section.settings.heading | escape }}</h1>
      {% endif %}
      {% if section.settings.description != blank %}
        <div class="ca-festival-intro__description rte">{{ section.settings.description }}</div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="ca-festival-intro__actions">
          {% for block in section.blocks %}
            {% if block.settings.label != blank %}
              {% render 'craftaurum-cta',
                label: block.settings.label,
                link: block.settings.link,
                style_class: 'button-secondary',
                static_label: true
              %}
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .ca-festival-intro::before {
    content:'';
    position:absolute;
    inset:0;
    background:var(--ca-festival-bg);
    pointer-events:none;
  }
  .ca-festival-intro__surface {
    position:relative;
    z-index:1;
    color:var(--ca-festival-text);
  }
  .ca-festival-intro__inner {
    max-width:1060px;
    margin-inline:auto;
    padding-block:var(--ca-festival-padding-top) var(--ca-festival-padding-bottom);
    text-align:center;
  }
  .ca-festival-intro__heading {
    margin:0 0 24px;
    color:inherit;
    font-size:var(--ca-festival-heading-size);
    line-height:1.06;
  }
  .ca-festival-intro__description {
    max-width:900px;
    margin-inline:auto;
    color:color-mix(in srgb,var(--ca-festival-text) 78%,transparent);
    font-size:var(--ca-festival-body-size);
    line-height:1.7;
  }
  .ca-festival-intro__description p { margin:0; }
  .ca-festival-intro__actions {
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:12px;
    margin-top:32px;
  }
  .ca-festival-intro__actions .button-secondary {
    min-width:170px;
  }
  @media screen and (max-width:749px) {
    .ca-festival-intro__inner { text-align:left; }
    .ca-festival-intro__description { margin-inline:0; }
    .ca-festival-intro__actions { justify-content:flex-start; }
    .ca-festival-intro__heading { font-size:min(var(--ca-festival-heading-size),44px); }
  }
{% endstylesheet %}

{% schema %}
{
  "name":"Festival Intro",
  "tag":"section",
  "disabled_on":{"groups":["header","footer"]},
  "settings":[
    {"type":"select","id":"section_width","label":"内容宽度","options":[{"value":"page-width","label":"页面宽度"},{"value":"full-width","label":"全宽"}],"default":"page-width"},
    {"type":"color","id":"background_color","label":"背景颜色","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"文字颜色","default":"#17191A"},
    {"type":"color","id":"accent_color","label":"重点颜色","default":"#C7A85E"},
    {"type":"text","id":"heading","label":"标题","default":"Festival Jewelry Start Exploring"},
    {"type":"range","id":"heading_size","label":"标题字号","min":28,"max":72,"step":1,"unit":"px","default":46},
    {"type":"richtext","id":"description","label":"说明","default":"<p>Build seasonal jewelry collections for key retail moments with flexible custom development and wholesale production.</p>"},
    {"type":"range","id":"body_size","label":"说明字号","min":12,"max":22,"step":1,"unit":"px","default":16},
    {"type":"select","id":"animation_style","label":"入场动画","options":[{"value":"fade-up","label":"Fade Up"},{"value":"fade-in","label":"Fade In"},{"value":"soft-zoom","label":"Soft Zoom"}],"default":"fade-in"},
    {"type":"range","id":"padding_top","label":"上边距","min":0,"max":140,"step":4,"unit":"px","default":52},
    {"type":"range","id":"padding_bottom","label":"下边距","min":0,"max":140,"step":4,"unit":"px","default":64}
  ],
  "blocks":[
    {"type":"button","name":"节日按钮","settings":[
      {"type":"text","id":"label","label":"文字","default":"Christmas Jewelry"},
      {"type":"url","id":"link","label":"链接"}
    ]}
  ],
  "max_blocks":4,
  "presets":[{"name":"Festival Intro","blocks":[{"type":"button"},{"type":"button"},{"type":"button"}]}]
}
{% endschema %}
