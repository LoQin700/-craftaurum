<section {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | handleize }}"{% endif %}
  class="section section--{{ section.settings.section_width | default: 'page-width' }} spacing-style ca-text-heading"
  style="--padding-block-start: {{ section.settings.padding_top }}px; --padding-block-end: {{ section.settings.padding_bottom }}px; --ca-text-heading-size: {{ section.settings.heading_size | default: 35 }}px; --ca-text-body-size: {{ section.settings.body_size | default: 16 }}px;">
  <div class="ca-text-heading__inner" data-ca-reveal="{{ section.settings.animation_style | default: 'fade-up' }}">
    {% if section.settings.heading != blank %}
      <h2 class="ca-text-heading__title">{{ section.settings.heading | escape }}</h2>
    {% endif %}
    {% if section.settings.description != blank %}
      <div class="rte ca-text-heading__body">{{ section.settings.description }}</div>
    {% endif %}
  </div>
</section>
{% stylesheet %}
  .ca-text-heading { scroll-margin-top: 110px; }
  .ca-text-heading__inner { text-align: center; max-width: 850px; margin: 0 auto; }
  .ca-text-heading__title { margin: 0 0 14px; font-size: var(--ca-text-heading-size); line-height: 1.08; }
  .ca-text-heading__body { font-size: var(--ca-text-body-size); line-height: 1.6; }
  .ca-text-heading__body :is(p,ul,ol) { font-size: inherit; line-height: inherit; }
  .ca-text-heading__body p { margin: 0; }
{% endstylesheet %}
{% schema %}
{
  "name": "标题说明",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "内容宽度",
      "options": [
        {
          "value": "page-width",
          "label": "页面宽度"
        },
        {
          "value": "full-width",
          "label": "全宽"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Let's Create Something Together"
    },
    {"type":"range","id":"heading_size","label":"标题字号","min":24,"max":72,"step":1,"unit":"px","default":35},
    {
      "type": "richtext",
      "id": "description",
      "label": "正文",
      "default": "<p>Tell us about your project and our team will get in touch.</p>"
    },
    {"type":"range","id":"body_size","label":"正文字号","min":12,"max":24,"step":1,"unit":"px","default":16},
    {
      "type": "text",
      "id": "anchor_id",
      "label": "页面锚点"
    },
    {"type":"select","id":"animation_style","label":"入场动画","options":[{"value":"fade-up","label":"Fade Up"},{"value":"fade-in","label":"Fade In"},{"value":"soft-zoom","label":"Soft Zoom"}],"default":"fade-up"},
    {
      "type": "range",
      "id": "padding_top",
      "label": "上边距",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下边距",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "标题说明"
    }
  ]
}
{% endschema %}
