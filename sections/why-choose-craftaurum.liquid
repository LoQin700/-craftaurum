      "id": "item_body_size",
      "label": "项目正文字号",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "移动端字号"
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "标题字号",
      "min": 24,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 25
    },
    {
      "type": "range",
      "id": "mobile_body_size",
      "label": "正文字号",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
