<section
  id="WhyChoose-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} ca-why"
  style="
    --ca-why-bg: {{ section.settings.background_color }};
    --ca-why-text: {{ section.settings.text_color }};
    --ca-why-line: {{ section.settings.line_color }};
    --ca-why-columns: {{ section.settings.desktop_columns }};
    --ca-why-mobile-columns: {{ section.settings.mobile_columns }};
    --ca-why-heading-size: {{ section.settings.heading_size }}px;
    --ca-why-heading-size-mobile: {{ section.settings.mobile_heading_size | default: 25 }}px;
    --ca-why-body-size: {{ section.settings.body_size }}px;
    --ca-why-body-size-mobile: {{ section.settings.mobile_body_size | default: 14 }}px;
    --ca-why-item-title-size: {{ section.settings.item_title_size }}px;
    --ca-why-item-title-size-mobile: {{ section.settings.mobile_item_title_size | default: 18 }}px;
    --ca-why-item-body-size: {{ section.settings.item_body_size }}px;
    --ca-why-item-body-size-mobile: {{ section.settings.mobile_item_body_size | default: 14 }}px;
    --ca-why-padding-top: {{ section.settings.padding_top }}px;
    --ca-why-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="ca-why__surface">
    <div class="ca-why__inner" data-ca-reveal="{{ section.settings.animation_style | default: 'fade-up' }}">
      <header class="ca-why__intro">
        <div class="ca-why__intro-title">
          {% if section.settings.heading != blank %}
            <h2 class="ca-why__heading">{{ section.settings.heading | escape }}</h2>
          {% endif %}
        </div>
        <div class="ca-why__intro-copy">
          {% if section.settings.description != blank %}
            <div class="ca-why__description rte">{{ section.settings.description }}</div>
          {% endif %}
        </div>
      </header>

      <div class="ca-why__grid">
        {% for block in section.blocks %}
          <article class="ca-why__item" {{ block.shopify_attributes }}>
            <div class="ca-why__number">{{ forloop.index | prepend: '0' }}</div>
            {% if block.settings.title != blank %}
              <h3 class="ca-why__item-title">{{ block.settings.title | escape }}</h3>
            {% endif %}
            {% if block.settings.description != blank %}
              <div class="ca-why__item-body rte">{{ block.settings.description }}</div>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .ca-why::before {
    content:'';
    position:absolute;
    inset:0;
    background:var(--ca-why-bg);
    pointer-events:none;
  }
  .ca-why__surface { position:relative; z-index:1; color:var(--ca-why-text); }
  .ca-why__inner { padding-block:var(--ca-why-padding-top) var(--ca-why-padding-bottom); }
  .ca-why__intro {
    display:grid;
    grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);
    gap:clamp(32px,6vw,92px);
    align-items:end;
    margin-bottom:38px;
  }
  .ca-why__heading {
    margin:0;
    font-size:var(--ca-why-heading-size);
    line-height:1.08;
    color:inherit;
  }
  .ca-why__description {
    font-size:var(--ca-why-body-size);
    line-height:1.6;
    color:color-mix(in srgb,var(--ca-why-text) 76%,transparent);
  }
  .ca-why__description p { margin:0; }
  .ca-why__grid {
    display:grid;
    grid-template-columns:repeat(var(--ca-why-columns),minmax(0,1fr));
    border-top:1px solid var(--ca-why-line);
    border-bottom:1px solid var(--ca-why-line);
  }
  .ca-why__item {
    min-width:0;
    padding:28px 26px 34px;
    border-right:1px solid var(--ca-why-line);
  }
  .ca-why__item:last-child { border-right:0; }
  .ca-why__number {
    margin-bottom:38px;
    color:color-mix(in srgb,var(--ca-why-text) 48%,transparent);
    font-size:11px;
    letter-spacing:.12em;
  }
  .ca-why__item-title {
    margin:0 0 10px;
    color:inherit;
    font-size:var(--ca-why-item-title-size);
    line-height:1.25;
  }
  .ca-why__item-body {
    font-size:var(--ca-why-item-body-size);
    line-height:1.6;
    color:color-mix(in srgb,var(--ca-why-text) 70%,transparent);
  }
  .ca-why__item-body p { margin:0; }

  @media screen and (max-width:749px) {
    .ca-why__intro { display:block; margin-bottom:26px; }
    .ca-why__intro-title { margin-bottom:14px; }
    .ca-why__heading { font-size:min(var(--ca-why-heading-size),44px); }
    .ca-why__grid { grid-template-columns:repeat(var(--ca-why-mobile-columns),minmax(0,1fr)); }
    .ca-why__item { border-bottom:1px solid var(--ca-why-line); }
    .ca-why__item:nth-child(2n) { border-right:0; }
    .ca-why__item:last-child { border-bottom:0; }
  }

  @media screen and (max-width: 749px) {
    .ca-why__heading { font-size: var(--ca-why-heading-size-mobile); }
    .ca-why__description { font-size: var(--ca-why-body-size-mobile); }
    .ca-why__item-title { font-size: var(--ca-why-item-title-size-mobile); }
    .ca-why__item-body { font-size: var(--ca-why-item-body-size-mobile); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "优势展示",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "基础设置"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "内容宽度",
      "options": [
        {
          "value": "page-width",
          "label": "页面宽度"
        },
        {
          "value": "full-width",
          "label": "全宽"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "内容设置"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Why Choose Craftaurum?"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "正文",
      "default": "<p>Thoughtful development, reliable materials and clear production support for your collection.</p>"
    },
    {
      "type": "header",
      "content": "电脑端布局"
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "每行显示数量",
      "options": [
        {
          "value": "2",
          "label": "2 个"
        },
        {
          "value": "3",
          "label": "3 个"
        },
        {
          "value": "4",
          "label": "4 个"
        }
      ],
      "default": "4"
    },
    {
      "type": "header",
      "content": "移动端布局"
    },
    {
