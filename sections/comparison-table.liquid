{% if section.settings.background_color != blank %}
  {% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}
{% endif %}

<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>

<section
  id="ComparisonTable-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} spacing-style ca-compare{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    --padding-block-start: {{ section.settings.padding_top }}px;
    --padding-block-end: {{ section.settings.padding_bottom }}px;
    --ca-compare-accent: {{ section.settings.accent_color }};
    --ca-compare-line: {{ section.settings.line_color }};
    --ca-compare-label-bg: {{ section.settings.label_background }};
  "
>
  <div class="ca-compare__inner">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.description != blank %}
      <header class="ca-compare__intro">
        {% if section.settings.eyebrow != blank %}
          <p class="ca-compare__eyebrow {{ section.settings.eyebrow_preset }}">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="ca-compare__heading {{ section.settings.heading_preset }}">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="ca-compare__description rte {{ section.settings.body_preset }}">{{ section.settings.description }}</div>
        {% endif %}
      </header>
    {% endif %}

    <div class="ca-compare__scroll">
      <div class="ca-compare__table ca-compare__table--{{ section.settings.column_count }}">
        <div class="ca-compare__row ca-compare__row--head">
          <div class="ca-compare__metric ca-compare__metric--head">{{ section.settings.comparison_label | escape }}</div>

          <div class="ca-compare__product">
            {% if section.settings.column_1_kicker != blank %}
              <span class="ca-compare__kicker">{{ section.settings.column_1_kicker | escape }}</span>
            {% endif %}
            <strong class="ca-compare__product-title {{ section.settings.column_title_preset }}">{{ section.settings.column_1_title | escape }}</strong>
          </div>

          <div class="ca-compare__product">
            {% if section.settings.column_2_kicker != blank %}
              <span class="ca-compare__kicker">{{ section.settings.column_2_kicker | escape }}</span>
            {% endif %}
            <strong class="ca-compare__product-title {{ section.settings.column_title_preset }}">{{ section.settings.column_2_title | escape }}</strong>
          </div>

          {% if section.settings.column_count == '3' %}
            <div class="ca-compare__product">
              {% if section.settings.column_3_kicker != blank %}
                <span class="ca-compare__kicker">{{ section.settings.column_3_kicker | escape }}</span>
              {% endif %}
              <strong class="ca-compare__product-title {{ section.settings.column_title_preset }}">{{ section.settings.column_3_title | escape }}</strong>
            </div>
          {% endif %}
        </div>

        {% for block in section.blocks %}
          <div class="ca-compare__row" {{ block.shopify_attributes }}>
            <div class="ca-compare__metric">{{ block.settings.label | escape }}</div>
            <div class="ca-compare__value rte {{ section.settings.body_preset }}">{{ block.settings.value_1 }}</div>
            <div class="ca-compare__value rte {{ section.settings.body_preset }}">{{ block.settings.value_2 }}</div>
            {% if section.settings.column_count == '3' %}
              <div class="ca-compare__value rte {{ section.settings.body_preset }}">{{ block.settings.value_3 }}</div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .ca-compare__inner { min-width: 0; }

  .ca-compare__intro {
    max-width: 980px;
    margin: 0 auto 42px;
    text-align: center;
  }

  .ca-compare__eyebrow {
    margin: 0 0 10px;
    color: var(--ca-compare-accent);
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .ca-compare__heading { margin: 0 0 14px; }
  .ca-compare__description p { margin: 0; }

  .ca-compare__scroll {
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .ca-compare__table {
    width: 100%;
    min-width: 760px;
    border-top: 1px solid var(--ca-compare-line);
    border-left: 1px solid var(--ca-compare-line);
  }

  .ca-compare__row {
    display: grid;
    border-bottom: 1px solid var(--ca-compare-line);
  }

  .ca-compare__table--2 .ca-compare__row {
    grid-template-columns: minmax(150px, .72fr) repeat(2, minmax(230px, 1fr));
  }

  .ca-compare__table--3 .ca-compare__row {
    grid-template-columns: minmax(160px, .72fr) repeat(3, minmax(220px, 1fr));
  }

  .ca-compare__row > * {
    min-width: 0;
    padding: 20px 22px;
    border-right: 1px solid var(--ca-compare-line);
  }

  .ca-compare__row--head > * {
    padding-top: 26px;
    padding-bottom: 26px;
  }

  .ca-compare__metric {
    background: var(--ca-compare-label-bg);
    font-size: 12px;
    line-height: 1.35;
    letter-spacing: .09em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .ca-compare__metric--head {
    display: flex;
    align-items: center;
  }

  .ca-compare__product {
    background: transparent;
  }

  .ca-compare__kicker {
    display: block;
    margin-bottom: 7px;
    color: var(--ca-compare-accent);
    font-size: 11px;
    line-height: 1.25;
    letter-spacing: .11em;
    text-transform: uppercase;
  }

  .ca-compare__product-title {
    display: block;
    margin: 0;
  }

  .ca-compare__value :is(p, ul, ol) {
    font-size: inherit;
    line-height: inherit;
  }

  .ca-compare__value p { margin: 0; }
  .ca-compare__value strong { font-weight: 700; }

  @media screen and (max-width: 749px) {
    .ca-compare__intro {
      margin-bottom: 28px;
      text-align: left;
    }

    .ca-compare__table {
      min-width: 820px;
    }

    .ca-compare__metric {
      position: sticky;
      left: 0;
      z-index: 2;
      box-shadow: 1px 0 0 var(--ca-compare-line);
    }

    .ca-compare__row--head .ca-compare__metric {
      z-index: 3;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "对比表格",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "内容宽度",
      "options": [
        { "value": "page-width", "label": "页面宽度" },
        { "value": "full-width", "label": "全宽" }
      ],
      "default": "page-width"
    },
    { "type": "color", "id": "background_color", "label": "背景颜色", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "重点颜色", "default": "#C7A85E" },
    { "type": "color", "id": "line_color", "label": "分隔线颜色", "default": "#D8D5CE" },
    { "type": "color", "id": "label_background", "label": "左侧对比项背景", "default": "#F8F7F4" },

    { "type": "text", "id": "eyebrow", "label": "小标题", "default": "COMPARISON" },
    {
      "type": "select",
      "id": "eyebrow_preset",
      "label": "小标题字号",
      "options": [
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h5"
    },
    { "type": "text", "id": "heading", "label": "标题", "default": "Compare Options" },
    {
      "type": "select",
      "id": "heading_preset",
      "label": "标题字号",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    { "type": "richtext", "id": "description", "label": "介绍文字" },
    {
      "type": "select",
      "id": "body_preset",
      "label": "正文字号",
      "options": [
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h5"
    },

    { "type": "header", "content": "对比列" },
    {
      "type": "select",
      "id": "column_count",
      "label": "对比对象数量",
      "options": [
        { "value": "2", "label": "2 列" },
        { "value": "3", "label": "3 列" }
      ],
      "default": "3"
    },
    { "type": "text", "id": "comparison_label", "label": "左上角文字", "default": "Comparison" },
    {
      "type": "select",
      "id": "column_title_preset",
      "label": "列标题字号",
      "options": [
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" }
      ],
      "default": "h4"
    },

    { "type": "text", "id": "column_1_kicker", "label": "第 1 列顶部标签" },
    { "type": "text", "id": "column_1_title", "label": "第 1 列标题", "default": "Option One" },
    { "type": "text", "id": "column_2_kicker", "label": "第 2 列顶部标签" },
    { "type": "text", "id": "column_2_title", "label": "第 2 列标题", "default": "Option Two" },
    {
      "type": "text",
      "id": "column_3_kicker",
      "label": "第 3 列顶部标签",
      "visible_if": "{{ section.settings.column_count == '3' }}"
    },
    {
      "type": "text",
      "id": "column_3_title",
      "label": "第 3 列标题",
      "default": "Option Three",
      "visible_if": "{{ section.settings.column_count == '3' }}"
    },

    { "type": "range", "id": "padding_top", "label": "上边距", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "下边距", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "对比项",
      "settings": [
        { "type": "text", "id": "label", "label": "对比项名称", "default": "Feature" },
        { "type": "richtext", "id": "value_1", "label": "第 1 列内容", "default": "<p>Value</p>" },
        { "type": "richtext", "id": "value_2", "label": "第 2 列内容", "default": "<p>Value</p>" },
        { "type": "richtext", "id": "value_3", "label": "第 3 列内容", "default": "<p>Value</p>" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "对比表格",
      "blocks": [
        { "type": "row", "settings": { "label": "Material" } },
        { "type": "row", "settings": { "label": "Durability" } },
        { "type": "row", "settings": { "label": "Best For" } }
      ]
    }
  ]
}
{% endschema %}
