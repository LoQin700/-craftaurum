{% if section.settings.background_color != blank %}
  {% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}
{% endif %}

<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>

<section
  id="ComparisonTable-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} spacing-style ca-compare{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    --padding-block-start: {{ section.settings.padding_top }}px;
    --padding-block-end: {{ section.settings.padding_bottom }}px;
    --ca-compare-accent: {{ section.settings.accent_color }};
    --ca-compare-line: {{ section.settings.line_color }};
    --ca-compare-label-bg: {{ section.settings.label_background }};
    --ca-compare-header-bg: {{ section.settings.header_background }};
    --ca-compare-cell-bg: {{ section.settings.cell_background }};
    --ca-compare-alt-bg: {{ section.settings.alternate_row_background }};
    --ca-compare-hover-bg: {{ section.settings.hover_background }};
    --ca-compare-header-text: {{ section.settings.header_text_color }};
    --ca-compare-body-text: {{ section.settings.body_text_color }};
    --ca-compare-metric-text: {{ section.settings.metric_text_color }};
    --ca-compare-cell-padding: {{ section.settings.cell_padding }}px;
    --ca-compare-eyebrow-size: {{ section.settings.eyebrow_size | default: 12 }}px;
    --ca-compare-heading-size: {{ section.settings.heading_size | default: 35 }}px;
    --ca-compare-body-size: {{ section.settings.body_size | default: 15 }}px;
    --ca-compare-column-title-size: {{ section.settings.column_title_size | default: 18 }}px;
    --ca-compare-mobile-cols: {{ section.settings.mobile_visible_columns | default: 2.3 }};
    --ca-compare-mobile-label-width: {{ section.settings.mobile_label_width | default: 96 }}px;
    --ca-compare-heading-size-mobile: {{ section.settings.mobile_heading_size | default: 25 }}px;
    --ca-compare-body-size-mobile: {{ section.settings.mobile_body_size | default: 14 }}px;
    --ca-compare-column-title-size-mobile: {{ section.settings.mobile_column_title_size | default: 14 }}px;
  "
>
  <div class="ca-compare__inner" data-ca-reveal="{{ section.settings.animation_style | default: 'fade-up' }}">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.description != blank %}
      <header class="ca-compare__intro ca-compare__intro--{{ section.settings.intro_alignment }}">
        {% if section.settings.eyebrow != blank %}
          <p class="ca-compare__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="ca-compare__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="ca-compare__description rte">{{ section.settings.description }}</div>
        {% endif %}
      </header>
    {% endif %}

    <div class="ca-compare__desktop" tabindex="0" role="region" aria-label="Comparison table, scroll horizontally to see more columns">
      <div class="ca-compare__table ca-compare__table--{{ section.settings.column_count }}">
        <div class="ca-compare__row ca-compare__row--head">
          <div class="ca-compare__metric ca-compare__metric--head">{{ section.settings.comparison_label | escape }}</div>

          <div class="ca-compare__product">
            {% if section.settings.column_1_kicker != blank %}
              <span class="ca-compare__kicker">{{ section.settings.column_1_kicker | escape }}</span>
            {% endif %}
            <strong class="ca-compare__product-title">{{ section.settings.column_1_title | escape }}</strong>
          </div>

          <div class="ca-compare__product">
            {% if section.settings.column_2_kicker != blank %}
              <span class="ca-compare__kicker">{{ section.settings.column_2_kicker | escape }}</span>
            {% endif %}
            <strong class="ca-compare__product-title">{{ section.settings.column_2_title | escape }}</strong>
          </div>

          {% if section.settings.column_count == '3' %}
            <div class="ca-compare__product">
              {% if section.settings.column_3_kicker != blank %}
                <span class="ca-compare__kicker">{{ section.settings.column_3_kicker | escape }}</span>
              {% endif %}
              <strong class="ca-compare__product-title">{{ section.settings.column_3_title | escape }}</strong>
            </div>
          {% endif %}
        </div>

        {% for block in section.blocks %}
          {% assign row_modulo = forloop.index | modulo: 2 %}
          <div class="ca-compare__row{% if row_modulo == 0 %} ca-compare__row--alt{% endif %}" {{ block.shopify_attributes }}>
            <div class="ca-compare__metric">{{ block.settings.label | escape }}</div>
            <div class="ca-compare__value rte">{{ block.settings.value_1 }}</div>
            <div class="ca-compare__value rte">{{ block.settings.value_2 }}</div>
            {% if section.settings.column_count == '3' %}
              <div class="ca-compare__value rte">{{ block.settings.value_3 }}</div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="ca-compare__mobile">
      {% for block in section.blocks %}
        {% assign row_modulo = forloop.index | modulo: 2 %}
        <article class="ca-compare__mobile-group{% if row_modulo == 0 %} ca-compare__mobile-group--alt{% endif %}" {{ block.shopify_attributes }}>
          <h3 class="ca-compare__mobile-metric">{{ block.settings.label | escape }}</h3>

          <div class="ca-compare__mobile-option">
            <div class="ca-compare__mobile-name">
              {% if section.settings.column_1_kicker != blank %}
                <span class="ca-compare__mobile-kicker">{{ section.settings.column_1_kicker | escape }}</span>
              {% endif %}
              <strong>{{ section.settings.column_1_title | escape }}</strong>
            </div>
            <div class="ca-compare__mobile-value rte">{{ block.settings.value_1 }}</div>
          </div>

          <div class="ca-compare__mobile-option">
            <div class="ca-compare__mobile-name">
              {% if section.settings.column_2_kicker != blank %}
                <span class="ca-compare__mobile-kicker">{{ section.settings.column_2_kicker | escape }}</span>
              {% endif %}
              <strong>{{ section.settings.column_2_title | escape }}</strong>
            </div>
            <div class="ca-compare__mobile-value rte">{{ block.settings.value_2 }}</div>
          </div>

          {% if section.settings.column_count == '3' %}
            <div class="ca-compare__mobile-option">
              <div class="ca-compare__mobile-name">
                {% if section.settings.column_3_kicker != blank %}
                  <span class="ca-compare__mobile-kicker">{{ section.settings.column_3_kicker | escape }}</span>
                {% endif %}
                <strong>{{ section.settings.column_3_title | escape }}</strong>
              </div>
              <div class="ca-compare__mobile-value rte">{{ block.settings.value_3 }}</div>
            </div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .ca-compare__inner {
    min-width: 0;
  }

  .ca-compare__intro {
    max-width: 980px;
    margin-bottom: 42px;
  }

  .ca-compare__intro--left {
    margin-right: auto;
    text-align: left;
  }

  .ca-compare__intro--center {
    margin-inline: auto;
    text-align: center;
  }

  .ca-compare__intro--right {
    margin-left: auto;
    text-align: right;
  }

  .ca-compare__eyebrow {
    margin: 0 0 10px;
    color: var(--ca-compare-accent);
    letter-spacing: .14em;
    text-transform: uppercase;
    font-size: var(--ca-compare-eyebrow-size);
  }

  .ca-compare__heading {
    margin: 0 0 14px;
    font-size: var(--ca-compare-heading-size);
    line-height: 1.08;
  }

  .ca-compare__description { font-size: var(--ca-compare-body-size); line-height: 1.6; }

  .ca-compare__description p {
    margin: 0;
  }

  .ca-compare__table {
    width: 100%;
    border-top: 1px solid var(--ca-compare-line);
    border-left: 1px solid var(--ca-compare-line);
    background: var(--ca-compare-cell-bg);
  }

  .ca-compare__row {
    display: grid;
    border-bottom: 1px solid var(--ca-compare-line);
    background: var(--ca-compare-cell-bg);
    transition: background-color .22s ease;
  }

  .ca-compare__row--alt {
    background: var(--ca-compare-alt-bg);
  }

  .ca-compare__table--2 .ca-compare__row {
    grid-template-columns: minmax(160px, .7fr) repeat(2, minmax(0, 1fr));
  }

  .ca-compare__table--3 .ca-compare__row {
    grid-template-columns: minmax(170px, .72fr) repeat(3, minmax(0, 1fr));
  }

  .ca-compare__row > * {
    min-width: 0;
    padding: var(--ca-compare-cell-padding);
    border-right: 1px solid var(--ca-compare-line);
  }

  .ca-compare__row--head > * {
    padding-top: calc(var(--ca-compare-cell-padding) + 4px);
    padding-bottom: calc(var(--ca-compare-cell-padding) + 4px);
    background: var(--ca-compare-header-bg);
    color: var(--ca-compare-header-text);
    font-family: var(--font-heading--family);
  }

  .ca-compare__metric {
    display: flex;
    align-items: flex-start;
    background: var(--ca-compare-label-bg);
    color: var(--ca-compare-metric-text);
    font-size: 12px;
    line-height: 1.4;
    letter-spacing: .08em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .ca-compare__metric--head {
    align-items: center;
  }

  .ca-compare__product {
    min-height: 100%;
  }

  .ca-compare__kicker {
    display: block;
    margin-bottom: 7px;
    color: var(--ca-compare-accent);
    font-size: 11px;
    line-height: 1.25;
    letter-spacing: .11em;
    text-transform: uppercase;
  }

  .ca-compare__product-title {
    display: block;
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: var(--ca-compare-column-title-size);
    line-height: 1.25;
  }

  @media (hover: hover) and (pointer: fine) {
    .ca-compare__desktop .ca-compare__row:not(.ca-compare__row--head):hover > * {
      background: var(--ca-compare-hover-bg);
    }
  }

  .ca-compare__value {
    color: var(--ca-compare-body-text);
    font-size: var(--ca-compare-body-size);
    line-height: 1.55;
  }

  .ca-compare__value :is(p, ul, ol) {
    font-size: inherit;
    line-height: inherit;
  }

  .ca-compare__value p {
    margin: 0;
  }

  .ca-compare__value strong {
    font-weight: 700;
    color: var(--ca-compare-header-text);
  }

  .ca-compare__mobile {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .ca-compare__intro { margin-bottom: 24px; }
    .ca-compare__heading { font-size: var(--ca-compare-heading-size-mobile); }
    .ca-compare__description, .ca-compare__description :is(p,ul,ol) { font-size: var(--ca-compare-body-size-mobile); }
    .ca-compare__desktop {
      display: block;
      width: 100%;
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior-inline: contain;
      scrollbar-width: thin;
    }
    .ca-compare__mobile { display: none; }
    .ca-compare__table {
      --ca-compare-option-width: max(118px, calc((100vw - 40px - var(--ca-compare-mobile-label-width)) / var(--ca-compare-mobile-cols)));
      width: max-content;
      min-width: 100%;
    }
    .ca-compare__table--2 .ca-compare__row { grid-template-columns: var(--ca-compare-mobile-label-width) repeat(2, var(--ca-compare-option-width)); }
    .ca-compare__table--3 .ca-compare__row { grid-template-columns: var(--ca-compare-mobile-label-width) repeat(3, var(--ca-compare-option-width)); }
    .ca-compare__row > * { padding: 12px 9px; overflow-wrap: anywhere; }
    .ca-compare__metric { font-size: 11px; letter-spacing: .025em; }
    .ca-compare__product-title { font-size: var(--ca-compare-column-title-size-mobile); }
    .ca-compare__value { font-size: var(--ca-compare-body-size-mobile); }
    .ca-compare__kicker { font-size: 9px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "对比表格",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "内容宽度",
      "options": [
        { "value": "page-width", "label": "页面宽度" },
        { "value": "full-width", "label": "全宽" }
      ],
      "default": "page-width"
    },

    { "type": "header", "content": "布局" },
    {
      "type": "select",
      "id": "intro_alignment",
      "label": "标题区对齐",
      "options": [
        { "value": "left", "label": "左对齐" },
        { "value": "center", "label": "居中" },
        { "value": "right", "label": "右对齐" }
      ],
      "default": "center"
    },
    { "type": "range", "id": "cell_padding", "label": "表格单元格间距", "min": 12, "max": 36, "step": 2, "unit": "px", "default": 20 },

    { "type": "header", "content": "颜色" },
    { "type": "color", "id": "background_color", "label": "Section 背景", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "重点颜色", "default": "#C7A85E" },
    { "type": "color", "id": "line_color", "label": "分隔线颜色", "default": "#D8D5CE" },
    { "type": "color", "id": "label_background", "label": "对比项背景", "default": "#F8F7F4" },
    { "type": "color", "id": "header_background", "label": "表头背景", "default": "#F3EEE3" },
    { "type": "color", "id": "cell_background", "label": "内容行背景", "default": "#FFFFFF" },
    { "type": "color", "id": "alternate_row_background", "label": "交替行背景", "default": "#FCFBF8" },
    { "type": "color", "id": "hover_background", "label": "行 Hover 高亮", "default": "#F8F2E5" },
    { "type": "color", "id": "header_text_color", "label": "表头文字颜色", "default": "#17191A" },
    { "type": "color", "id": "body_text_color", "label": "内容文字颜色", "default": "#4F514E" },
    { "type": "color", "id": "metric_text_color", "label": "对比项文字颜色", "default": "#17191A" },

    { "type": "header", "content": "标题" },
    { "type": "text", "id": "eyebrow", "label": "小标题", "default": "COMPARISON" },
    { "type": "text", "id": "heading", "label": "标题", "default": "Compare Options" },
    { "type": "richtext", "id": "description", "label": "介绍文字" },

    { "type": "range", "id": "eyebrow_size", "label": "小标题字号", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "heading_size", "label": "标题字号", "min": 24, "max": 72, "step": 1, "unit": "px", "default": 35 },
    { "type": "range", "id": "body_size", "label": "正文字号", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "column_title_size", "label": "列标题字号", "min": 14, "max": 30, "step": 1, "unit": "px", "default": 18 },
    { "type": "header", "content": "手机端表格" },
    { "type": "select", "id": "mobile_visible_columns", "label": "手机端可见对比列", "options": [{ "value": "2", "label": "约 2 列" },{ "value": "2.3", "label": "约 2.3 列" },{ "value": "2.7", "label": "约 2.7 列" },{ "value": "3", "label": "约 3 列" }], "default": "2.3" },
    { "type": "range", "id": "mobile_label_width", "label": "手机端左侧对比项宽度", "min": 72, "max": 144, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "mobile_heading_size", "label": "手机端标题字号", "min": 16, "max": 48, "step": 1, "unit": "px", "default": 25 },
    { "type": "range", "id": "mobile_body_size", "label": "手机端正文字号", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "mobile_column_title_size", "label": "手机端列标题字号", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "select", "id": "animation_style", "label": "入场动画", "options": [
      { "value": "fade-up", "label": "Fade Up" },
      { "value": "fade-in", "label": "Fade In" },
      { "value": "soft-zoom", "label": "Soft Zoom" }
    ], "default": "fade-up" },

    { "type": "header", "content": "对比列" },
    {
      "type": "select",
      "id": "column_count",
      "label": "对比对象数量",
      "options": [
        { "value": "2", "label": "2 列" },
        { "value": "3", "label": "3 列" }
      ],
      "default": "3"
    },
    { "type": "text", "id": "comparison_label", "label": "左上角文字", "default": "Comparison" },

    { "type": "text", "id": "column_1_kicker", "label": "第 1 列顶部标签" },
    { "type": "text", "id": "column_1_title", "label": "第 1 列标题", "default": "Option One" },
    { "type": "text", "id": "column_2_kicker", "label": "第 2 列顶部标签" },
    { "type": "text", "id": "column_2_title", "label": "第 2 列标题", "default": "Option Two" },
    {
      "type": "text",
      "id": "column_3_kicker",
      "label": "第 3 列顶部标签",
      "visible_if": "{{ section.settings.column_count == '3' }}"
    },
    {
      "type": "text",
      "id": "column_3_title",
      "label": "第 3 列标题",
      "default": "Option Three",
      "visible_if": "{{ section.settings.column_count == '3' }}"
    },

    { "type": "range", "id": "padding_top", "label": "上边距", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "下边距", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "对比项",
      "settings": [
        { "type": "text", "id": "label", "label": "对比项名称", "default": "Feature" },
        { "type": "richtext", "id": "value_1", "label": "第 1 列内容", "default": "<p>Value</p>" },
        { "type": "richtext", "id": "value_2", "label": "第 2 列内容", "default": "<p>Value</p>" },
        { "type": "richtext", "id": "value_3", "label": "第 3 列内容", "default": "<p>Value</p>" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "对比表格",
      "blocks": [
        { "type": "row", "settings": { "label": "Material" } },
        { "type": "row", "settings": { "label": "Durability" } },
        { "type": "row", "settings": { "label": "Best For" } }
      ]
    }
  ]
}
{% endschema %}
