{% if section.settings.background_color != blank %}
  {% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}
{% endif %}

<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>

<section
  id="IndexedContentGuide-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} spacing-style ca-index-guide{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    --padding-block-start: {{ section.settings.padding_top }}px;
    --padding-block-end: {{ section.settings.padding_bottom }}px;
    --ca-index-accent: {{ section.settings.accent_color }};
    --ca-index-line: {{ section.settings.line_color }};
    --ca-index-gap: {{ section.settings.column_gap }}px;
    --ca-index-image-size: {{ section.settings.item_image_size }}px;
  "
>
  <div class="ca-index-guide__inner">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.description != blank %}
      <header class="ca-index-guide__intro">
        {% if section.settings.eyebrow != blank %}
          <p class="ca-index-guide__eyebrow {{ section.settings.eyebrow_preset }}">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="ca-index-guide__heading {{ section.settings.heading_preset }}">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="ca-index-guide__description rte {{ section.settings.body_preset }}">{{ section.settings.description }}</div>
        {% endif %}
      </header>
    {% endif %}

    <div class="ca-index-guide__layout">
      <nav class="ca-index-guide__index" aria-label="{{ section.settings.index_aria_label | escape }}">
        {% for block in section.blocks %}
          <a href="#IndexedContentGuide-{{ section.id }}-{{ block.id }}" class="ca-index-guide__index-link">
            <span>{{ block.settings.index_label | default: block.settings.heading | escape }}</span>
            {% if block.settings.value != blank %}
              <strong>{{ block.settings.value | escape }}</strong>
            {% endif %}
          </a>
        {% endfor %}
      </nav>

      <div class="ca-index-guide__content">
        {% for block in section.blocks %}
          <article id="IndexedContentGuide-{{ section.id }}-{{ block.id }}" class="ca-index-guide__item" {{ block.shopify_attributes }}>
            <div class="ca-index-guide__marker">
              {% if block.settings.image != blank %}
                <div class="ca-index-guide__thumb ca-index-guide__thumb--{{ section.settings.item_image_shape }}">
                  {{
                    block.settings.image
                    | image_url: width: 500
                    | image_tag:
                      loading: 'lazy',
                      class: 'ca-index-guide__thumb-image',
                      widths: '120,180,240,320,420,500',
                      sizes: section.settings.item_image_size | append: 'px'
                  }}
                </div>
              {% endif %}
              {% if block.settings.index_label != blank %}
                <div class="ca-index-guide__marker-label">{{ block.settings.index_label | escape }}</div>
              {% endif %}
            </div>

            <div class="ca-index-guide__item-copy">
              {% if block.settings.heading != blank %}
                <h3 class="ca-index-guide__item-title {{ section.settings.item_title_preset }}">{{ block.settings.heading | escape }}</h3>
              {% endif %}

              {% if block.settings.description != blank %}
                <div class="ca-index-guide__item-body rte {{ section.settings.body_preset }}">{{ block.settings.description }}</div>
              {% endif %}

              {% if block.settings.value != blank or block.settings.meta_value != blank %}
                <div class="ca-index-guide__meta">
                  {% if block.settings.value != blank %}
                    <span><strong>{{ block.settings.value | escape }}</strong>{% if section.settings.value_suffix != blank %} {{ section.settings.value_suffix | escape }}{% endif %}</span>
                  {% endif %}
                  {% if block.settings.meta_value != blank %}
                    <span>{% if block.settings.meta_label != blank %}{{ block.settings.meta_label | escape }}: {% endif %}{{ block.settings.meta_value | escape }}</span>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </article>
        {% endfor %}

        {% if section.settings.feature_image != blank or section.settings.feature_heading != blank or section.settings.feature_body != blank %}
          <div class="ca-index-guide__feature ca-index-guide__feature--{{ section.settings.feature_image_position }}">
            {% if section.settings.feature_image != blank %}
              <div class="ca-index-guide__feature-media">
                {{
                  section.settings.feature_image
                  | image_url: width: 1600
                  | image_tag:
                    loading: 'lazy',
                    class: 'ca-index-guide__feature-image',
                    widths: '420,640,840,1100,1400,1600',
                    sizes: '(min-width: 990px) 48vw, 100vw'
                }}
              </div>
            {% endif %}

            {% if section.settings.feature_heading != blank or section.settings.feature_body != blank %}
              <div class="ca-index-guide__feature-copy">
                {% if section.settings.feature_heading != blank %}
                  <h3 class="ca-index-guide__feature-title {{ section.settings.feature_title_preset }}">{{ section.settings.feature_heading | escape }}</h3>
                {% endif %}
                {% if section.settings.feature_body != blank %}
                  <div class="ca-index-guide__feature-body rte {{ section.settings.body_preset }}">{{ section.settings.feature_body }}</div>
                {% endif %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .ca-index-guide__inner { min-width: 0; }

  .ca-index-guide__intro {
    max-width: 900px;
    margin-bottom: 44px;
  }

  .ca-index-guide__eyebrow {
    margin: 0 0 10px;
    color: var(--ca-index-accent);
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .ca-index-guide__heading { margin: 0 0 14px; }
  .ca-index-guide__description p { margin: 0; }

  .ca-index-guide__layout {
    display: grid;
    grid-template-columns: minmax(190px, .42fr) minmax(0, 1.58fr);
    gap: var(--ca-index-gap);
    align-items: start;
  }

  .ca-index-guide__index {
    position: sticky;
    top: calc(var(--header-height, 0px) + 24px);
    border-top: 1px solid var(--ca-index-line);
  }

  .ca-index-guide__index-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--ca-index-line);
    color: inherit;
    text-decoration: none;
  }

  .ca-index-guide__index-link strong {
    color: var(--ca-index-accent);
    font-weight: 600;
  }

  .ca-index-guide__item {
    display: grid;
    grid-template-columns: minmax(120px, .28fr) minmax(0, 1fr);
    gap: 34px;
    padding: 34px 0;
    border-top: 1px solid var(--ca-index-line);
    scroll-margin-top: calc(var(--header-height, 0px) + 32px);
  }

  .ca-index-guide__marker {
    min-width: 0;
  }

  .ca-index-guide__thumb {
    width: var(--ca-index-image-size);
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb) / .04);
    margin-bottom: 14px;
  }

  .ca-index-guide__thumb--circle {
    aspect-ratio: 1 / 1;
    border-radius: 50%;
  }

  .ca-index-guide__thumb--square {
    aspect-ratio: 1 / 1;
  }

  .ca-index-guide__thumb--landscape {
    aspect-ratio: 4 / 3;
  }

  .ca-index-guide__thumb--wide {
    aspect-ratio: 16 / 9;
  }

  .ca-index-guide__thumb-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ca-index-guide__marker-label {
    font-size: clamp(30px, 4vw, 54px);
    line-height: .95;
    font-weight: 700;
    letter-spacing: -.035em;
  }

  .ca-index-guide__item-title {
    margin: 0 0 10px;
  }

  .ca-index-guide__item-body {
    max-width: 66ch;
  }

  .ca-index-guide__item-body p {
    margin: 0;
  }

  .ca-index-guide__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 16px;
    font-size: 12px;
    line-height: 1.4;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .ca-index-guide__meta strong {
    color: var(--ca-index-accent);
  }

  .ca-index-guide__feature {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 34px;
    align-items: center;
    margin-top: 34px;
    padding-top: 36px;
    border-top: 1px solid var(--ca-index-line);
  }

  .ca-index-guide__feature--right .ca-index-guide__feature-media {
    order: 2;
  }

  .ca-index-guide__feature-media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb) / .04);
  }

  .ca-index-guide__feature-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ca-index-guide__feature-title {
    margin: 0 0 10px;
  }

  .ca-index-guide__feature-body p {
    margin: 0 0 1em;
  }

  .ca-index-guide__feature-body p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 989px) {
    .ca-index-guide__layout {
      grid-template-columns: 1fr;
      gap: 34px;
    }

    .ca-index-guide__index {
      position: static;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 24px;
    }
  }

  @media screen and (max-width: 749px) {
    .ca-index-guide__intro { margin-bottom: 28px; }

    .ca-index-guide__index {
      grid-template-columns: 1fr;
    }

    .ca-index-guide__item {
      grid-template-columns: 90px minmax(0, 1fr);
      gap: 20px;
      padding: 28px 0;
    }

    .ca-index-guide__thumb {
      width: min(var(--ca-index-image-size), 76px);
    }

    .ca-index-guide__marker-label {
      font-size: 30px;
    }

    .ca-index-guide__feature,
    .ca-index-guide__feature--right {
      grid-template-columns: 1fr;
    }

    .ca-index-guide__feature--right .ca-index-guide__feature-media {
      order: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "索引内容指南",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "内容宽度",
      "options": [
        { "value": "page-width", "label": "页面宽度" },
        { "value": "full-width", "label": "全宽" }
      ],
      "default": "page-width"
    },
    { "type": "color", "id": "background_color", "label": "背景颜色", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "重点颜色", "default": "#C7A85E" },
    { "type": "color", "id": "line_color", "label": "分隔线颜色", "default": "#D8D5CE" },

    { "type": "text", "id": "eyebrow", "label": "小标题", "default": "GUIDE" },
    {
      "type": "select",
      "id": "eyebrow_preset",
      "label": "小标题字号",
      "options": [
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h5"
    },
    { "type": "text", "id": "heading", "label": "标题", "default": "Content Guide" },
    {
      "type": "select",
      "id": "heading_preset",
      "label": "标题字号",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    { "type": "richtext", "id": "description", "label": "介绍文字" },
    {
      "type": "select",
      "id": "body_preset",
      "label": "正文字号",
      "options": [
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h5"
    },
    {
      "type": "select",
      "id": "item_title_preset",
      "label": "项目标题字号",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h3"
    },

    { "type": "header", "content": "项目小图" },
    {
      "type": "select",
      "id": "item_image_shape",
      "label": "图片形状",
      "options": [
        { "value": "circle", "label": "圆形" },
        { "value": "square", "label": "正方形" },
        { "value": "landscape", "label": "长方形 4:3" },
        { "value": "wide", "label": "横图 16:9" }
      ],
      "default": "square"
    },
    {
      "type": "range",
      "id": "item_image_size",
      "label": "图片固定宽度",
      "min": 48,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 88
    },

    { "type": "header", "content": "自动索引" },
    { "type": "text", "id": "index_aria_label", "label": "索引辅助文字", "default": "Content guide navigation" },
    { "type": "text", "id": "value_suffix", "label": "数值后缀", "info": "例如 GOLD、mm、kg；留空则只显示数值" },

    { "type": "header", "content": "底部图文说明" },
    { "type": "image_picker", "id": "feature_image", "label": "图片" },
    {
      "type": "select",
      "id": "feature_image_position",
      "label": "图片位置",
      "options": [
        { "value": "left", "label": "左侧" },
        { "value": "right", "label": "右侧" }
      ],
      "default": "left"
    },
    { "type": "text", "id": "feature_heading", "label": "标题" },
    {
      "type": "select",
      "id": "feature_title_preset",
      "label": "标题字号",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h3"
    },
    { "type": "richtext", "id": "feature_body", "label": "正文" },

    { "type": "range", "id": "column_gap", "label": "索引与内容间距", "min": 24, "max": 96, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_top", "label": "上边距", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "下边距", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "指南项目",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "小图" },
        { "type": "text", "id": "index_label", "label": "索引标签", "default": "Option A" },
        { "type": "text", "id": "value", "label": "数值", "default": "100%" },
        { "type": "text", "id": "heading", "label": "内容标题", "default": "Option A Details" },
        { "type": "richtext", "id": "description", "label": "正文", "default": "<p>Add the detailed explanation for this item here.</p>" },
        { "type": "text", "id": "meta_label", "label": "附加信息标签" },
        { "type": "text", "id": "meta_value", "label": "附加信息内容" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "索引内容指南",
      "blocks": [
        { "type": "item", "settings": { "index_label": "Option A", "value": "25%", "heading": "Option A" } },
        { "type": "item", "settings": { "index_label": "Option B", "value": "50%", "heading": "Option B" } },
        { "type": "item", "settings": { "index_label": "Option C", "value": "75%", "heading": "Option C" } }
      ]
    }
  ]
}
{% endschema %}
