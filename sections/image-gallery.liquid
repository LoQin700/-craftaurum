{% comment %}
  One recognized Section file with two clearly separate presets:
  - 图片画廊: images only
  - 图文卡片: image + hover image + title + copy + CTA
{% endcomment %}
{% liquid
  assign is_cards = false
  if section.settings.display_mode == 'cards'
    assign is_cards = true
  endif

  assign desktop_columns = section.settings.gallery_desktop_columns
  assign mobile_columns = section.settings.gallery_mobile_columns
  if is_cards
    assign desktop_columns = section.settings.card_desktop_columns
    assign mobile_columns = section.settings.card_mobile_columns
  endif

  assign ratio = '4 / 5'
  if section.settings.image_ratio == 'square'
    assign ratio = '1 / 1'
  elsif section.settings.image_ratio == 'landscape'
    assign ratio = '4 / 3'
  endif
%}

<section
  id="ImageDisplay-{{ section.id }}"
  class="section section--{{ section.settings.section_width | default: 'page-width' }} spacing-style ca-image-display ca-image-display--{{ section.settings.display_mode | default: 'gallery' }}{% if section.settings.mobile_layout == 'carousel' %} ca-image-display--mobile-carousel{% endif %}{% if section.settings.desktop_layout == 'carousel' %} ca-image-display--desktop-carousel{% endif %}"
  style="
    --padding-block-start: {{ section.settings.padding_top }}px;
    --padding-block-end: {{ section.settings.padding_bottom }}px;
    --ca-display-background: {{ section.settings.background_color }};
    --ca-display-text: {{ section.settings.text_color }};
    --ca-display-accent: {{ section.settings.accent_color }};
    --ca-display-gap: {{ section.settings.gap }}px;
    --ca-display-desktop-columns: {{ desktop_columns }};
    --ca-display-mobile-columns: {{ mobile_columns }};
    --ca-display-ratio: {{ ratio }};
  "
>
  <div class="ca-image-display__surface">
    <div class="ca-image-display__inner">
      {% if is_cards %}
        <header class="ca-image-display__intro">
          {% if section.settings.eyebrow != blank %}
            <p class="ca-image-display__eyebrow {{ section.settings.eyebrow_preset | default: 'h5' }}">{{ section.settings.eyebrow | escape }}</p>
          {% endif %}
          {% if section.settings.heading != blank %}
            <h2 class="ca-image-display__heading {{ section.settings.heading_preset | default: 'h2' }}">{{ section.settings.heading | escape }}</h2>
          {% endif %}
          {% if section.settings.description != blank %}
            <div class="ca-image-display__description rte {{ section.settings.body_preset | default: 'h5' }}">{{ section.settings.description }}</div>
          {% endif %}
        </header>
      {% endif %}

      <div class="ca-image-display__grid">
        {% for block in section.blocks %}
          <article class="ca-image-display__item" {{ block.shopify_attributes }}>
            <div class="ca-image-display__media">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'ca-image-display__image ca-image-display__image--primary', widths: '220,360,520,720,960,1200,1400', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 80vw' }}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'ca-image-display__placeholder' }}
              {% endif %}
              {% if is_cards and block.settings.hover_image != blank %}
                {{ block.settings.hover_image | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'ca-image-display__image ca-image-display__image--hover', widths: '220,360,520,720,960,1200,1400', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 80vw' }}
              {% endif %}
            </div>

            {% if is_cards %}
              <div class="ca-image-display__content">
                {% if block.settings.title != blank %}
                  <h3 class="ca-image-display__title {{ section.settings.card_title_preset | default: 'h3' }}">{{ block.settings.title | escape }}</h3>
                {% endif %}
                {% if block.settings.description != blank %}
                  <div class="ca-image-display__text rte {{ section.settings.body_preset | default: 'h5' }}">{{ block.settings.description }}</div>
                {% endif %}
                {% if block.settings.button_label != blank %}
                  <div class="ca-image-display__action">
                    {% render 'craftaurum-cta',
                      label: block.settings.button_label,
                      link: block.settings.link,
                      style_class: block.settings.button_style,
                      static_label: true
                    %}
                  </div>
                {% endif %}
              </div>
            {% endif %}
          </article>
        {% endfor %}
      </div>

      {% if section.settings.mobile_layout == 'carousel' or section.settings.desktop_layout == 'carousel' %}
        {% capture display_slides %}
          {% for block in section.blocks %}
            {% capture slide_content %}
              <article class="ca-image-display__item">
                <div class="ca-image-display__media">
                  {% if block.settings.image != blank %}
                    {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'ca-image-display__image ca-image-display__image--primary', widths: '220,360,520,720,960,1200,1400', sizes: '80vw' }}
                  {% else %}
                    {{ 'image' | placeholder_svg_tag: 'ca-image-display__placeholder' }}
                  {% endif %}
                  {% if is_cards and block.settings.hover_image != blank %}
                    {{ block.settings.hover_image | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'ca-image-display__image ca-image-display__image--hover', widths: '220,360,520,720,960,1200,1400', sizes: '80vw' }}
                  {% endif %}
                </div>
                {% if is_cards %}
                  <div class="ca-image-display__content">
                    {% if block.settings.title != blank %}
                      <h3 class="ca-image-display__title {{ section.settings.card_title_preset | default: 'h3' }}">{{ block.settings.title | escape }}</h3>
                    {% endif %}
                    {% if block.settings.description != blank %}
                      <div class="ca-image-display__text rte {{ section.settings.body_preset | default: 'h5' }}">{{ block.settings.description }}</div>
                    {% endif %}
                    {% if block.settings.button_label != blank %}
                      <div class="ca-image-display__action">
                        {% render 'craftaurum-cta',
                          label: block.settings.button_label,
                          link: block.settings.link,
                          style_class: block.settings.button_style,
                          static_label: true
                        %}
                      </div>
                    {% endif %}
                  </div>
                {% endif %}
              </article>
            {% endcapture %}
            {% render 'slideshow-slide', index: forloop.index0, children: slide_content, class: 'ca-image-display__slide' %}
          {% endfor %}
        {% endcapture %}
        <div class="ca-image-display__carousel">
          {% assign can_scroll = false %}
          {% if section.blocks.size > 1 %}{% assign can_scroll = true %}{% endif %}
          {% render 'slideshow',
            class: 'ca-image-display__slideshow',
            slides: display_slides,
            slide_count: section.blocks.size,
            show_arrows: can_scroll,
            infinite: false,
            icon_style: 'chevron',
            icon_shape: 'none'
          %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .ca-image-display__surface {
    width: 100%;
    background: var(--ca-display-background, #FFFFFF);
    color: var(--ca-display-text, #17191A);
  }
  .ca-image-display__inner { min-width: 0; }
  .ca-image-display__intro { max-width: 960px; margin: 0 auto 36px; text-align: center; }
  .ca-image-display__eyebrow { margin: 0 0 10px; color: var(--ca-display-accent, #C7A85E); letter-spacing: .14em; text-transform: uppercase; }
  .ca-image-display__heading { margin: 0 0 14px; color: inherit; }
  .ca-image-display__description :is(p,ul,ol),
  .ca-image-display__text :is(p,ul,ol) { font-size: inherit; line-height: inherit; }
  .ca-image-display__description p,
  .ca-image-display__text p { margin: 0; }

  .ca-image-display__grid {
    display: grid;
    grid-template-columns: repeat(var(--ca-display-desktop-columns), minmax(0,1fr));
    gap: var(--ca-display-gap);
  }
  .ca-image-display__media {
    position: relative;
    width: 100%;
    aspect-ratio: var(--ca-display-ratio, 4 / 5);
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb) / .04);
  }
  .ca-image-display__image,
  .ca-image-display__placeholder {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity .35s ease, transform .35s ease;
  }
  .ca-image-display__image--hover { opacity: 0; transform: scale(1.025); }
  .ca-image-display__content { padding-top: 14px; }
  .ca-image-display__title { margin: 0 0 8px; color: inherit; }
  .ca-image-display__action { margin-top: 14px; }
  .ca-image-display__carousel { display: none; }

  @media (hover:hover) {
    .ca-image-display--cards .ca-image-display__item:hover .ca-image-display__image--primary { opacity: 0; transform: scale(1.025); }
    .ca-image-display--cards .ca-image-display__item:hover .ca-image-display__image--hover { opacity: 1; transform: scale(1); }
    .ca-image-display--cards .ca-image-display__item:not(:has(.ca-image-display__image--hover)):hover .ca-image-display__image--primary { opacity: 1; transform: scale(1.035); }
  }

  .ca-image-display--desktop-carousel .ca-image-display__grid { display: none; }
  .ca-image-display--desktop-carousel .ca-image-display__carousel { display: block; }
  .ca-image-display__slideshow slideshow-slides { gap: var(--ca-display-gap); }
  .ca-image-display__slideshow slideshow-slide {
    width: calc((100% - (var(--ca-display-desktop-columns) - 1) * var(--ca-display-gap)) / var(--ca-display-desktop-columns));
    flex: 0 0 calc((100% - (var(--ca-display-desktop-columns) - 1) * var(--ca-display-gap)) / var(--ca-display-desktop-columns));
    min-width: 0;
  }

  @media screen and (max-width: 749px) {
    .ca-image-display__intro { text-align: left; margin-bottom: 24px; }
    .ca-image-display__grid { grid-template-columns: repeat(var(--ca-display-mobile-columns), minmax(0,1fr)); }
    .ca-image-display--desktop-carousel:not(.ca-image-display--mobile-carousel) .ca-image-display__grid { display: grid; }
    .ca-image-display--desktop-carousel:not(.ca-image-display--mobile-carousel) .ca-image-display__carousel { display: none; }
    .ca-image-display--mobile-carousel .ca-image-display__grid { display: none; }
    .ca-image-display--mobile-carousel .ca-image-display__carousel { display: block; }
    .ca-image-display__slideshow slideshow-slide {
      width: calc((100% - (var(--ca-display-mobile-columns) - 1) * var(--ca-display-gap)) / var(--ca-display-mobile-columns));
      flex-basis: calc((100% - (var(--ca-display-mobile-columns) - 1) * var(--ca-display-gap)) / var(--ca-display-mobile-columns));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ca-image-display__image { transition: none; }
  }
{% endstylesheet %}

{% schema %}
