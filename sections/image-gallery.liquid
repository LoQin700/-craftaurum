{% comment %}
  Reusable image cards. Images are blocks, not a fixed count.
  Desktop: grid or Horizon slideshow. Mobile: 1–2 columns, grid or slideshow.
  Each card supports a hover image, text and the shared Craftaurum CTA.
{% endcomment %}
<section
  id="ImageGallery-{{ section.id }}"
  class="section section--{{ section.settings.section_width | default: 'page-width' }} spacing-style ca-image-cards"
  style="
    --padding-block-start: {{ section.settings.padding_top }}px;
    --padding-block-end: {{ section.settings.padding_bottom }}px;
    --ca-card-gap: {{ section.settings.gap }}px;
    --ca-card-desktop-columns: {{ section.settings.desktop_columns }};
    --ca-card-mobile-columns: {{ section.settings.mobile_columns }};
  "
>
  <div class="ca-image-cards__inner">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.description != blank %}
      <header class="ca-image-cards__intro">
        {% if section.settings.eyebrow != blank %}
          <p class="ca-image-cards__eyebrow {{ section.settings.eyebrow_preset | default: 'h5' }}">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="{{ section.settings.heading_preset | default: 'h2' }} ca-image-cards__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="ca-image-cards__description rte {{ section.settings.body_preset | default: 'h5' }}">{{ section.settings.description }}</div>
        {% endif %}
      </header>
    {% endif %}

    {% capture cards_grid %}
      {% for block in section.blocks %}
        <article class="ca-image-card" {{ block.shopify_attributes }}>
          <div class="ca-image-card__media">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  class: 'ca-image-card__image ca-image-card__image--primary',
                  widths: '220, 360, 520, 720, 960, 1200',
                  sizes: '(min-width: 990px) 24vw, (min-width: 750px) 33vw, 50vw'
              }}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'ca-image-card__placeholder' }}
            {% endif %}
            {% if block.settings.hover_image != blank %}
              {{
                block.settings.hover_image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  class: 'ca-image-card__image ca-image-card__image--hover',
                  widths: '220, 360, 520, 720, 960, 1200',
                  sizes: '(min-width: 990px) 24vw, (min-width: 750px) 33vw, 50vw'
              }}
            {% endif %}
          </div>
          {% if block.settings.title != blank or block.settings.description != blank or block.settings.button_label != blank %}
            <div class="ca-image-card__content">
              {% if block.settings.title != blank %}
                <h3 class="ca-image-card__title {{ section.settings.card_title_preset | default: 'h3' }}">{{ block.settings.title | escape }}</h3>
              {% endif %}
              {% if block.settings.description != blank %}
                <div class="ca-image-card__text rte {{ section.settings.body_preset | default: 'h5' }}">{{ block.settings.description }}</div>
              {% endif %}
              {% if block.settings.button_label != blank %}
                <div class="ca-image-card__action">
                  {% render 'craftaurum-cta',
                    label: block.settings.button_label,
                    link: block.settings.link,
                    style_class: block.settings.button_style,
                    static_label: true
                  %}
                </div>
              {% endif %}
            </div>
          {% endif %}
        </article>
      {% endfor %}
    {% endcapture %}

    <div class="ca-image-cards__grid{% if section.settings.desktop_layout == 'carousel' %} ca-image-cards__grid--desktop-hidden{% endif %}{% if section.settings.mobile_layout == 'carousel' %} ca-image-cards__grid--mobile-hidden{% endif %}">
      {{ cards_grid }}
    </div>

    {% if section.settings.desktop_layout == 'carousel' or section.settings.mobile_layout == 'carousel' %}
      {% capture card_slides %}
        {% for block in section.blocks %}
          {% capture slide_content %}
            <article class="ca-image-card">
              <div class="ca-image-card__media">
                {% if block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      class: 'ca-image-card__image ca-image-card__image--primary',
                      widths: '220, 360, 520, 720, 960, 1200',
                      sizes: '(min-width: 990px) 24vw, (min-width: 750px) 33vw, 50vw'
                  }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'ca-image-card__placeholder' }}
                {% endif %}
                {% if block.settings.hover_image != blank %}
                  {{
                    block.settings.hover_image
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      class: 'ca-image-card__image ca-image-card__image--hover',
                      widths: '220, 360, 520, 720, 960, 1200',
                      sizes: '(min-width: 990px) 24vw, (min-width: 750px) 33vw, 50vw'
                  }}
                {% endif %}
              </div>
              {% if block.settings.title != blank or block.settings.description != blank or block.settings.button_label != blank %}
                <div class="ca-image-card__content">
                  {% if block.settings.title != blank %}
                    <h3 class="ca-image-card__title {{ section.settings.card_title_preset | default: 'h3' }}">{{ block.settings.title | escape }}</h3>
                  {% endif %}
                  {% if block.settings.description != blank %}
                    <div class="ca-image-card__text rte {{ section.settings.body_preset | default: 'h5' }}">{{ block.settings.description }}</div>
                  {% endif %}
                  {% if block.settings.button_label != blank %}
                    <div class="ca-image-card__action">
                      {% render 'craftaurum-cta',
                        label: block.settings.button_label,
                        link: block.settings.link,
                        style_class: block.settings.button_style,
                        static_label: true
                      %}
                    </div>
                  {% endif %}
                </div>
              {% endif %}
            </article>
          {% endcapture %}
          {% render 'slideshow-slide', index: forloop.index0, children: slide_content, class: 'ca-image-cards__slide' %}
        {% endfor %}
      {% endcapture %}
      {% assign can_scroll = false %}
      {% if section.blocks.size > 1 %}{% assign can_scroll = true %}{% endif %}
      <div class="ca-image-cards__carousel{% if section.settings.desktop_layout == 'carousel' %} ca-image-cards__carousel--desktop{% endif %}{% if section.settings.mobile_layout == 'carousel' %} ca-image-cards__carousel--mobile{% endif %}">
        {% render 'slideshow',
          class: 'ca-image-cards__slideshow',
          slides: card_slides,
          slide_count: section.blocks.size,
          show_arrows: can_scroll,
          infinite: false,
          icon_style: 'chevron',
          icon_shape: 'none'
        %}
      </div>
    {% endif %}
    {% if section.settings.button_label != blank %}
      <div class="ca-image-cards__section-action">
        {% render 'craftaurum-cta',
          label: section.settings.button_label,
          link: section.settings.link,
          style_class: section.settings.button_style,
          static_label: true
        %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .ca-image-cards__inner { min-width: 0; }
  .ca-image-cards__intro { text-align: center; max-width: 980px; margin: 0 auto 34px; }
  .ca-image-cards__eyebrow { margin: 0 0 10px; color: var(--color-accent, #C7A85E); letter-spacing: .14em; text-transform: uppercase; }
  .ca-image-cards__heading { margin: 0 0 14px; }
  .ca-image-cards__description :is(p, ul, ol),
  .ca-image-card__text :is(p, ul, ol) { font-size: inherit; line-height: inherit; }
  .ca-image-cards__description p,
  .ca-image-card__text p { margin: 0; }

  .ca-image-cards__grid {
    display: grid;
    grid-template-columns: repeat(var(--ca-card-desktop-columns), minmax(0,1fr));
    gap: var(--ca-card-gap);
  }
  .ca-image-card { min-width: 0; }
  .ca-image-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb) / .04);
  }
  .ca-image-card__image,
  .ca-image-card__placeholder {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity .35s ease, transform .35s ease;
  }
  .ca-image-card__image--primary { opacity: 1; transform: scale(1); }
  .ca-image-card__image--hover { opacity: 0; transform: scale(1.025); }
  .ca-image-card__placeholder { color: rgb(var(--color-foreground-rgb) / .18); }
  @media (hover:hover) {
    .ca-image-card:hover .ca-image-card__image--primary { opacity: 0; transform: scale(1.025); }
    .ca-image-card:hover .ca-image-card__image--hover { opacity: 1; transform: scale(1); }
    .ca-image-card:not(:has(.ca-image-card__image--hover)):hover .ca-image-card__image--primary { opacity: 1; transform: scale(1.035); }
  }
  .ca-image-card__content { padding-top: 14px; }
  .ca-image-card__title { margin: 0 0 8px; }
  .ca-image-card__action { margin-top: 14px; }
  .ca-image-cards__section-action { display: flex; justify-content: center; margin-top: 26px; }
  .ca-image-cards__carousel { display: none; }
  .ca-image-cards__grid--desktop-hidden { display: none; }
  .ca-image-cards__carousel--desktop { display: block; }
  .ca-image-cards__slideshow slideshow-slides { gap: var(--ca-card-gap); }
  .ca-image-cards__slideshow slideshow-slide {
    width: calc((100% - (var(--ca-card-desktop-columns) - 1) * var(--ca-card-gap)) / var(--ca-card-desktop-columns));
    flex: 0 0 calc((100% - (var(--ca-card-desktop-columns) - 1) * var(--ca-card-gap)) / var(--ca-card-desktop-columns));
    min-width: 0;
  }

  @media screen and (max-width: 749px) {
    .ca-image-cards__intro { margin-bottom: 24px; }
    .ca-image-cards__grid { grid-template-columns: repeat(var(--ca-card-mobile-columns), minmax(0,1fr)); }
    .ca-image-cards__grid--desktop-hidden:not(.ca-image-cards__grid--mobile-hidden) { display: grid; }
    .ca-image-cards__grid--mobile-hidden { display: none; }
    .ca-image-cards__carousel--desktop:not(.ca-image-cards__carousel--mobile) { display: none; }
    .ca-image-cards__carousel--mobile { display: block; }
    .ca-image-cards__slideshow slideshow-slide {
      width: calc((100% - (var(--ca-card-mobile-columns) - 1) * var(--ca-card-gap)) / var(--ca-card-mobile-columns));
      flex-basis: calc((100% - (var(--ca-card-mobile-columns) - 1) * var(--ca-card-gap)) / var(--ca-card-mobile-columns));
    }
    .ca-image-card__media { aspect-ratio: 4 / 5; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ca-image-card__image { transition: none; }
  }
{% endstylesheet %}
