{% liquid
  assign carousel_desktop = false
  if section.settings.desktop_layout == 'carousel'
    assign carousel_desktop = true
  endif
  assign carousel_mobile = false
  if section.settings.mobile_layout == 'carousel'
    assign carousel_mobile = true
  endif
  assign has_scroll_controls = false
  if section.blocks.size > 1
    if carousel_desktop or carousel_mobile
      assign has_scroll_controls = true
    endif
  endif
%}
{% if has_scroll_controls %}
  {{ 'craftaurum-scroll-controls.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'craftaurum-scroll-controls.js' | asset_url }}" defer></script>
{% endif %}
{% liquid
  assign content_width = section.settings.section_width | default: 'page-width'
  assign background_color = section.settings.background_color | default: '#FFFFFF'
  assign desktop_columns = section.settings.desktop_columns | default: 4
  assign mobile_columns = section.settings.mobile_columns | default: 2
  assign gap = section.settings.gap | default: 18
  assign padding_top = section.settings.padding_top | default: 48
  assign padding_bottom = section.settings.padding_bottom | default: 48
  assign ratio = '4 / 5'
  if section.settings.image_ratio == 'square'
    assign ratio = '1 / 1'
  elsif section.settings.image_ratio == 'landscape'
    assign ratio = '4 / 3'
  endif
%}
<section id="ImageGallery-{{ section.id }}" class="section section--full-width ca-gallery"
  style="--ca-gallery-bg:{{ background_color }};--ca-gallery-gap:{{ gap }}px;--ca-gallery-desktop:{{ desktop_columns }};--ca-gallery-mobile:{{ mobile_columns }};--ca-gallery-ratio:{{ ratio }};--ca-gallery-pt:{{ padding_top }}px;--ca-gallery-pb:{{ padding_bottom }}px;--ca-gallery-heading-size:{{ section.settings.heading_size | default: 35 }}px;
    --ca-gallery-heading-size-mobile: {{ section.settings.mobile_heading_size | default: 25 }}px;--ca-gallery-body-size:{{ section.settings.body_size | default: 16 }}px;
    --ca-gallery-body-size-mobile: {{ section.settings.mobile_body_size | default: 14 }}px;">
  <div class="ca-gallery__surface">
    <div class="ca-gallery__inner ca-gallery__inner--{{ content_width }}{% if section.settings.desktop_layout == 'carousel' %} is-desktop-carousel{% endif %}{% if section.settings.mobile_layout == 'carousel' %} is-mobile-carousel{% endif %}" data-ca-reveal="{{ section.settings.animation_style | default: 'fade-in' }}">
      {% if section.settings.heading != blank or section.settings.description != blank or section.settings.button_label != blank %}
        <header class="ca-gallery__intro ca-gallery__intro--{{ section.settings.intro_alignment | default: 'left' }}">
          {% if section.settings.heading != blank %}
            <h2 class="ca-gallery__heading">{{ section.settings.heading | escape }}</h2>
          {% endif %}
          {% if section.settings.description != blank %}
            <div class="ca-gallery__description rte">{{ section.settings.description }}</div>
          {% endif %}
          {% if section.settings.button_label != blank %}
            <div class="ca-gallery__action">
              {% render 'craftaurum-cta',
                label: section.settings.button_label,
                link: section.settings.link,
                style_class: section.settings.button_style,
                static_label: true
              %}
            </div>
          {% endif %}
        </header>
      {% endif %}
      <div class="ca-carousel-stage">
      <div class="ca-gallery__grid">
        {% for block in section.blocks %}
          <div class="ca-gallery__item" {{ block.shopify_attributes }}>
            <div class="ca-gallery__media">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'ca-gallery__image', widths: '240,360,520,720,960,1200,1600', sizes: '(min-width: 750px) 25vw, 50vw' }}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'ca-gallery__placeholder' }}
            {% endif %}
            </div>
            {% if block.settings.caption != blank %}
              <p class="ca-gallery__caption">{{ block.settings.caption | escape }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
      {% if has_scroll_controls %}
        {% render 'craftaurum-scroll-controls', track_selector: '.ca-gallery__grid', desktop: carousel_desktop, mobile: carousel_mobile , media_selector: '.ca-gallery__media' %}
      {% endif %}
      </div> <!-- /ca-carousel-stage -->
    </div>
  </div>
</section>
{% stylesheet %}
  .ca-gallery__surface{width:100%;background:var(--ca-gallery-bg)}
  .ca-gallery__inner{padding-block:var(--ca-gallery-pt) var(--ca-gallery-pb)}
  .ca-gallery__inner--page-width{width:var(--full-page-grid-central-column-width);margin-inline:auto}
  .ca-gallery__inner--full-width{width:100%;padding-inline:max(var(--page-margin),24px)}
  .ca-gallery__intro{max-width:960px;margin-bottom:34px}
  .ca-gallery__intro--left{text-align:left;margin-right:auto}
  .ca-gallery__intro--center{text-align:center;margin-inline:auto}
  .ca-gallery__intro--right{text-align:right;margin-left:auto}
  .ca-gallery__heading{margin:0 0 12px;font-size:var(--ca-gallery-heading-size);line-height:1.08}
  .ca-gallery__description{font-size:var(--ca-gallery-body-size);line-height:1.6}
  .ca-gallery__description p{margin:0}
  .ca-gallery__action{margin-top:18px}
  .ca-gallery__intro--center .ca-gallery__action{display:flex;justify-content:center}
  .ca-gallery__intro--right .ca-gallery__action{display:flex;justify-content:flex-end}
  .ca-gallery__grid{display:grid;grid-template-columns:repeat(var(--ca-gallery-desktop),minmax(0,1fr));gap:var(--ca-gallery-gap)}
  .ca-gallery__item{min-width:0}
  .ca-gallery__media{aspect-ratio:var(--ca-gallery-ratio);overflow:hidden;background:rgb(var(--color-foreground-rgb)/.04)}
  .ca-gallery__caption{margin:12px 0 0;font-size:14px;line-height:1.45;text-align:center;color:inherit}
  .ca-gallery__image,.ca-gallery__placeholder{display:block;width:100%;height:100%;object-fit:cover}
  .ca-gallery__image{transition:transform .45s cubic-bezier(.2,.7,.2,1)}
  @media(hover:hover) and (pointer:fine){.ca-gallery__media:hover .ca-gallery__image{transform:scale(1.025)}}
  .ca-gallery__inner.is-desktop-carousel .ca-gallery__grid{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}
  .ca-gallery__inner.is-desktop-carousel .ca-gallery__item{flex:0 0 calc((100% - (var(--ca-gallery-desktop) - 1)*var(--ca-gallery-gap))/var(--ca-gallery-desktop));scroll-snap-align:start}
  @media(max-width:749px){
    .ca-gallery__inner--full-width{padding-inline:18px}
    .ca-gallery__intro{margin-bottom:24px;text-align:left}
    .ca-gallery__heading{font-size:min(var(--ca-gallery-heading-size),42px)}
    .ca-gallery__intro--center .ca-gallery__action,.ca-gallery__intro--right .ca-gallery__action{justify-content:flex-start}
    .ca-gallery__grid{grid-template-columns:repeat(var(--ca-gallery-mobile),minmax(0,1fr))}
    .ca-gallery__inner.is-desktop-carousel:not(.is-mobile-carousel) .ca-gallery__grid{display:grid;overflow:visible}
    .ca-gallery__inner.is-mobile-carousel .ca-gallery__grid{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}
    .ca-gallery__inner.is-mobile-carousel .ca-gallery__item{flex:0 0 calc((100% - (var(--ca-gallery-mobile) - 1)*var(--ca-gallery-gap))/var(--ca-gallery-mobile));scroll-snap-align:start}
  }

  @media screen and (max-width: 749px) {
    .ca-gallery__heading { font-size: var(--ca-gallery-heading-size-mobile); }
    .ca-gallery__description { font-size: var(--ca-gallery-body-size-mobile); }
  }
{% endstylesheet %}
{% schema %}
{
