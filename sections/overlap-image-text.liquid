{% liquid
  assign desktop_visual_ratio = '4 / 3'
  case section.settings.desktop_visual_ratio
    when 'wide'
      assign desktop_visual_ratio = '16 / 9'
    when 'square'
      assign desktop_visual_ratio = '1 / 1'
    when 'portrait'
      assign desktop_visual_ratio = '4 / 5'
  endcase

  assign mobile_visual_ratio = '1 / 1'
  case section.settings.mobile_visual_ratio
    when 'wide'
      assign mobile_visual_ratio = '16 / 9'
    when 'landscape'
      assign mobile_visual_ratio = '4 / 3'
    when 'portrait'
      assign mobile_visual_ratio = '4 / 5'
  endcase
%}
{% if section.settings.mobile_layout == 'slider' and section.blocks.size > 1 %}
  {{ 'craftaurum-scroll-controls.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'craftaurum-scroll-controls.js' | asset_url }}" defer></script>
{% endif %}
{% if section.settings.background_color != blank %}
  {% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}
{% endif %}

<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>

<section
  id="OverlapImageText-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} spacing-style ca-overlap{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    --padding-block-start: {{ section.settings.padding_top }}px;
    --padding-block-end: {{ section.settings.padding_bottom }}px;
    --ca-overlap-gap: {{ section.settings.column_gap }}px;
    --ca-overlap-desktop-ratio: {{ desktop_visual_ratio }};
    --ca-overlap-mobile-ratio: {{ mobile_visual_ratio }};
    --ca-overlap-image-count: {{ section.blocks.size | at_least: 1 }};
    --ca-overlap-text: {{ section.settings.text_color }};
    --ca-overlap-accent: {{ section.settings.accent_color }};
    --ca-overlap-heading-size: {{ section.settings.heading_size }}px;
    --ca-overlap-heading-size-mobile: {{ section.settings.mobile_heading_size | default: 25 }}px;
    --ca-overlap-body-size: {{ section.settings.body_size }}px;
    --ca-overlap-body-size-mobile: {{ section.settings.mobile_body_size | default: 14 }}px;
    --ca-overlap-eyebrow-size: {{ section.settings.eyebrow_size | default: 12 }}px;
    --ca-overlap-eyebrow-size-mobile: {{ section.settings.mobile_eyebrow_size | default: 12 }}px;
    --ca-overlap-amount: {{ section.settings.overlap_amount | default: 15 }}%;
  "
>
  <div class="ca-overlap__layout ca-overlap__layout--image-{{ section.settings.image_position }}" data-ca-reveal="{{ section.settings.animation_style | default: 'fade-up' }}">
    <div class="ca-carousel-stage ca-overlap__stage">
    <div
      class="ca-overlap__visual ca-overlap__visual--mobile-{{ section.settings.mobile_layout | default: 'overlap' }}"
    >
      {% for block in section.blocks %}
        {% liquid
          assign ratio_class = 'portrait'
          if block.settings.image_ratio == 'square'
            assign ratio_class = 'square'
          elsif block.settings.image_ratio == 'landscape'
            assign ratio_class = 'landscape'
          endif
        %}
        <figure
          class="ca-overlap__image-item ca-overlap__image-item--{{ ratio_class }} ca-overlap__image-item--{{ forloop.index }}"
          style="
            --ca-img-width: {{ block.settings.width }}%;
            --ca-img-rotate: {{ block.settings.rotation }}deg;
            --ca-img-z: {{ block.settings.z_index }};
          "
          {{ block.shopify_attributes }}
        >
          <div class="ca-overlap__image-wrap">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1600
                | image_tag:
                  loading: 'lazy',
                  class: 'ca-overlap__image',
                  widths: '320,480,640,840,1100,1400,1600',
                  sizes: '(min-width: 990px) 42vw, 82vw'
              }}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'ca-overlap__placeholder' }}
            {% endif %}
          </div>
        </figure>
      {% endfor %}
    </div>
    {% if section.settings.mobile_layout == 'slider' and section.blocks.size > 1 %}
      {% render 'craftaurum-scroll-controls', track_selector: '.ca-overlap__visual', tablet: true, mobile: true , media_selector: '.ca-overlap__visual' %}
    {% endif %}
    </div> <!-- /ca-carousel-stage -->

    <div class="ca-overlap__content ca-overlap__content--{{ section.settings.text_alignment }}">
      {% if section.settings.eyebrow != blank %}
        <p class="ca-overlap__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="ca-overlap__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.body != blank %}
        <div class="ca-overlap__body rte">{{ section.settings.body }}</div>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <div class="ca-overlap__action">
          {% render 'craftaurum-cta',
            label: section.settings.button_label,
            link: section.settings.button_link,
            style_class: section.settings.button_style,
            static_label: true
          %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .ca-overlap {
    color: var(--ca-overlap-text);
  }

  .ca-overlap__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(320px, .92fr);
    gap: var(--ca-overlap-gap);
    align-items: center;
    min-width: 0;
  }

  .ca-overlap__layout--image-right .ca-overlap__stage {
    order: 2;
  }

  .ca-overlap__layout--image-right .ca-overlap__content {
    order: 1;
  }

  .ca-overlap__stage {
    min-width: 0;
    width: 100%;
  }

  .ca-overlap__visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(12px, 2vw, 18px);
    width: 100%;
    min-width: 0;
    min-height: 0;
    aspect-ratio: var(--ca-overlap-desktop-ratio);
    overflow: visible;
  }

  .ca-overlap__image-item {
    position: relative;
    width: var(--ca-img-width);
    flex: 0 1 var(--ca-img-width);
    min-width: 0;
    margin: 0;
    z-index: var(--ca-img-z);
    transform: rotate(var(--ca-img-rotate));
    transform-origin: center;
  }

  .ca-overlap__image-item--portrait { aspect-ratio: 4 / 5; }
  .ca-overlap__image-item--square { aspect-ratio: 1 / 1; }
  .ca-overlap__image-item--landscape { aspect-ratio: 4 / 3; }

  .ca-overlap__visual {
    gap: 0;
  }

  .ca-overlap__image-item + .ca-overlap__image-item {
    margin-left: calc(var(--ca-overlap-amount) * -1);
  }

  .ca-overlap__image-item--portrait .ca-overlap__image-wrap {
    aspect-ratio: 4 / 5;
  }

  .ca-overlap__image-item--square .ca-overlap__image-wrap {
    aspect-ratio: 1 / 1;
  }

  .ca-overlap__image-item--landscape .ca-overlap__image-wrap {
    aspect-ratio: 4 / 3;
  }

  .ca-overlap__image-wrap {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .ca-overlap__image,
  .ca-overlap__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: none;
  }

  .ca-overlap__content {
    max-width: 620px;
  }

  .ca-overlap__content--left {
    text-align: left;
  }

  .ca-overlap__content--center {
    text-align: center;
  }

  .ca-overlap__content--right {
    text-align: right;
  }

  .ca-overlap__eyebrow {
    margin: 0 0 10px;
    color: var(--ca-overlap-accent);
    font-size: var(--ca-overlap-eyebrow-size);
    line-height: 1.35;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .ca-overlap__heading {
    margin: 0 0 18px;
    color: inherit;
    font-size: var(--ca-overlap-heading-size);
    line-height: 1.08;
  }

  .ca-overlap__body {
    font-size: var(--ca-overlap-body-size);
    line-height: 1.65;
  }

  .ca-overlap__body p {
    margin: 0 0 1em;
  }

  .ca-overlap__body p:last-child {
    margin-bottom: 0;
  }

  .ca-overlap__action {
    margin-top: 24px;
  }

  .ca-overlap__content--center .ca-overlap__action {
    display: flex;
    justify-content: center;
  }

  .ca-overlap__content--right .ca-overlap__action {
    display: flex;
    justify-content: flex-end;
  }

  @media screen and (max-width: 989px) {
    .ca-overlap__layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }

    /* Image stays above the content on tablet and mobile, even with right-image desktop layout. */
    .ca-overlap__layout--image-right .ca-overlap__stage,
    .ca-overlap__layout--image-right .ca-overlap__content {
      order: initial;
    }

    .ca-overlap__content {
      max-width: 760px;
    }

    .ca-overlap__visual {
      width: 100%;
      max-width: min(100%, 680px);
      min-height: 0;
      aspect-ratio: var(--ca-overlap-mobile-ratio);
      margin-inline: auto;
      box-sizing: border-box;
    }

    /* Mobile slider: equal card widths, no negative margins, and room for rotation. */
    .ca-overlap__visual--mobile-slider {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: 16px;
      padding: 56px 20px;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .ca-overlap__visual--mobile-slider::-webkit-scrollbar {
      display: none;
    }

    .ca-overlap__visual--mobile-slider .ca-overlap__image-item {
      flex: 0 0 min(78%, 440px);
      width: min(78%, 440px);
      height: 82%;
      aspect-ratio: auto;
      margin: 0;
      scroll-snap-align: center;
    }

    .ca-overlap__visual--mobile-slider .ca-overlap__image-item:only-child {
      flex-basis: min(100%, 520px);
      width: min(100%, 520px);
    }

    /* Mobile stack: vertically spaced cards, never overlapped. */
    .ca-overlap__visual--mobile-stack {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 24px;
      padding: 20px 12px;
    }

    .ca-overlap__visual--mobile-stack .ca-overlap__image-item {
      flex: 0 0 auto;
      width: min(88%, 460px);
      height: calc((100% - (var(--ca-overlap-image-count) - 1) * 24px) / var(--ca-overlap-image-count));
      aspect-ratio: auto;
      min-height: 0;
      margin: 0;
    }

    /* Mobile crossover uses the section overlap range and per-image rotations. */
    .ca-overlap__visual--mobile-overlap {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 14px;
      padding: 44px 14px;
      overflow: visible;
    }

    .ca-overlap__visual--mobile-overlap .ca-overlap__image-item {
      flex: 0 1 var(--ca-img-width);
      width: var(--ca-img-width);
      min-width: 0;
      max-height: 82%;
    }

    .ca-overlap__visual--mobile-overlap {
      gap: 0;
    }

    .ca-overlap__visual--mobile-overlap .ca-overlap__image-item + .ca-overlap__image-item {
      margin-left: calc(var(--ca-overlap-amount) * -1);
    }

    :is(.ca-overlap__visual--mobile-slider, .ca-overlap__visual--mobile-stack) .ca-overlap__image-item + .ca-overlap__image-item {
      margin-left: 0;
    }
  }

  @media screen and (max-width: 749px) {
    .ca-overlap__visual--mobile-slider .ca-overlap__image-item {
      flex-basis: 82%;
      width: 82%;
    }

    .ca-overlap__visual--mobile-slider .ca-overlap__image-item:only-child {
      flex-basis: 100%;
      width: 100%;
    }

    .ca-overlap__visual--mobile-overlap {
      padding: 34px 10px;
    }

    .ca-overlap__heading {
      font-size: min(var(--ca-overlap-heading-size), 42px);
    }

    .ca-overlap__content--right {
      text-align: left;
    }

    .ca-overlap__content--right .ca-overlap__action {
      justify-content: flex-start;
    }
  }

  @media screen and (max-width: 749px) {
    .ca-overlap__eyebrow { font-size: var(--ca-overlap-eyebrow-size-mobile); }
    .ca-overlap__heading { font-size: var(--ca-overlap-heading-size-mobile); }
    .ca-overlap__body { font-size: var(--ca-overlap-body-size-mobile); }
  }

  /* Subtle image hover without moving the image container. */
  .ca-overlap__image { transition: transform .48s cubic-bezier(.2,.7,.2,1); transform: scale(1); }
  @media (hover: hover) and (pointer: fine) {
    .ca-overlap__image-wrap:hover .ca-overlap__image { transform: scale(1.055); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ca-overlap__image { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "叠层图文",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "基础设置"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "内容宽度",
      "options": [
        {
          "value": "page-width",
          "label": "页面宽度"
        },
        {
          "value": "full-width",
          "label": "全宽"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "内容设置"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "小标题"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Layered Image & Text"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "正文",
      "default": "<p>Add your supporting copy here.</p>"
    },
    {
      "type": "header",
      "content": "按钮设置"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "按钮文字"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "按钮链接"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "按钮样式",
      "options": [
        {
          "value": "button",
          "label": "主按钮"
        },
        {
          "value": "button-secondary",
          "label": "次按钮"
        },
        {
          "value": "button-unstyled",
          "label": "文字链接"
        }
      ],
      "default": "button"
    },
    {
      "type": "header",
      "content": "图片设置"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "图片位置",
      "options": [
        {
          "value": "left",
          "label": "左图右文"
        },
        {
          "value": "right",
          "label": "右图左文"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "desktop_visual_ratio",
      "label": "电脑端视觉区比例",
      "options": [
        {
          "value": "wide",
          "label": "16:9"
        },
        {
          "value": "landscape",
          "label": "4:3"
        },
        {
          "value": "square",
          "label": "1:1"
        },
        {
          "value": "portrait",
          "label": "4:5"
        }
      ],
      "default": "landscape"
    },
    {
      "type": "header",
      "content": "布局与交互"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "文字对齐",
      "options": [
        {
          "value": "left",
          "label": "左对齐"
        },
        {
          "value": "center",
          "label": "居中"
        },
        {
          "value": "right",
          "label": "右对齐"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "图文间距",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
