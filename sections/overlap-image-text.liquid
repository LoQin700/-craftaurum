{% if section.settings.background_color != blank %}
  {% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}
{% endif %}

<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>

<section
  id="OverlapImageText-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} spacing-style ca-overlap{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    --padding-block-start: {{ section.settings.padding_top }}px;
    --padding-block-end: {{ section.settings.padding_bottom }}px;
    --ca-overlap-gap: {{ section.settings.column_gap }}px;
    --ca-overlap-visual-height: {{ section.settings.visual_height }}px;
    --ca-overlap-text: {{ section.settings.text_color }};
    --ca-overlap-accent: {{ section.settings.accent_color }};
    --ca-overlap-heading-size: {{ section.settings.heading_size }}px;
    --ca-overlap-heading-size-mobile: {{ section.settings.mobile_heading_size | default: 35 }}px;
    --ca-overlap-body-size: {{ section.settings.body_size }}px;
    --ca-overlap-body-size-mobile: {{ section.settings.mobile_body_size | default: 16 }}px;
    --ca-overlap-eyebrow-size: {{ section.settings.eyebrow_size | default: 12 }}px;
    --ca-overlap-eyebrow-size-mobile: {{ section.settings.mobile_eyebrow_size | default: 12 }}px;
    --ca-overlap-amount: {{ section.settings.overlap_amount | default: 28 }}%;
  "
>
  <div class="ca-overlap__layout ca-overlap__layout--image-{{ section.settings.image_position }}" data-ca-reveal="{{ section.settings.animation_style | default: 'fade-up' }}">
    <div
      class="ca-overlap__visual ca-overlap__visual--{{ section.settings.desktop_layout }} ca-overlap__visual--mobile-{{ section.settings.mobile_layout }}"
      aria-label="{{ section.settings.visual_aria_label | escape }}"
    >
      {% for block in section.blocks %}
        {% liquid
          assign ratio_class = 'portrait'
          if block.settings.image_ratio == 'square'
            assign ratio_class = 'square'
          elsif block.settings.image_ratio == 'landscape'
            assign ratio_class = 'landscape'
          endif
        %}
        <figure
          class="ca-overlap__image-item ca-overlap__image-item--{{ ratio_class }} ca-overlap__image-item--{{ forloop.index }}"
          style="
            --ca-img-width: {{ block.settings.width }}%;
            --ca-img-rotate: {{ block.settings.rotation }}deg;
            --ca-img-z: {{ block.settings.z_index }};
          "
          {{ block.shopify_attributes }}
        >
          <div class="ca-overlap__image-wrap">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1600
                | image_tag:
                  loading: 'lazy',
                  class: 'ca-overlap__image',
                  widths: '320,480,640,840,1100,1400,1600',
                  sizes: '(min-width: 990px) 42vw, 82vw'
              }}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'ca-overlap__placeholder' }}
            {% endif %}
          </div>
        </figure>
      {% endfor %}
    </div>

    <div class="ca-overlap__content ca-overlap__content--{{ section.settings.text_alignment }}">
      {% if section.settings.eyebrow != blank %}
        <p class="ca-overlap__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="ca-overlap__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.body != blank %}
        <div class="ca-overlap__body rte">{{ section.settings.body }}</div>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <div class="ca-overlap__action">
          {% render 'craftaurum-cta',
            label: section.settings.button_label,
            link: section.settings.button_link,
            style_class: section.settings.button_style,
            static_label: true
          %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .ca-overlap {
    color: var(--ca-overlap-text);
  }

  .ca-overlap__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(320px, .92fr);
    gap: var(--ca-overlap-gap);
    align-items: center;
    min-width: 0;
  }

  .ca-overlap__layout--image-right .ca-overlap__visual {
    order: 2;
  }

  .ca-overlap__layout--image-right .ca-overlap__content {
    order: 1;
  }

  .ca-overlap__visual {
    position: relative;
    min-width: 0;
    min-height: var(--ca-overlap-visual-height);
  }

  .ca-overlap__visual--overlap,
  .ca-overlap__visual--split {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: visible;
  }

  .ca-overlap__visual--overlap .ca-overlap__image-item,
  .ca-overlap__visual--split .ca-overlap__image-item {
    position: relative;
    width: var(--ca-img-width);
    flex: 0 0 var(--ca-img-width);
    margin: 0;
    z-index: var(--ca-img-z);
    transform: rotate(var(--ca-img-rotate));
    transform-origin: center;
  }

  .ca-overlap__visual--overlap .ca-overlap__image-item + .ca-overlap__image-item {
    margin-left: calc(var(--ca-overlap-amount) * -1);
  }

  .ca-overlap__visual--split {
    gap: 18px;
  }

  .ca-overlap__image-item--portrait .ca-overlap__image-wrap {
    aspect-ratio: 4 / 5;
  }

  .ca-overlap__image-item--square .ca-overlap__image-wrap {
    aspect-ratio: 1 / 1;
  }

  .ca-overlap__image-item--landscape .ca-overlap__image-wrap {
    aspect-ratio: 4 / 3;
  }

  .ca-overlap__image-wrap {
    width: 100%;
    overflow: hidden;
  }

  .ca-overlap__image,
  .ca-overlap__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: none;
  }

  .ca-overlap__content {
    max-width: 620px;
  }

  .ca-overlap__content--left {
    text-align: left;
  }

  .ca-overlap__content--center {
    text-align: center;
  }

  .ca-overlap__content--right {
    text-align: right;
  }

  .ca-overlap__eyebrow {
    margin: 0 0 10px;
    color: var(--ca-overlap-accent);
    font-size: var(--ca-overlap-eyebrow-size);
    line-height: 1.35;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .ca-overlap__heading {
    margin: 0 0 18px;
    color: inherit;
    font-size: var(--ca-overlap-heading-size);
    line-height: 1.08;
  }

  .ca-overlap__body {
    font-size: var(--ca-overlap-body-size);
    line-height: 1.65;
  }

  .ca-overlap__body p {
    margin: 0 0 1em;
  }

  .ca-overlap__body p:last-child {
    margin-bottom: 0;
  }

  .ca-overlap__action {
    margin-top: 24px;
  }

  .ca-overlap__content--center .ca-overlap__action {
    display: flex;
    justify-content: center;
  }

  .ca-overlap__content--right .ca-overlap__action {
    display: flex;
    justify-content: flex-end;
  }

  @media screen and (max-width: 989px) {
    .ca-overlap__layout {
      grid-template-columns: 1fr;
      gap: 34px;
    }

    .ca-overlap__layout--image-right .ca-overlap__visual,
    .ca-overlap__layout--image-right .ca-overlap__content {
      order: initial;
    }

    .ca-overlap__content {
      max-width: 760px;
    }

    .ca-overlap__visual--mobile-slider,
    .ca-overlap__visual--mobile-stack {
      min-height: 0;
    }

    .ca-overlap__visual--mobile-slider {
      display: flex !important;
      gap: 14px !important;
      overflow-x: auto !important;
      overflow-y: visible;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      padding: 16px 2px;
    }

    .ca-overlap__visual--mobile-slider .ca-overlap__image-item {
      position: relative !important;
      inset: auto !important;
      flex: 0 0 78% !important;
      width: 78% !important;
      margin: 0 !important;
      transform: rotate(var(--ca-img-rotate)) !important;
      scroll-snap-align: center;
    }

    .ca-overlap__visual--mobile-stack {
      display: grid !important;
      gap: 16px !important;
    }

    .ca-overlap__visual--mobile-stack .ca-overlap__image-item {
      position: relative !important;
      inset: auto !important;
      width: min(var(--ca-img-width), 100%) !important;
      margin: 0 auto !important;
      transform: rotate(var(--ca-img-rotate)) !important;
    }

    .ca-overlap__visual--mobile-overlap {
      min-height: min(var(--ca-overlap-visual-height), 520px);
    }

    .ca-overlap__visual--mobile-overlap .ca-overlap__image-item {
      width: min(var(--ca-img-width), 82%);
    }
  }

  @media screen and (max-width: 749px) {
    .ca-overlap__heading {
      font-size: min(var(--ca-overlap-heading-size), 42px);
    }

    .ca-overlap__content--right {
      text-align: left;
    }

    .ca-overlap__content--right .ca-overlap__action {
      justify-content: flex-start;
    }
  }

  @media screen and (max-width: 749px) {
    .ca-overlap__eyebrow { font-size: var(--ca-overlap-eyebrow-size-mobile); }
    .ca-overlap__heading { font-size: var(--ca-overlap-heading-size-mobile); }
    .ca-overlap__body { font-size: var(--ca-overlap-body-size-mobile); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "叠层图文",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "基础设置"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "内容宽度",
      "options": [
        {
          "value": "page-width",
          "label": "页面宽度"
        },
        {
          "value": "full-width",
          "label": "全宽"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "内容设置"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "小标题"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Layered Image & Text"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "正文",
      "default": "<p>Add your supporting copy here.</p>"
    },
    {
      "type": "header",
      "content": "按钮设置"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "按钮文字"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "按钮链接"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "按钮样式",
      "options": [
        {
          "value": "button",
          "label": "主按钮"
        },
        {
          "value": "button-secondary",
          "label": "次按钮"
        },
        {
          "value": "button-unstyled",
          "label": "文字链接"
        }
      ],
      "default": "button"
    },
    {
      "type": "header",
      "content": "图片设置"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "图片位置",
      "options": [
        {
          "value": "left",
          "label": "左图右文"
        },
        {
          "value": "right",
          "label": "右图左文"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "visual_height",
      "label": "视觉区高度",
      "min": 320,
      "max": 760,
      "step": 20,
      "unit": "px",
      "default": 560
    },
    {
      "type": "range",
      "id": "overlap_amount",
      "label": "图片交叉程度",
      "min": 0,
      "max": 55,
      "step": 1,
      "unit": "%",
      "default": 28,
      "visible_if": "{{ section.settings.desktop_layout == 'overlap' }}"
    },
    {
      "type": "text",
      "id": "visual_aria_label",
      "label": "图片区域辅助文字",
      "default": "Product imagery"
    },
    {
      "type": "header",
      "content": "布局与交互"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "文字对齐",
      "options": [
        {
          "value": "left",
          "label": "左对齐"
        },
        {
          "value": "center",
          "label": "居中"
        },
        {
          "value": "right",
          "label": "右对齐"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "图文间距",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "header",
      "content": "电脑端布局"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "展示方式",
      "options": [
        {
          "value": "overlap",
          "label": "重叠"
        },
        {
          "value": "split",
          "label": "不重叠"
        }
      ],
      "default": "overlap"
    },
    {
      "type": "header",
      "content": "移动端布局"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "展示方式",
      "options": [
        {
          "value": "slider",
          "label": "横向滑动"
        },
        {
          "value": "stack",
          "label": "上下排列"
        },
        {
          "value": "overlap",
          "label": "保留重叠"
        }
      ],
      "default": "slider"
    },
    {
      "type": "header",
      "content": "电脑端字号"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "小标题字号",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "标题字号",
      "min": 24,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 35
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "正文字号",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "移动端字号"
    },
    {
      "type": "range",
      "id": "mobile_eyebrow_size",
      "label": "小标题字号",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "标题字号",
      "min": 24,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 35
    },
    {
      "type": "range",
      "id": "mobile_body_size",
      "label": "正文字号",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "颜色设置"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景颜色",
      "default": "#F8F7F4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文字颜色",
      "default": "#17191A"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "小标题颜色",
      "default": "#C7A85E"
    },
    {
      "type": "header",
      "content": "其它设置"
    },
    {
      "type": "paragraph",
      "content": "入场动画与区块上下间距"
    },
    {
      "type": "select",
      "id": "animation_style",
      "label": "入场动画",
      "options": [
        {
          "value": "fade-up",
          "label": "Fade Up"
        },
        {
          "value": "fade-in",
          "label": "Fade In"
        },
        {
          "value": "soft-zoom",
          "label": "Soft Zoom"
        }
      ],
      "default": "fade-up"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "上边距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下边距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "叠层图片",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "图片"
        },
        {
          "type": "select",
          "id": "image_ratio",
          "label": "图片比例",
          "options": [
            {
              "value": "portrait",
              "label": "4:5"
            },
            {
              "value": "square",
              "label": "1:1"
            },
            {
              "value": "landscape",
              "label": "4:3"
            }
          ],
          "default": "portrait"
        },
        {
          "type": "range",
          "id": "width",
          "label": "图片宽度",
          "min": 35,
          "max": 86,
          "step": 1,
          "unit": "%",
          "default": 58
        },
        {
          "type": "range",
          "id": "rotation",
          "label": "旋转角度",
          "min": -12,
          "max": 12,
          "step": 1,
          "unit": "deg",
          "default": 0
        },
        {
          "type": "range",
          "id": "z_index",
          "label": "层级",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 1
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "叠层图文",
      "blocks": [
        {
          "type": "image",
          "settings": {
            "width": 58,
            "rotation": -5,
            "z_index": 1
          }
        },
        {
          "type": "image",
          "settings": {
            "width": 54,
            "rotation": 4,
            "z_index": 2
          }
        }
      ]
    }
  ]
}
{% endschema %}
