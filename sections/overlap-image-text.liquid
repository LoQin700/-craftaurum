      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "叠层图片",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "图片"
        },
        {
          "type": "select",
          "id": "image_ratio",
          "label": "图片比例",
          "options": [
            {
              "value": "portrait",
              "label": "4:5"
            },
            {
              "value": "square",
              "label": "1:1"
            },
            {
              "value": "landscape",
              "label": "4:3"
            }
          ],
          "default": "portrait"
        },
        {
          "type": "range",
          "id": "width",
          "label": "图片宽度",
          "min": 35,
          "max": 86,
          "step": 1,
          "unit": "%",
          "default": 58
        },
        {
          "type": "range",
          "id": "rotation",
          "label": "图片旋转角度",
          "min": -12,
          "max": 12,
          "step": 1,
          "unit": "deg",
          "default": 0
        },
        {
          "type": "range",
          "id": "z_index",
          "label": "层级",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 1
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "叠层图文",
      "blocks": [
        {
          "type": "image",
          "settings": {
            "width": 58,
            "rotation": -5,
            "z_index": 1
          }
        },
        {
          "type": "image",
          "settings": {
            "width": 54,
            "rotation": 4,
            "z_index": 2
          }
        }
      ]
