      "id": "mobile_eyebrow_size",
      "label": "小标题字号",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "标题字号",
      "min": 24,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 25
    },
    {
      "type": "range",
      "id": "mobile_body_size",
      "label": "正文字号",
      "min": 12,
