{% if section.settings.background_color != blank %}
  {% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}
{% endif %}

<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>

<section
  id="ContentGuide-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} spacing-style ca-content-guide{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    --padding-block-start: {{ section.settings.padding_top }}px;
    --padding-block-end: {{ section.settings.padding_bottom }}px;
    --ca-guide-accent: {{ section.settings.accent_color }};
    --ca-guide-line: {{ section.settings.line_color }};
    --ca-guide-gap: {{ section.settings.column_gap }}px;
    --ca-guide-image-size: {{ section.settings.item_image_size }}px;
  "
>
  <div class="ca-content-guide__inner">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.description != blank %}
      <header class="ca-content-guide__intro">
        {% if section.settings.eyebrow != blank %}
          <p class="ca-content-guide__eyebrow {{ section.settings.eyebrow_preset }}">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="ca-content-guide__heading {{ section.settings.heading_preset }}">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="ca-content-guide__description rte {{ section.settings.body_preset }}">{{ section.settings.description }}</div>
        {% endif %}
      </header>
    {% endif %}

    <div class="ca-content-guide__layout">
      <div class="ca-content-guide__list">
        {% for block in section.blocks %}
          <article class="ca-content-guide__item" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <div class="ca-content-guide__thumb ca-content-guide__thumb--{{ section.settings.item_image_shape }}">
                {{
                  block.settings.image
                  | image_url: width: 500
                  | image_tag:
                    loading: 'lazy',
                    class: 'ca-content-guide__thumb-image',
                    widths: '96,144,192,240,320,420,500',
                    sizes: section.settings.item_image_size | append: 'px'
                }}
              </div>
            {% endif %}

            {% if block.settings.index_label != blank %}
              <p class="ca-content-guide__item-label">{{ block.settings.index_label | escape }}</p>
            {% endif %}

            <div class="ca-content-guide__item-head">
              {% if block.settings.heading != blank %}
                <h3 class="ca-content-guide__item-title {{ section.settings.item_title_preset }}">{{ block.settings.heading | escape }}</h3>
              {% endif %}
              {% if block.settings.value != blank %}
                <span class="ca-content-guide__value">
                  {{ block.settings.value | escape }}{% if section.settings.value_suffix != blank %} {{ section.settings.value_suffix | escape }}{% endif %}
                </span>
              {% endif %}
            </div>

            {% if block.settings.description != blank %}
              <div class="ca-content-guide__item-body rte {{ section.settings.body_preset }}">{{ block.settings.description }}</div>
            {% endif %}

            {% if block.settings.meta_value != blank %}
              <div class="ca-content-guide__meta">
                {% if block.settings.meta_label != blank %}<strong>{{ block.settings.meta_label | escape }}:</strong>{% endif %}
                {{ block.settings.meta_value | escape }}
              </div>
            {% endif %}
          </article>
        {% endfor %}
      </div>

      <aside class="ca-content-guide__aside">
        <div class="ca-content-guide__aside-sticky">
          {% if section.settings.feature_image != blank %}
            <div class="ca-content-guide__feature-media ca-content-guide__feature-media--{{ section.settings.feature_image_ratio }}">
              {{
                section.settings.feature_image
                | image_url: width: 1600
                | image_tag:
                  loading: 'lazy',
                  class: 'ca-content-guide__feature-image',
                  widths: '420,640,840,1100,1400,1600',
                  sizes: '(min-width: 990px) 42vw, 100vw'
              }}
            </div>
          {% elsif request.design_mode %}
            <div class="ca-content-guide__feature-media ca-content-guide__feature-media--{{ section.settings.feature_image_ratio }}">
              {{ 'image' | placeholder_svg_tag: 'ca-content-guide__feature-placeholder' }}
            </div>
          {% endif %}

          {% if section.settings.feature_heading != blank or section.settings.feature_body != blank %}
            <div class="ca-content-guide__feature-copy">
              {% if section.settings.feature_heading != blank %}
                <h3 class="ca-content-guide__feature-title {{ section.settings.feature_title_preset }}">{{ section.settings.feature_heading | escape }}</h3>
              {% endif %}
              {% if section.settings.feature_body != blank %}
                <div class="ca-content-guide__feature-body rte {{ section.settings.body_preset }}">{{ section.settings.feature_body }}</div>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </aside>
    </div>
  </div>
</section>

{% stylesheet %}
  .ca-content-guide__inner {
    min-width: 0;
  }

  .ca-content-guide__intro {
    max-width: 900px;
    margin-bottom: 42px;
  }

  .ca-content-guide__eyebrow {
    margin: 0 0 10px;
    color: var(--ca-guide-accent);
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .ca-content-guide__heading {
    margin: 0 0 14px;
  }

  .ca-content-guide__description p {
    margin: 0;
  }

  .ca-content-guide__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(340px, .92fr);
    gap: var(--ca-guide-gap);
    align-items: start;
  }

  .ca-content-guide__list {
    border-top: 1px solid var(--ca-guide-line);
  }

  .ca-content-guide__item {
    padding: 26px 0 28px;
    border-bottom: 1px solid var(--ca-guide-line);
  }

  .ca-content-guide__thumb {
    width: var(--ca-guide-image-size);
    margin-bottom: 16px;
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb) / .04);
  }

  .ca-content-guide__thumb--circle {
    aspect-ratio: 1 / 1;
    border-radius: 50%;
  }

  .ca-content-guide__thumb--square {
    aspect-ratio: 1 / 1;
  }

  .ca-content-guide__thumb--landscape {
    aspect-ratio: 4 / 3;
  }

  .ca-content-guide__thumb--wide {
    aspect-ratio: 16 / 9;
  }

  .ca-content-guide__thumb-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ca-content-guide__item-label {
    margin: 0 0 7px;
    color: var(--ca-guide-accent);
    font-size: 12px;
    line-height: 1.35;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  .ca-content-guide__item-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 22px;
    margin-bottom: 9px;
  }

  .ca-content-guide__item-title {
    margin: 0;
  }

  .ca-content-guide__value {
    flex: 0 0 auto;
    color: var(--ca-guide-accent);
    font-size: 12px;
    line-height: 1.35;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .ca-content-guide__item-body {
    max-width: 64ch;
  }

  .ca-content-guide__item-body p {
    margin: 0;
  }

  .ca-content-guide__meta {
    margin-top: 12px;
    font-size: 12px;
    line-height: 1.45;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .ca-content-guide__meta strong {
    color: var(--ca-guide-accent);
  }

  .ca-content-guide__aside-sticky {
    position: sticky;
    top: calc(var(--header-height, 0px) + 24px);
  }

  .ca-content-guide__feature-media {
    width: 100%;
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb) / .04);
  }

  .ca-content-guide__feature-media--square {
    aspect-ratio: 1 / 1;
  }

  .ca-content-guide__feature-media--landscape {
    aspect-ratio: 4 / 3;
  }

  .ca-content-guide__feature-media--wide {
    aspect-ratio: 16 / 9;
  }

  .ca-content-guide__feature-image,
  .ca-content-guide__feature-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ca-content-guide__feature-copy {
    padding-top: 22px;
  }

  .ca-content-guide__feature-title {
    margin: 0 0 10px;
  }

  .ca-content-guide__feature-body p {
    margin: 0 0 1em;
  }

  .ca-content-guide__feature-body p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 989px) {
    .ca-content-guide__layout {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .ca-content-guide__aside-sticky {
      position: static;
    }
  }

  @media screen and (max-width: 749px) {
    .ca-content-guide__intro {
      margin-bottom: 28px;
    }

    .ca-content-guide__item {
      padding: 22px 0 24px;
    }

    .ca-content-guide__item-head {
      display: block;
      margin-bottom: 8px;
    }

    .ca-content-guide__value {
      display: inline-block;
      margin-top: 6px;
    }

    .ca-content-guide__thumb {
      width: min(var(--ca-guide-image-size), 96px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "内容指南",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "内容宽度",
      "options": [
        { "value": "page-width", "label": "页面宽度" },
        { "value": "full-width", "label": "全宽" }
      ],
      "default": "page-width"
    },
    { "type": "color", "id": "background_color", "label": "背景颜色", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "重点颜色", "default": "#C7A85E" },
    { "type": "color", "id": "line_color", "label": "分隔线颜色", "default": "#D8D5CE" },

    { "type": "text", "id": "eyebrow", "label": "小标题", "default": "GUIDE" },
    {
      "type": "select",
      "id": "eyebrow_preset",
      "label": "小标题字号",
      "options": [
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h5"
    },
    { "type": "text", "id": "heading", "label": "标题", "default": "Content Guide" },
    {
      "type": "select",
      "id": "heading_preset",
      "label": "标题字号",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    { "type": "richtext", "id": "description", "label": "介绍文字" },
    {
      "type": "select",
      "id": "body_preset",
      "label": "正文字号",
      "options": [
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h5"
    },
    {
      "type": "select",
      "id": "item_title_preset",
      "label": "项目标题字号",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h3"
    },

    { "type": "header", "content": "项目小图" },
    {
      "type": "select",
      "id": "item_image_shape",
      "label": "图片形状",
      "options": [
        { "value": "circle", "label": "圆形" },
        { "value": "square", "label": "正方形" },
        { "value": "landscape", "label": "长方形 4:3" },
        { "value": "wide", "label": "横图 16:9" }
      ],
      "default": "square"
    },
    {
      "type": "range",
      "id": "item_image_size",
      "label": "图片固定宽度",
      "min": 48,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    { "type": "text", "id": "value_suffix", "label": "数值后缀", "info": "例如 GOLD、mm、kg；留空则只显示数值" },

    { "type": "header", "content": "右侧图文说明" },
    { "type": "image_picker", "id": "feature_image", "label": "大图" },
    {
      "type": "select",
      "id": "feature_image_ratio",
      "label": "大图比例",
      "options": [
        { "value": "square", "label": "正方形" },
        { "value": "landscape", "label": "4:3" },
        { "value": "wide", "label": "16:9" }
      ],
      "default": "landscape"
    },
    { "type": "text", "id": "feature_heading", "label": "标题" },
    {
      "type": "select",
      "id": "feature_title_preset",
      "label": "标题字号",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h3"
    },
    { "type": "richtext", "id": "feature_body", "label": "正文" },

    { "type": "range", "id": "column_gap", "label": "左右间距", "min": 24, "max": 96, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_top", "label": "上边距", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "下边距", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "指南项目",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "小图" },
        { "type": "text", "id": "index_label", "label": "项目短标签" },
        { "type": "text", "id": "value", "label": "数值", "default": "100%" },
        { "type": "text", "id": "heading", "label": "项目标题", "default": "Item Title" },
        { "type": "richtext", "id": "description", "label": "正文", "default": "<p>Add the detailed explanation for this item here.</p>" },
        { "type": "text", "id": "meta_label", "label": "附加信息标签" },
        { "type": "text", "id": "meta_value", "label": "附加信息内容" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "内容指南",
      "blocks": [
        { "type": "item", "settings": { "value": "25%", "heading": "Option A" } },
        { "type": "item", "settings": { "value": "50%", "heading": "Option B" } },
        { "type": "item", "settings": { "value": "75%", "heading": "Option C" } }
      ]
    }
  ]
}
{% endschema %}
