{% if section.settings.background_color != blank %}
  {% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}
{% endif %}

<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>

<section
  id="ContentGuide-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} spacing-style ca-content-guide{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    --padding-block-start: {{ section.settings.padding_top }}px;
    --padding-block-end: {{ section.settings.padding_bottom }}px;
    --ca-guide-gap: {{ section.settings.column_gap }}px;
    --ca-guide-image-size: {{ section.settings.item_image_size }}px;
    --ca-guide-item-padding-inline: {{ section.settings.item_padding_inline }}px;

    --ca-guide-line: {{ section.settings.line_color }};
    --ca-guide-eyebrow-color: {{ section.settings.eyebrow_color }};
    --ca-guide-heading-color: {{ section.settings.heading_color }};
    --ca-guide-description-color: {{ section.settings.description_color }};
    --ca-guide-item-title-color: {{ section.settings.item_title_color }};
    --ca-guide-item-body-color: {{ section.settings.item_body_color }};
    --ca-guide-value-color: {{ section.settings.value_color }};
    --ca-guide-meta-color: {{ section.settings.meta_color }};
    --ca-guide-feature-title-color: {{ section.settings.feature_title_color }};
    --ca-guide-feature-body-color: {{ section.settings.feature_body_color }};
    --ca-guide-hover-bg: {{ section.settings.hover_background_color }};

    --ca-guide-eyebrow-size: {{ section.settings.eyebrow_size }}px;
    --ca-guide-eyebrow-size-mobile: {{ section.settings.mobile_eyebrow_size | default: 12 }}px;
    --ca-guide-heading-size: {{ section.settings.heading_size }}px;
    --ca-guide-heading-size-mobile: {{ section.settings.mobile_heading_size | default: 35 }}px;
    --ca-guide-description-size: {{ section.settings.description_size }}px;
    --ca-guide-description-size-mobile: {{ section.settings.mobile_description_size | default: 16 }}px;
    --ca-guide-item-title-size: {{ section.settings.item_title_size }}px;
    --ca-guide-item-title-size-mobile: {{ section.settings.mobile_item_title_size | default: 24 }}px;
    --ca-guide-item-body-size: {{ section.settings.item_body_size }}px;
    --ca-guide-item-body-size-mobile: {{ section.settings.mobile_item_body_size | default: 16 }}px;
    --ca-guide-value-size: {{ section.settings.value_size }}px;
    --ca-guide-value-size-mobile: {{ section.settings.mobile_value_size | default: 12 }}px;
    --ca-guide-meta-size: {{ section.settings.meta_size }}px;
    --ca-guide-meta-size-mobile: {{ section.settings.mobile_meta_size | default: 12 }}px;
    --ca-guide-feature-title-size: {{ section.settings.feature_title_size }}px;
    --ca-guide-feature-title-size-mobile: {{ section.settings.mobile_feature_title_size | default: 24 }}px;
    --ca-guide-feature-body-size: {{ section.settings.feature_body_size }}px;
    --ca-guide-feature-body-size-mobile: {{ section.settings.mobile_feature_body_size | default: 16 }}px;
  "
>
  <div class="ca-content-guide__inner" data-ca-reveal="{{ section.settings.animation_style | default: 'fade-up' }}">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.description != blank %}
      <header class="ca-content-guide__intro ca-content-guide__intro--{{ section.settings.intro_alignment }}">
        <div class="ca-content-guide__intro-title">
          {% if section.settings.eyebrow != blank %}
            <p class="ca-content-guide__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {% endif %}
          {% if section.settings.heading != blank %}
            <h2 class="ca-content-guide__heading">{{ section.settings.heading | escape }}</h2>
          {% endif %}
        </div>
        {% if section.settings.description != blank %}
          <div class="ca-content-guide__intro-copy">
            <div class="ca-content-guide__description rte">{{ section.settings.description }}</div>
          </div>
        {% endif %}
      </header>
    {% endif %}

    <div class="ca-content-guide__layout">
      <div class="ca-content-guide__list">
        {% for block in section.blocks %}
          <article class="ca-content-guide__item ca-content-guide__item--{{ section.settings.item_alignment }}" {{ block.shopify_attributes }}>
            {% if section.settings.show_index %}
              <div class="ca-content-guide__index">{{ forloop.index | prepend: '0' }}</div>
            {% endif %}

            <div class="ca-content-guide__item-content">
              {% if block.settings.image != blank %}
                <div class="ca-content-guide__thumb ca-content-guide__thumb--{{ section.settings.item_image_shape }}">
                  {{
                    block.settings.image
                    | image_url: width: 500
                    | image_tag:
                      loading: 'lazy',
                      class: 'ca-content-guide__thumb-image',
                      widths: '96,144,192,240,320,420,500',
                      sizes: section.settings.item_image_size | append: 'px'
                  }}
                </div>
              {% endif %}

              <div class="ca-content-guide__item-heading-wrap">
                <div class="ca-content-guide__item-head">
                  {% if block.settings.heading != blank %}
                    <h3 class="ca-content-guide__item-title">{{ block.settings.heading | escape }}</h3>
                  {% endif %}
                  {% if block.settings.value != blank %}
                    <span class="ca-content-guide__value">
                      {{ block.settings.value | escape }}{% if section.settings.value_suffix != blank %} {{ section.settings.value_suffix | escape }}{% endif %}
                    </span>
                  {% endif %}
                </div>
              </div>

              <div class="ca-content-guide__item-copy">
                {% if block.settings.description != blank %}
                  <div class="ca-content-guide__item-body rte">{{ block.settings.description }}</div>
                {% endif %}

                {% if block.settings.meta_value != blank %}
                  <div class="ca-content-guide__meta">
                    {% if block.settings.meta_label != blank %}<strong>{{ block.settings.meta_label | escape }}:</strong>{% endif %}
                    {{ block.settings.meta_value | escape }}
                  </div>
                {% endif %}
              </div>
            </div>
          </article>
        {% endfor %}
      </div>

      <aside class="ca-content-guide__aside">
        <div class="ca-content-guide__aside-sticky">
          {% if section.settings.feature_image != blank %}
            <div class="ca-content-guide__feature-media ca-content-guide__feature-media--{{ section.settings.feature_image_ratio }}">
              {{
                section.settings.feature_image
                | image_url: width: 1600
                | image_tag:
                  loading: 'lazy',
                  class: 'ca-content-guide__feature-image',
                  widths: '420,640,840,1100,1400,1600',
                  sizes: '(min-width: 990px) 42vw, 100vw'
              }}
            </div>
          {% elsif request.design_mode %}
            <div class="ca-content-guide__feature-media ca-content-guide__feature-media--{{ section.settings.feature_image_ratio }}">
              {{ 'image' | placeholder_svg_tag: 'ca-content-guide__feature-placeholder' }}
            </div>
          {% endif %}

          {% if section.settings.feature_heading != blank or section.settings.feature_body != blank %}
            <div class="ca-content-guide__feature-copy ca-content-guide__feature-copy--{{ section.settings.feature_alignment }}">
              {% if section.settings.feature_heading != blank %}
                <h3 class="ca-content-guide__feature-title">{{ section.settings.feature_heading | escape }}</h3>
              {% endif %}
              {% if section.settings.feature_body != blank %}
                <div class="ca-content-guide__feature-body rte">{{ section.settings.feature_body }}</div>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </aside>
    </div>
  </div>
</section>

{% stylesheet %}
  .ca-content-guide__inner {
    min-width: 0;
  }

  .ca-content-guide__intro {
    max-width: 980px;
    margin-bottom: 46px;
  }

  .ca-content-guide__intro--left {
    margin-right: auto;
    text-align: left;
  }

  .ca-content-guide__intro--center {
    margin-inline: auto;
    text-align: center;
  }

  .ca-content-guide__intro--right {
    margin-left: auto;
    text-align: right;
  }

  .ca-content-guide__intro-copy {
    margin-top: 0;
  }

  .ca-content-guide__eyebrow {
    margin: 0 0 10px;
    color: var(--ca-guide-eyebrow-color);
    font-size: var(--ca-guide-eyebrow-size);
    line-height: 1.35;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .ca-content-guide__heading {
    margin: 0 0 14px;
    color: var(--ca-guide-heading-color);
    font-size: var(--ca-guide-heading-size);
    line-height: 1.08;
  }

  .ca-content-guide__description {
    color: var(--ca-guide-description-color);
    font-size: var(--ca-guide-description-size);
    line-height: 1.6;
  }

  .ca-content-guide__description p {
    margin: 0;
  }

  .ca-content-guide__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(340px, .92fr);
    gap: var(--ca-guide-gap);
    align-items: center;
  }

  .ca-content-guide__list {
    border-top: 1px solid var(--ca-guide-line);
  }

  .ca-content-guide__item {
    padding: 26px var(--ca-guide-item-padding-inline) 28px;
    border-bottom: 1px solid var(--ca-guide-line);
    transition: background-color .25s ease, box-shadow .25s ease;
  }

  .ca-content-guide__index {
    color: var(--ca-guide-value-color);
    font-size: var(--ca-guide-value-size);
    line-height: 1.35;
    letter-spacing: .08em;
  }

  .ca-content-guide__item-content {
    min-width: 0;
  }

  .ca-content-guide__item {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    gap: 20px;
    align-items: start;
  }

  .ca-content-guide__item .ca-content-guide__item-content {
    display: grid;
    grid-template-columns: minmax(150px, .72fr) minmax(0, 1.28fr);
    gap: 26px;
    align-items: start;
  }

  .ca-content-guide__item .ca-content-guide__thumb {
    grid-column: 1 / -1;
    margin-bottom: 2px;
  }

  .ca-content-guide__item .ca-content-guide__item-head {
    display: block;
    margin-bottom: 0;
  }

  .ca-content-guide__item .ca-content-guide__value {
    display: inline-block;
    margin-top: 7px;
  }

  .ca-content-guide__item .ca-content-guide__item-body {
    max-width: 58ch;
  }

  @media (hover: hover) and (pointer: fine) {
    .ca-content-guide__item:hover {
      background: var(--ca-guide-hover-bg);
    }

    .ca-content-guide__item:hover {
      box-shadow: inset 3px 0 0 var(--ca-guide-eyebrow-color);
    }
  }

  .ca-content-guide__item--left {
    text-align: left;
  }

  .ca-content-guide__item--center {
    text-align: center;
  }

  .ca-content-guide__item--right {
    text-align: right;
  }

  .ca-content-guide__item--center .ca-content-guide__thumb {
    margin-inline: auto;
  }

  .ca-content-guide__item--right .ca-content-guide__thumb {
    margin-left: auto;
  }

  .ca-content-guide__thumb {
    width: var(--ca-guide-image-size);
    margin-bottom: 16px;
    overflow: hidden;
  }

  .ca-content-guide__thumb--circle {
    aspect-ratio: 1 / 1;
    border-radius: 50%;
  }

  .ca-content-guide__thumb--square {
    aspect-ratio: 1 / 1;
  }

  .ca-content-guide__thumb--landscape {
    aspect-ratio: 4 / 3;
  }

  .ca-content-guide__thumb--wide {
    aspect-ratio: 16 / 9;
  }

  .ca-content-guide__thumb-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ca-content-guide__item-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 22px;
    margin-bottom: 9px;
  }

  .ca-content-guide__item--center .ca-content-guide__item-head {
    justify-content: center;
  }

  .ca-content-guide__item--right .ca-content-guide__item-head {
    justify-content: flex-end;
  }

  .ca-content-guide__item-title {
    margin: 0;
    color: var(--ca-guide-item-title-color);
    font-size: var(--ca-guide-item-title-size);
    line-height: 1.2;
  }

  .ca-content-guide__value {
    flex: 0 0 auto;
    color: var(--ca-guide-value-color);
    font-size: var(--ca-guide-value-size);
    line-height: 1.35;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .ca-content-guide__item-body {
    max-width: 64ch;
    color: var(--ca-guide-item-body-color);
    font-size: var(--ca-guide-item-body-size);
    line-height: 1.6;
  }

  .ca-content-guide__item--center .ca-content-guide__item-body {
    margin-inline: auto;
  }

  .ca-content-guide__item--right .ca-content-guide__item-body {
    margin-left: auto;
  }

  .ca-content-guide__item-body p {
    margin: 0;
  }

  .ca-content-guide__meta {
    margin-top: 12px;
    color: var(--ca-guide-meta-color);
    font-size: var(--ca-guide-meta-size);
    line-height: 1.45;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .ca-content-guide__meta strong {
    color: var(--ca-guide-value-color);
  }

  .ca-content-guide__aside {
    align-self: center;
  }

  .ca-content-guide__aside-sticky {
    position: static;
  }

  .ca-content-guide__feature-media {
    width: 100%;
    overflow: hidden;
  }

  .ca-content-guide__feature-media--square {
    aspect-ratio: 1 / 1;
  }

  .ca-content-guide__feature-media--landscape {
    aspect-ratio: 4 / 3;
  }

  .ca-content-guide__feature-media--wide {
    aspect-ratio: 16 / 9;
  }

  .ca-content-guide__feature-image,
  .ca-content-guide__feature-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ca-content-guide__feature-copy {
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--ca-guide-line);
  }

  .ca-content-guide__feature-copy--left {
    text-align: left;
  }

  .ca-content-guide__feature-copy--center {
    text-align: center;
  }

  .ca-content-guide__feature-copy--right {
    text-align: right;
  }

  .ca-content-guide__feature-title {
    margin: 0 0 10px;
    color: var(--ca-guide-feature-title-color);
    font-size: var(--ca-guide-feature-title-size);
    line-height: 1.2;
  }

  .ca-content-guide__feature-body {
    color: var(--ca-guide-feature-body-color);
    font-size: var(--ca-guide-feature-body-size);
    line-height: 1.6;
  }

  .ca-content-guide__feature-body p {
    margin: 0 0 1em;
  }

  .ca-content-guide__feature-body p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 989px) {
    .ca-content-guide__layout {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .ca-content-guide__aside-sticky {
      position: static;
    }
  }

  @media screen and (max-width: 749px) {
    .ca-content-guide__intro {
      margin-bottom: 28px;
    }

    .ca-content-guide__heading {
      font-size: min(var(--ca-guide-heading-size), 42px);
    }

    .ca-content-guide__item {
      padding: 22px min(var(--ca-guide-item-padding-inline), 16px) 24px;
    }

    .ca-content-guide__item {
      grid-template-columns: 34px minmax(0, 1fr);
      gap: 14px;
    }

    .ca-content-guide__item .ca-content-guide__item-content {
      display: block;
    }

    .ca-content-guide__item .ca-content-guide__item-heading-wrap {
      margin-bottom: 8px;
    }

    .ca-content-guide__item-head {
      display: block;
      margin-bottom: 8px;
    }

    .ca-content-guide__value {
      display: inline-block;
      margin-top: 6px;
    }

    .ca-content-guide__thumb {
      width: min(var(--ca-guide-image-size), 96px);
    }
  }

  @media screen and (max-width: 749px) {
    .ca-content-guide__eyebrow { font-size: var(--ca-guide-eyebrow-size-mobile); }
    .ca-content-guide__heading { font-size: var(--ca-guide-heading-size-mobile); }
    .ca-content-guide__description { font-size: var(--ca-guide-description-size-mobile); }
    .ca-content-guide__item-title { font-size: var(--ca-guide-item-title-size-mobile); }
    .ca-content-guide__item-body { font-size: var(--ca-guide-item-body-size-mobile); }
    .ca-content-guide__index { font-size: var(--ca-guide-value-size-mobile); }
    .ca-content-guide__value { font-size: var(--ca-guide-value-size-mobile); }
    .ca-content-guide__meta { font-size: var(--ca-guide-meta-size-mobile); }
    .ca-content-guide__feature-title { font-size: var(--ca-guide-feature-title-size-mobile); }
    .ca-content-guide__feature-body { font-size: var(--ca-guide-feature-body-size-mobile); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "内容指南",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {"type":"header","content":"基础设置"},
    {
      "type": "select",
      "id": "section_width",
      "label": "内容宽度",
      "options": [
        { "value": "page-width", "label": "页面宽度" },
        { "value": "full-width", "label": "全宽" }
      ],
      "default": "page-width"
    },
    {"type":"header","content":"内容设置"},
    { "type": "text", "id": "eyebrow", "label": "小标题", "default": "GUIDE" },
    { "type": "text", "id": "heading", "label": "主标题", "default": "Content Guide" },
    { "type": "richtext", "id": "description", "label": "简介" },
    {
      "type": "checkbox",
      "id": "show_index",
      "label": "显示 01 / 02 编号",
      "default": false
    },
    { "type": "text", "id": "value_suffix", "label": "数值后缀", "info": "例如 GOLD、mm、kg；留空则只显示数值" },
    { "type": "text", "id": "feature_heading", "label": "右侧图片标题" },
    { "type": "richtext", "id": "feature_body", "label": "正文" },
    {"type":"header","content":"图片设置"},
    {
      "type": "select",
      "id": "item_image_shape",
      "label": "图片形状",
      "options": [
        { "value": "circle", "label": "圆形" },
        { "value": "square", "label": "正方形" },
        { "value": "landscape", "label": "长方形 4:3" },
        { "value": "wide", "label": "横图 16:9" }
      ],
      "default": "square"
    },
    {
      "type": "range",
      "id": "item_image_size",
      "label": "图片固定宽度",
      "min": 48,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    { "type": "image_picker", "id": "feature_image", "label": "大图" },
    {
      "type": "select",
      "id": "feature_image_ratio",
      "label": "大图比例",
      "options": [
        { "value": "square", "label": "正方形" },
        { "value": "landscape", "label": "4:3" },
        { "value": "wide", "label": "16:9" }
      ],
      "default": "landscape"
    },
    {"type":"header","content":"颜色设置"},
    { "type": "color", "id": "background_color", "label": "背景颜色", "default": "#FFFFFF" },
    { "type": "color", "id": "line_color", "label": "分隔线颜色", "default": "#D8D5CE" },
    { "type": "color", "id": "hover_background_color", "label": "项目 Hover 底色", "default": "#F8F7F4" },
    { "type": "color", "id": "eyebrow_color", "label": "小标题颜色", "default": "#C7A85E" },
    { "type": "color", "id": "heading_color", "label": "主标题颜色", "default": "#17191A" },
    { "type": "color", "id": "description_color", "label": "简介颜色", "default": "#5F615E" },
    { "type": "color", "id": "item_title_color", "label": "项目标题颜色", "default": "#17191A" },
    { "type": "color", "id": "item_body_color", "label": "项目正文颜色", "default": "#4F514E" },
    { "type": "color", "id": "value_color", "label": "数值颜色", "default": "#C7A85E" },
    { "type": "color", "id": "meta_color", "label": "附加信息颜色", "default": "#5F615E" },
    { "type": "color", "id": "feature_title_color", "label": "右侧标题颜色", "default": "#17191A" },
    { "type": "color", "id": "feature_body_color", "label": "右侧正文颜色", "default": "#4F514E" },
    {"type":"header","content":"布局与交互"},
    { "type": "range", "id": "item_padding_inline", "label": "项目左右内边距", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 20 },
    {
      "type": "select",
      "id": "intro_alignment",
      "label": "标题区对齐",
      "options": [
        { "value": "left", "label": "左对齐" },
        { "value": "center", "label": "居中" },
        { "value": "right", "label": "右对齐" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "item_alignment",
      "label": "项目文字对齐",
      "options": [
        { "value": "left", "label": "左对齐" },
        { "value": "center", "label": "居中" },
        { "value": "right", "label": "右对齐" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "feature_alignment",
      "label": "右侧文字对齐",
      "options": [
        { "value": "left", "label": "左对齐" },
        { "value": "center", "label": "居中" },
        { "value": "right", "label": "右对齐" }
      ],
      "default": "left"
    },
    { "type": "range", "id": "column_gap", "label": "左右间距", "min": 24, "max": 96, "step": 4, "unit": "px", "default": 56 },
    {"type":"header","content":"电脑端字号"},
    { "type": "range", "id": "eyebrow_size", "label": "小标题字号", "min": 10, "max": 24, "step": 1, "unit": "px", "default": 12 },
