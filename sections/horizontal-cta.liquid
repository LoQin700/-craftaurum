{% comment %}Generic full-width or page-width horizontal CTA band using the shared CTA renderer.{% endcomment %}
<section
  id="HorizontalCTA-{{ section.id }}"
  class="section section--{{ section.settings.section_width | default: 'full-width' }} spacing-style ca-horizontal-cta"
  style="--padding-block-start: {{ section.settings.padding_top }}px; --padding-block-end: {{ section.settings.padding_bottom }}px;"
>
  <div class="ca-horizontal-cta__inner">
    <div class="ca-horizontal-cta__copy">
      {% if section.settings.heading != blank %}
        <h2 class="ca-horizontal-cta__heading {{ section.settings.heading_preset | default: 'h3' }}">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <div class="ca-horizontal-cta__description rte {{ section.settings.body_preset | default: 'h5' }}">{{ section.settings.description }}</div>
      {% endif %}
    </div>
    {% if section.settings.button_label != blank %}
      <div class="ca-horizontal-cta__action">
        {% render 'craftaurum-cta',
          label: section.settings.button_label,
          link: section.settings.button_link,
          style_class: section.settings.button_style,
          static_label: true
        %}
      </div>
    {% endif %}
  </div>
</section>
{% stylesheet %}
  .ca-horizontal-cta { background: var(--color-foreground); color: var(--color-background); }
  .ca-horizontal-cta__inner {
    width: min(100%, 1200px);
    margin: 0 auto;
    padding-inline: 24px;
    display: grid;
    grid-template-columns: minmax(0,1fr) auto;
    align-items: center;
    gap: 30px;
  }
  .ca-horizontal-cta__heading { margin: 0 0 8px; color: inherit; }
  .ca-horizontal-cta__description { color: inherit; opacity: .78; }
  .ca-horizontal-cta__description :is(p,ul,ol) { font-size: inherit; line-height: inherit; }
  .ca-horizontal-cta__description p { margin: 0; }
  .ca-horizontal-cta .button-secondary {
    --button-color: var(--color-background);
    --button-background-color: transparent;
    --button-border-color: var(--color-background);
  }
  .ca-horizontal-cta .button-secondary:hover {
    --button-color: var(--color-foreground);
    --button-background-color: var(--color-accent, #C7A85E);
    --button-border-color: var(--color-accent, #C7A85E);
  }
  @media screen and (max-width: 749px) {
    .ca-horizontal-cta__inner { grid-template-columns: minmax(0,1fr); gap: 18px; padding-inline: 18px; }
    .ca-horizontal-cta__action { justify-self: start; }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "横向 CTA",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "内容宽度",
      "options": [
        {
          "value": "page-width",
          "label": "页面宽度"
        },
        {
          "value": "full-width",
          "label": "全宽"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "From design concept to custom jewelry production."
    },
    {
      "type": "select",
      "id": "heading_preset",
      "label": "标题字号",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h3"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "正文",
      "default": "<p>One clear process, developed around the needs of your collection.</p>"
    },
    {
      "type": "select",
      "id": "body_preset",
      "label": "正文字号",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h5"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "按钮文字",
      "default": "Discover Our Process"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "按钮链接"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "按钮样式",
      "options": [
        {
          "value": "button",
          "label": "主按钮"
        },
        {
          "value": "button-secondary",
          "label": "次级按钮"
        },
        {
          "value": "button-unstyled",
          "label": "文字链接"
        }
      ],
      "default": "button-secondary"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "上边距",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下边距",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "横向 CTA"
    }
  ]
}
{% endschema %}
