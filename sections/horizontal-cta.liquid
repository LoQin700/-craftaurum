        {
          "value": "page-width",
          "label": "页面宽度"
        },
        {
          "value": "full-width",
          "label": "全宽"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "From design concept to custom jewelry production."
    },
    {
      "type": "select",
      "id": "heading_preset",
      "label": "标题字号",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h3"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "正文",
      "default": "<p>One clear process, developed around the needs of your collection.</p>"
    },
    {
      "type": "select",
      "id": "body_preset",
      "label": "正文字号",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h5"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "按钮文字",
      "default": "Discover Our Process"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "按钮链接"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "按钮样式",
      "options": [
        {
          "value": "button",
          "label": "主按钮"
        },
        {
          "value": "button-secondary",
          "label": "次级按钮"
        },
        {
          "value": "button-unstyled",
          "label": "文字链接"
        }
      ],
      "default": "button-secondary"
    },
    {
      "type": "header",
      "content": "颜色"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景颜色",
      "default": "#17191A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文字颜色",
      "default": "#F8F7F4"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "按钮背景颜色",
      "default": "#17191A"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "按钮文字颜色",
      "default": "#F8F7F4"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "按钮边框颜色",
      "default": "#F8F7F4"
    },
    {
      "type": "color",
      "id": "button_hover_background_color",
      "label": "按钮 Hover 背景颜色",
      "default": "#C7A85E"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "按钮 Hover 文字颜色",
      "default": "#17191A"
    },
    {
      "type": "color",
      "id": "button_hover_border_color",
      "label": "按钮 Hover 边框颜色",
      "default": "#C7A85E"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "上边距",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下边距",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "横向 CTA"
    }
  ]
}
{% endschema %}
