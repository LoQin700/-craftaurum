    {
      "type": "header",
      "content": "颜色"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景颜色",
      "default": "#17191A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文字颜色",
      "default": "#F8F7F4"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "按钮背景颜色",
      "default": "#17191A"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "按钮文字颜色",
