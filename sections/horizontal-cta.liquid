{% comment %}Generic horizontal CTA with a real background surface inside Horizon's transparent .section grid.{% endcomment %}
<section
  id="HorizontalCTA-{{ section.id }}"
  class="section section--{{ section.settings.section_width | default: 'full-width' }} spacing-style ca-horizontal-cta"
  style="
    --padding-block-start: {{ section.settings.padding_top }}px;
    --padding-block-end: {{ section.settings.padding_bottom }}px;
    --ca-cta-background: {{ section.settings.background_color }};
    --ca-cta-text: {{ section.settings.text_color }};

    --ca-cta-heading-size: {{ section.settings.heading_size | default: 35 }}px;
    --ca-cta-heading-size-mobile: {{ section.settings.mobile_heading_size | default: 35 }}px;
    --ca-cta-body-size: {{ section.settings.body_size | default: 16 }}px;
    --ca-cta-body-size-mobile: {{ section.settings.mobile_body_size | default: 16 }}px;
  "
>
  <div class="ca-horizontal-cta__surface">
    <div class="ca-horizontal-cta__inner" data-ca-reveal="{{ section.settings.animation_style | default: 'fade-up' }}">
      <div class="ca-horizontal-cta__copy">
        {% if section.settings.heading != blank %}
          <h2 class="ca-horizontal-cta__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="ca-horizontal-cta__description rte">{{ section.settings.description }}</div>
        {% endif %}
      </div>
      {% if section.settings.button_label != blank %}
        <div class="ca-horizontal-cta__action">
          {% render 'craftaurum-cta',
            label: section.settings.button_label,
            link: section.settings.button_link,
            style_class: section.settings.button_style,
            static_label: true
          %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .ca-horizontal-cta__surface {
    width: 100%;
    background: var(--ca-cta-background, #17191A);
    color: var(--ca-cta-text, #F8F7F4);
    padding-block: var(--padding-block-start, 36px) var(--padding-block-end, 36px);
  }
  .ca-horizontal-cta__inner {
    width: min(calc(100% - 48px), 1200px);
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0,1fr) auto;
    align-items: center;
    gap: 40px;
  }
  .ca-horizontal-cta__heading { margin: 0 0 8px; color: inherit; font-size: var(--ca-cta-heading-size); line-height: 1.08; }
  .ca-horizontal-cta__description { color: inherit; opacity: .78; font-size: var(--ca-cta-body-size); line-height: 1.6; }
  .ca-horizontal-cta__description :is(p,ul,ol) { font-size: inherit; line-height: inherit; }
  .ca-horizontal-cta__description p { margin: 0; }

  @media screen and (max-width: 749px) {
    .ca-horizontal-cta__inner {
      width: min(calc(100% - 36px), 1200px);
      grid-template-columns: minmax(0,1fr);
      gap: 18px;
    }
    .ca-horizontal-cta__action { justify-self: start; }
  }

  @media screen and (max-width: 749px) {
    .ca-horizontal-cta__heading { font-size: var(--ca-cta-heading-size-mobile); }
    .ca-horizontal-cta__description { font-size: var(--ca-cta-body-size-mobile); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "横向 CTA",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "基础设置"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "内容宽度",
      "options": [
        {
          "value": "page-width",
          "label": "页面宽度"
        },
        {
          "value": "full-width",
          "label": "全宽"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "header",
      "content": "内容设置"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "From design concept to custom jewelry production."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "正文",
      "default": "<p>One clear process, developed around the needs of your collection.</p>"
    },
    {
      "type": "header",
      "content": "按钮设置"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "按钮文字",
      "default": "Discover Our Process"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "按钮链接"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "按钮样式",
      "options": [
        {
          "value": "button",
          "label": "主按钮"
        },
        {
          "value": "button-secondary",
          "label": "次级按钮"
        },
        {
          "value": "button-unstyled",
          "label": "文字链接"
        }
      ],
      "default": "button-secondary"
    },
    {
      "type": "header",
      "content": "颜色设置"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景颜色",
      "default": "#17191A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文字颜色",
      "default": "#F8F7F4"
    },
    {
      "type": "header",
      "content": "电脑端字号"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "标题字号",
      "min": 24,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 35
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "正文字号",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "移动端字号"
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "标题字号",
      "min": 24,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 25
    },
    {
      "type": "range",
      "id": "mobile_body_size",
      "label": "正文字号",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "其它设置"
    },
    {
      "type": "select",
      "id": "animation_style",
      "label": "入场动画",
      "options": [
        {
          "value": "fade-up",
          "label": "Fade Up"
        },
        {
          "value": "fade-in",
          "label": "Fade In"
        },
        {
          "value": "soft-zoom",
          "label": "Soft Zoom"
        }
      ],
      "default": "fade-up"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "上边距",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下边距",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "横向 CTA"
    }
  ]
}
{% endschema %}
