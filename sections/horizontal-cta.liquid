    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "按钮 Hover 文字颜色",
      "default": "#17191A"
    },
    {
      "type": "color",
      "id": "button_hover_border_color",
      "label": "按钮 Hover 边框颜色",
