    {
      "type": "select",
      "id": "button_style",
      "label": "按钮样式",
      "options": [
        {
          "value": "button",
          "label": "主按钮"
        },
        {
          "value": "button-secondary",
          "label": "次级按钮"
        },
        {
          "value": "button-unstyled",
          "label": "文字链接"
        }
      ],
      "default": "button-secondary"
