{% comment %}Generic editorial image/text banner, using shared Craftaurum CTA.{% endcomment %}
<section id="EditorialBanner-{{ section.id }}" class="section section--{{ section.settings.section_width | default: 'page-width' }} spacing-style ca-editorial-banner"
  style="--padding-block-start: {{ section.settings.padding_top }}px; --padding-block-end: {{ section.settings.padding_bottom }}px; --ca-banner-ratio: {% case section.settings.image_ratio %}{% when 'wide' %}16 / 9{% when 'square' %}1 / 1{% else %}4 / 3{% endcase %};">
  <div class="ca-editorial-banner__layout{% if section.settings.image_position == 'right' %} ca-editorial-banner__layout--image-right{% endif %}">
    <div class="ca-editorial-banner__media">
      {% if section.settings.hero_image != blank %}
        {{
          section.settings.hero_image
          | image_url: width: 1800
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '360, 540, 720, 960, 1200, 1600, 1800',
            sizes: '(min-width: 750px) 47vw, 100vw',
            class: 'ca-editorial-banner__image'
        }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'ca-editorial-banner__placeholder' }}
      {% endif %}
    </div>
    <div class="ca-editorial-banner__content">
      {% if section.settings.eyebrow != blank %}
        <p class="ca-editorial-banner__eyebrow {{ section.settings.eyebrow_preset | default: 'h5' }}">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h1 class="ca-editorial-banner__title {{ section.settings.heading_preset | default: 'h1' }}">{{ section.settings.heading | escape }}</h1>
      {% endif %}
      {% if section.settings.introduction != blank %}
        <div class="ca-editorial-banner__body rte {{ section.settings.body_preset | default: 'h5' }}">{{ section.settings.introduction }}</div>
      {% endif %}
      <div class="ca-editorial-banner__actions">
        {% if section.settings.quote_label != blank %}
          {% assign primary_href = section.settings.quote_url | default: '#craftaurum-jewelry-inquiry' %}
          {% render 'craftaurum-cta', label: section.settings.quote_label, link: primary_href, style_class: 'button' %}
        {% endif %}
        {% if section.settings.catalog_label != blank %}
          {% assign secondary_href = section.settings.catalog_url | default: '#craftaurum-jewelry-inquiry' %}
          {% render 'craftaurum-cta', label: section.settings.catalog_label, link: secondary_href, style_class: 'button-secondary' %}
        {% endif %}
      </div>
    </div>
  </div>
</section>
{% stylesheet %}
  .ca-editorial-banner__layout { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: clamp(24px,5vw,76px); align-items: center; }
  .ca-editorial-banner__media { width: 100%; min-width: 0; aspect-ratio: var(--ca-banner-ratio, 4 / 3); overflow: hidden; }
  .ca-editorial-banner__layout--image-right .ca-editorial-banner__media { grid-column: 2; grid-row: 1; }
  .ca-editorial-banner__layout--image-right .ca-editorial-banner__content { grid-column: 1; grid-row: 1; }
  .ca-editorial-banner__image, .ca-editorial-banner__placeholder { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ca-editorial-banner__placeholder { background: rgb(var(--color-foreground-rgb) / .04); color: rgb(var(--color-foreground-rgb) / .18); }
  .ca-editorial-banner__content { min-width: 0; }
  .ca-editorial-banner__eyebrow { margin: 0 0 12px; }
  .ca-editorial-banner__title { margin: 0 0 18px; }
  .ca-editorial-banner__body { max-width: 64ch; }
  .ca-editorial-banner__body :is(p,ul,ol) { font-size: inherit; line-height: inherit; }
  .ca-editorial-banner__body p { margin: 0 0 1.2em; }
  .ca-editorial-banner__body p:last-child { margin-bottom: 0; }
  .ca-editorial-banner__actions { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  @media (max-width: 749px) {
    .ca-editorial-banner__layout { grid-template-columns: minmax(0,1fr); gap: 22px; }
    .ca-editorial-banner__layout--image-right .ca-editorial-banner__media,
    .ca-editorial-banner__layout--image-right .ca-editorial-banner__content { grid-column: 1; grid-row: auto; }
    .ca-editorial-banner__layout--image-right .ca-editorial-banner__content { order: 0; }
    .ca-editorial-banner__layout--image-right .ca-editorial-banner__media { order: 1; }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "图文横幅",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "内容宽度",
      "options": [
        {
          "value": "page-width",
          "label": "页面宽度"
        },
        {
          "value": "full-width",
          "label": "全宽"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "顶部介绍"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "顶部小标题",
      "default": "JEWELRY MANUFACTURING"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "主标题",
      "default": "Custom Fashion Jewelry"
    },
    {
      "type": "richtext",
      "id": "introduction",
      "label": "介绍文字",
      "default": "<p>Discover custom jewelry created for brands, designers, and wholesale partners. Craftaurum supports the development of rings, earrings, bracelets, and necklaces with thoughtful detailing and flexible design possibilities.</p><p>From initial concepts to finished collections, our focus is on refined craftsmanship and clear collaboration throughout your project.</p>"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "顶部介绍图片"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "图片位置",
      "options": [
        {
          "value": "left",
          "label": "左侧"
        },
        {
          "value": "right",
          "label": "右侧"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "图片比例",
      "options": [
        {
          "value": "wide",
          "label": "横图 16:9"
        },
        {
          "value": "landscape",
          "label": "横图 4:3"
        },
        {
          "value": "square",
          "label": "正方形"
        }
      ],
      "default": "landscape"
    },
    {
      "type": "text",
      "id": "quote_label",
      "label": "主按钮文字",
      "default": "Get B2B Quote"
    },
    {
      "type": "url",
      "id": "quote_url",
      "label": "主按钮链接"
    },
    {
      "type": "text",
      "id": "catalog_label",
      "label": "次级按钮文字",
      "default": "Request Catalog"
    },
    {
      "type": "url",
      "id": "catalog_url",
      "label": "次级按钮链接"
    },
    {
      "type": "select",
      "id": "heading_preset",
      "label": "主标题字号",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "eyebrow_preset",
      "label": "小标题字号",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h5"
    },
    {
      "type": "select",
      "id": "body_preset",
      "label": "正文字号",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h5"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "上边距",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下边距",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "图文横幅"
    }
  ]
}
{% endschema %}
