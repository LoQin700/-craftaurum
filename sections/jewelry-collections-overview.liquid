{% comment %}Generic editorial image/text banner. Background is full-width; setting controls inner content width.{% endcomment %}
{% liquid
  assign content_width = section.settings.section_width | default: 'page-width'
  assign background_color = section.settings.background_color | default: '#FFFFFF'
  assign text_color = section.settings.text_color | default: '#17191A'
  assign accent_color = section.settings.accent_color | default: '#C7A85E'
  assign padding_top = section.settings.padding_top | default: 32
  assign padding_bottom = section.settings.padding_bottom | default: 32
  assign image_position = section.settings.image_position | default: 'right'
  assign image_ratio = section.settings.image_ratio | default: 'wide'
  assign ratio = '16 / 9'
  if image_ratio == 'square'
    assign ratio = '1 / 1'
  elsif image_ratio == 'landscape'
    assign ratio = '4 / 3'
  endif
%}
<section
  id="EditorialBanner-{{ section.id }}"
  class="section section--full-width ca-editorial-banner"
  style="
    --ca-banner-background: {{ background_color }};
    --ca-banner-text: {{ text_color }};
    --ca-banner-accent: {{ accent_color }};
    --ca-banner-ratio: {{ ratio }};
    --ca-banner-padding-top: {{ padding_top }}px;
    --ca-banner-padding-bottom: {{ padding_bottom }}px;
  "
>
  <div class="ca-editorial-banner__surface">
    <div class="ca-editorial-banner__inner ca-editorial-banner__inner--{{ content_width }}">
      <div class="ca-editorial-banner__layout{% if image_position == 'right' %} ca-editorial-banner__layout--image-right{% endif %}">
        <div class="ca-editorial-banner__media">
          {% if section.settings.hero_image != blank %}
            {{
              section.settings.hero_image
              | image_url: width: 1800
              | image_tag:
                loading: 'eager',
                fetchpriority: 'high',
                widths: '360,540,720,960,1200,1600,1800',
                sizes: '(min-width: 750px) 56vw, 100vw',
                class: 'ca-editorial-banner__image'
            }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'ca-editorial-banner__placeholder' }}
          {% endif %}
        </div>
        <div class="ca-editorial-banner__content">
          {% if section.settings.eyebrow != blank %}
            <p class="ca-editorial-banner__eyebrow {{ section.settings.eyebrow_preset | default: 'h5' }}">{{ section.settings.eyebrow | escape }}</p>
          {% endif %}
          {% if section.settings.heading != blank %}
            <h1 class="ca-editorial-banner__title {{ section.settings.heading_preset | default: 'h1' }}">{{ section.settings.heading | escape }}</h1>
          {% endif %}
          {% if section.settings.introduction != blank %}
            <div class="ca-editorial-banner__body rte {{ section.settings.body_preset | default: 'h5' }}">{{ section.settings.introduction }}</div>
          {% endif %}
          <div class="ca-editorial-banner__actions">
            {% if section.settings.quote_label != blank %}
              {% assign primary_href = section.settings.quote_url | default: '#craftaurum-jewelry-inquiry' %}
              {% render 'craftaurum-cta', label: section.settings.quote_label, link: primary_href, style_class: 'button' %}
            {% endif %}
            {% if section.settings.catalog_label != blank %}
              {% assign secondary_href = section.settings.catalog_url | default: '#craftaurum-jewelry-inquiry' %}
              {% render 'craftaurum-cta', label: section.settings.catalog_label, link: secondary_href, style_class: 'button-secondary' %}
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .ca-editorial-banner__surface {
    width: 100%;
    background: var(--ca-banner-background);
    color: var(--ca-banner-text);
  }
  .ca-editorial-banner__inner {
    padding-block: var(--ca-banner-padding-top) var(--ca-banner-padding-bottom);
  }
  .ca-editorial-banner__inner--page-width {
    width: var(--full-page-grid-central-column-width);
    margin-inline: auto;
  }
  .ca-editorial-banner__inner--full-width {
    width: 100%;
    padding-inline: max(var(--page-margin), 24px);
  }
  .ca-editorial-banner__layout {
    display: grid;
    grid-template-columns: minmax(0,.82fr) minmax(0,1.18fr);
    gap: clamp(28px,5vw,76px);
    align-items: center;
  }
  .ca-editorial-banner__media {
    width: 100%;
    min-width: 0;
    aspect-ratio: var(--ca-banner-ratio);
    overflow: hidden;
  }
  .ca-editorial-banner__layout--image-right .ca-editorial-banner__media { grid-column: 2; grid-row: 1; }
  .ca-editorial-banner__layout--image-right .ca-editorial-banner__content { grid-column: 1; grid-row: 1; }
  .ca-editorial-banner__image,
  .ca-editorial-banner__placeholder { display:block; width:100%; height:100%; object-fit:cover; }
  .ca-editorial-banner__placeholder {
    background: rgb(var(--color-foreground-rgb) / .04);
    color: rgb(var(--color-foreground-rgb) / .18);
  }
  .ca-editorial-banner__content { min-width:0; }
  .ca-editorial-banner__eyebrow {
    margin: 0 0 12px;
    color: var(--ca-banner-accent);
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .ca-editorial-banner__title { margin: 0 0 18px; color: inherit; }
  .ca-editorial-banner__body { max-width: 64ch; }
  .ca-editorial-banner__body :is(p,ul,ol) { font-size:inherit; line-height:inherit; }
  .ca-editorial-banner__body p { margin:0 0 1.2em; }
  .ca-editorial-banner__body p:last-child { margin-bottom:0; }
  .ca-editorial-banner__actions { display:flex; align-items:center; flex-wrap:wrap; gap:12px; margin-top:24px; }

  @media screen and (max-width: 749px) {
    .ca-editorial-banner__inner--full-width { padding-inline: 18px; }
    .ca-editorial-banner__layout { grid-template-columns:minmax(0,1fr); gap:22px; }
    .ca-editorial-banner__layout--image-right .ca-editorial-banner__media,
    .ca-editorial-banner__layout--image-right .ca-editorial-banner__content { grid-column:1; grid-row:auto; }
    .ca-editorial-banner__layout--image-right .ca-editorial-banner__content { order:0; }
    .ca-editorial-banner__layout--image-right .ca-editorial-banner__media { order:1; }
  }
{% endstylesheet %}

