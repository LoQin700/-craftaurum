{% comment %}Generic editorial image/text banner. Background is full-width; setting controls inner content width.{% endcomment %}
{% liquid
  assign content_width = section.settings.section_width | default: 'page-width'
  assign background_color = section.settings.background_color | default: '#FFFFFF'
  assign text_color = section.settings.text_color | default: '#17191A'
  assign accent_color = section.settings.accent_color | default: '#C7A85E'
  assign padding_top = section.settings.padding_top | default: 32
  assign padding_bottom = section.settings.padding_bottom | default: 32
  assign image_position = section.settings.image_position | default: 'right'
  assign image_ratio = section.settings.image_ratio | default: 'wide'
  assign ratio = '16 / 9'
  if image_ratio == 'square'
    assign ratio = '1 / 1'
  elsif image_ratio == 'landscape'
    assign ratio = '4 / 3'
  endif
%}
<section
  id="EditorialBanner-{{ section.id }}"
  class="section section--full-width ca-editorial-banner"
  style="
    --ca-banner-background: {{ background_color }};
    --ca-banner-text: {{ text_color }};
    --ca-banner-accent: {{ accent_color }};
    --ca-banner-ratio: {{ ratio }};
    --ca-banner-padding-top: {{ padding_top }}px;
    --ca-banner-padding-bottom: {{ padding_bottom }}px;
    --ca-banner-eyebrow-size: {{ section.settings.eyebrow_size | default: 12 }}px;
    --ca-banner-eyebrow-size-mobile: {{ section.settings.mobile_eyebrow_size | default: 12 }}px;
    --ca-banner-heading-size: {{ section.settings.heading_size | default: 58 }}px;
    --ca-banner-heading-size-mobile: {{ section.settings.mobile_heading_size | default: 48 }}px;
    --ca-banner-body-size: {{ section.settings.body_size | default: 16 }}px;
    --ca-banner-body-size-mobile: {{ section.settings.mobile_body_size | default: 16 }}px;
  "
>
  <div class="ca-editorial-banner__surface">
    <div class="ca-editorial-banner__inner ca-editorial-banner__inner--{{ content_width }}">
      <div class="ca-editorial-banner__layout{% if image_position == 'right' %} ca-editorial-banner__layout--image-right{% endif %}" data-ca-reveal="{{ section.settings.animation_style | default: 'fade-up' }}">
        <div class="ca-editorial-banner__media">
          {% if section.settings.hero_image != blank %}
            {{
              section.settings.hero_image
              | image_url: width: 1800
              | image_tag:
                loading: 'eager',
                fetchpriority: 'high',
                widths: '360,540,720,960,1200,1600,1800',
                sizes: '(min-width: 750px) 56vw, 100vw',
                class: 'ca-editorial-banner__image'
            }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'ca-editorial-banner__placeholder' }}
          {% endif %}
        </div>
        <div class="ca-editorial-banner__content">
          {% if section.settings.eyebrow != blank %}
            <p class="ca-editorial-banner__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {% endif %}
          {% if section.settings.heading != blank %}
            <h1 class="ca-editorial-banner__title">{{ section.settings.heading | escape }}</h1>
          {% endif %}
          {% if section.settings.introduction != blank %}
            <div class="ca-editorial-banner__body rte">{{ section.settings.introduction }}</div>
          {% endif %}
          <div class="ca-editorial-banner__actions">
            {% if section.settings.quote_label != blank %}
              {% assign primary_href = section.settings.quote_url | default: '#craftaurum-jewelry-inquiry' %}
              {% render 'craftaurum-cta', label: section.settings.quote_label, link: primary_href, style_class: 'button' %}
            {% endif %}
            {% if section.settings.catalog_label != blank %}
              {% assign secondary_href = section.settings.catalog_url | default: '#craftaurum-jewelry-inquiry' %}
              {% render 'craftaurum-cta', label: section.settings.catalog_label, link: secondary_href, style_class: 'button-secondary' %}
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .ca-editorial-banner__surface {
    width: 100%;
    background: var(--ca-banner-background);
    color: var(--ca-banner-text);
  }
  .ca-editorial-banner__inner {
    padding-block: var(--ca-banner-padding-top) var(--ca-banner-padding-bottom);
  }
  .ca-editorial-banner__inner--page-width {
    width: var(--full-page-grid-central-column-width);
    margin-inline: auto;
  }
  .ca-editorial-banner__inner--full-width {
    width: 100%;
    padding-inline: max(var(--page-margin), 24px);
  }
  .ca-editorial-banner__layout {
    display: grid;
    grid-template-columns: minmax(0,.82fr) minmax(0,1.18fr);
    gap: clamp(28px,5vw,76px);
    align-items: center;
  }
  .ca-editorial-banner__media {
    width: 100%;
    min-width: 0;
    aspect-ratio: var(--ca-banner-ratio);
    overflow: hidden;
  }
  .ca-editorial-banner__layout--image-right .ca-editorial-banner__media { grid-column: 2; grid-row: 1; }
  .ca-editorial-banner__layout--image-right .ca-editorial-banner__content { grid-column: 1; grid-row: 1; }
  .ca-editorial-banner__image,
  .ca-editorial-banner__placeholder { display:block; width:100%; height:100%; object-fit:cover; }
  .ca-editorial-banner__placeholder {
    background: rgb(var(--color-foreground-rgb) / .04);
    color: rgb(var(--color-foreground-rgb) / .18);
  }
  .ca-editorial-banner__content { min-width:0; }
  .ca-editorial-banner__eyebrow {
    margin: 0 0 12px;
    color: var(--ca-banner-accent);
    letter-spacing: .12em;
    text-transform: uppercase;
    font-size: var(--ca-banner-eyebrow-size);
  }
  .ca-editorial-banner__title { margin: 0 0 18px; color: inherit; font-size: var(--ca-banner-heading-size); line-height: 1.02; }
  .ca-editorial-banner__body { max-width: 64ch; font-size: var(--ca-banner-body-size); }
  .ca-editorial-banner__body :is(p,ul,ol) { font-size:inherit; line-height:inherit; }
  .ca-editorial-banner__body p { margin:0 0 1.2em; }
  .ca-editorial-banner__body p:last-child { margin-bottom:0; }
  .ca-editorial-banner__actions { display:flex; align-items:center; flex-wrap:wrap; gap:12px; margin-top:24px; }

  @media screen and (max-width: 749px) {
    .ca-editorial-banner__inner--full-width { padding-inline: 18px; }
    .ca-editorial-banner__layout { grid-template-columns:minmax(0,1fr); gap:22px; }
    .ca-editorial-banner__layout--image-right .ca-editorial-banner__media,
    .ca-editorial-banner__layout--image-right .ca-editorial-banner__content { grid-column:1; grid-row:auto; }
    .ca-editorial-banner__layout--image-right .ca-editorial-banner__content { order:0; }
    .ca-editorial-banner__layout--image-right .ca-editorial-banner__media { order:1; }
    .ca-editorial-banner__title { font-size: min(var(--ca-banner-heading-size), 48px); }
  }

  @media screen and (max-width: 749px) {
    .ca-editorial-banner__eyebrow { font-size: var(--ca-banner-eyebrow-size-mobile); }
    .ca-editorial-banner__title { font-size: var(--ca-banner-heading-size-mobile); }
    .ca-editorial-banner__body { font-size: var(--ca-banner-body-size-mobile); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "图文横幅",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "基础设置"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "内容宽度",
      "options": [
        {
          "value": "page-width",
          "label": "页面宽度"
        },
        {
          "value": "full-width",
          "label": "全宽"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "内容设置"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "顶部小标题",
      "default": "JEWELRY MANUFACTURING"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "主标题",
      "default": "Custom Fashion Jewelry"
    },
    {
      "type": "richtext",
      "id": "introduction",
      "label": "正文",
      "default": "<p>Discover custom jewelry created for brands, designers, and wholesale partners. Craftaurum supports the development of rings, earrings, bracelets, and necklaces with thoughtful detailing and flexible design possibilities.</p><p>From initial concepts to finished collections, our focus is on refined craftsmanship and clear collaboration throughout your project.</p>"
    },
    {
      "type": "header",
      "content": "按钮设置"
    },
    {
      "type": "text",
      "id": "quote_label",
      "label": "主按钮文字",
      "default": "Get B2B Quote"
    },
    {
      "type": "url",
      "id": "quote_url",
      "label": "主按钮链接"
    },
    {
      "type": "text",
      "id": "catalog_label",
      "label": "次级按钮文字",
      "default": "Request Catalog"
    },
    {
      "type": "url",
      "id": "catalog_url",
      "label": "次级按钮链接"
    },
    {
      "type": "header",
      "content": "图片设置"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "顶部介绍图片"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "图片位置",
      "options": [
        {
          "value": "left",
          "label": "左侧"
        },
        {
          "value": "right",
          "label": "右侧"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "图片比例",
      "options": [
        {
          "value": "wide",
          "label": "横图 16:9"
        },
        {
          "value": "landscape",
          "label": "横图 4:3"
        },
        {
          "value": "square",
          "label": "正方形"
        }
      ],
      "default": "landscape"
    },
    {
      "type": "header",
      "content": "电脑端字号"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "顶部小标题字号",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "主标题字号",
      "min": 28,
      "max": 88,
      "step": 2,
      "unit": "px",
      "default": 58
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "正文字号",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "移动端字号"
    },
    {
      "type": "range",
      "id": "mobile_eyebrow_size",
      "label": "顶部小标题字号",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "主标题字号",
      "min": 20,
      "max": 88,
      "step": 1,
      "unit": "px",
      "default": 25
    },
    {
      "type": "range",
      "id": "mobile_body_size",
      "label": "正文字号",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "颜色设置"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景颜色",
      "default": "#F8F7F4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文字颜色",
      "default": "#17191A"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "顶部小标题颜色",
      "default": "#C7A85E"
    },
    {
      "type": "header",
      "content": "其它设置"
    },
    {
      "type": "select",
      "id": "animation_style",
      "label": "入场动画",
      "options": [
        {
          "value": "fade-up",
          "label": "Fade Up"
        },
        {
          "value": "fade-in",
          "label": "Fade In"
        },
        {
          "value": "soft-zoom",
          "label": "Soft Zoom"
        }
      ],
      "default": "fade-up"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "上边距",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下边距",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "图文横幅",
      "settings": {
        "section_width": "page-width",
        "background_color": "#FFFFFF",
        "text_color": "#17191A",
        "accent_color": "#C7A85E",
        "eyebrow": "OEM / ODM RING MANUFACTURING",
        "heading": "Custom Rings Manufacturing.",
        "introduction": "<p>Develop custom gemstone, pearl, signet and metal rings with Craftaurum. From design review and material selection to sampling and finishing, each stage can be shaped around the direction of your collection.</p>",
        "image_position": "right",
        "image_ratio": "wide",
        "quote_label": "Request a Manufacturing Quote",
        "catalog_label": "",
        "padding_top": 32,
        "padding_bottom": 32
      }
    }
  ]
}
{% endschema %}
