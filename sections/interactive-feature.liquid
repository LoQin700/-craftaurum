{% comment %}
  能力展示：交互图文 / 图标文字。
  背景始终铺满；内容宽度由设置控制；所有新增设置有 Liquid 安全默认值。
{% endcomment %}
{% liquid
  assign layout_mode = section.settings.layout_mode | default: 'interactive'
  assign content_width = section.settings.section_width | default: 'page-width'
  assign background_color = section.settings.background_color
  if background_color == blank
    if layout_mode == 'icons'
      assign background_color = '#F8F7F4'
    else
      assign background_color = '#FFFFFF'
    endif
  endif
  assign text_color = section.settings.text_color | default: '#17191A'
  assign accent_color = section.settings.accent_color | default: '#C7A85E'
  assign desktop_columns = section.settings.desktop_columns | default: 4
  assign mobile_columns = section.settings.mobile_columns | default: 2
  assign gap = section.settings.gap | default: 24
  assign padding_top = section.settings.padding_top | default: 56
  assign padding_bottom = section.settings.padding_bottom | default: 56
%}
{% if layout_mode != 'icons' %}
  <script src="{{ 'craftaurum-interactive-feature.js' | asset_url }}" defer></script>
{% endif %}

<section
  id="CapabilitySection-{{ section.id }}"
  class="section section--full-width ca-capability ca-capability--{{ layout_mode }}{% unless section.settings.show_index %} ca-capability--no-index{% endunless %}"
  style="
    --ca-cap-background: {{ background_color }};
    --ca-cap-text: {{ text_color }};
    --ca-cap-accent: {{ accent_color }};
    --ca-cap-columns: {{ desktop_columns }};
    --ca-cap-mobile-columns: {{ mobile_columns }};
    --ca-cap-gap: {{ gap }}px;
    --ca-cap-padding-top: {{ padding_top }}px;
    --ca-cap-padding-bottom: {{ padding_bottom }}px;
    --ca-cap-heading-size: {{ section.settings.heading_size | default: 35 }}px;
    --ca-cap-heading-size-mobile: {{ section.settings.mobile_heading_size | default: 35 }}px;
    --ca-cap-body-size: {{ section.settings.body_size | default: 16 }}px;
    --ca-cap-body-size-mobile: {{ section.settings.mobile_body_size | default: 16 }}px;
    --ca-cap-item-title-size: {{ section.settings.item_title_size | default: 20 }}px;
    --ca-cap-item-title-size-mobile: {{ section.settings.mobile_item_title_size | default: 20 }}px;
    --ca-cap-item-body-size: {{ section.settings.item_body_size | default: 15 }}px;
    --ca-cap-item-body-size-mobile: {{ section.settings.mobile_item_body_size | default: 15 }}px;
    --ca-cap-visual-height: {{ section.settings.visual_height | default: 520 }}px;
  "
>
  <div class="ca-capability__surface">
    <div class="ca-capability__inner ca-capability__inner--{{ content_width }}" data-ca-reveal="{{ section.settings.animation_style | default: 'fade-up' }}">
      <header class="ca-capability__intro ca-capability__intro--{{ section.settings.intro_style | default: 'style_1' }}">
        <div class="ca-capability__intro-title">
          {% if section.settings.heading != blank %}
            <h2 class="ca-capability__heading">{{ section.settings.heading | escape }}</h2>
          {% endif %}
        </div>
        <div class="ca-capability__intro-copy">
          {% if section.settings.description != blank %}
            <div class="ca-capability__description rte">{{ section.settings.description }}</div>
          {% endif %}
        </div>
      </header>

      {% if layout_mode == 'icons' %}
        <div class="ca-capability-icons__grid">
          {% for block in section.blocks %}
            <article class="ca-capability-icons__item" {{ block.shopify_attributes }}>
              {% if block.settings.title != blank %}
                <h3 class="ca-capability-icons__title">{{ block.settings.title | escape }}</h3>
              {% endif %}
              {% if block.settings.description != blank %}
                <div class="ca-capability-icons__text rte">{{ block.settings.description }}</div>
              {% endif %}
            </article>
          {% endfor %}
        </div>
      {% else %}
        <craftaurum-interactive-feature class="ca-capability-interactive">
          <div class="ca-capability-interactive__layout ca-capability-interactive__layout--{{ section.settings.visual_height_mode | default: 'match_text' }}">
            <div class="ca-capability-interactive__list" role="tablist" aria-label="{{ section.settings.heading | escape }}">
              {% for block in section.blocks %}
                <button
                  type="button"
                  class="ca-capability-interactive__item{% if forloop.first %} is-active{% endif %}"
                  data-capability-item
                  role="tab"
                  aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                  aria-controls="CapabilityPanel-{{ section.id }}-{{ block.id }}"
                  {{ block.shopify_attributes }}
                >
                  {% if section.settings.show_index %}
                    <span class="ca-capability-interactive__number">{{ forloop.index | prepend: '0' }}</span>
                  {% endif %}
                  <span class="ca-capability-interactive__copy">
                    {% if block.settings.title != blank %}
                      <span class="ca-capability-interactive__title">{{ block.settings.title | escape }}</span>
                    {% endif %}
                    {% if block.settings.description != blank %}
                      <span class="ca-capability-interactive__text">{{ block.settings.description | strip_html }}</span>
                    {% endif %}
                  </span>
                </button>
              {% endfor %}
            </div>

            <div class="ca-capability-interactive__visual">
              {% for block in section.blocks %}
                <div
                  id="CapabilityPanel-{{ section.id }}-{{ block.id }}"
                  class="ca-capability-interactive__panel{% if forloop.first %} is-active{% endif %}"
                  data-capability-panel
                  role="tabpanel"
                  aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
                >
                  {% if block.settings.image != blank %}
                    {{
                      block.settings.image
                      | image_url: width: 1600
                      | image_tag:
                        loading: 'lazy',
                        class: 'ca-capability-interactive__image',
                        widths: '420,640,860,1100,1400,1600',
                        sizes: '(min-width: 750px) 48vw, 100vw'
                    }}
                  {% else %}
                    {{ 'image' | placeholder_svg_tag: 'ca-capability-interactive__placeholder' }}
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          </div>
        </craftaurum-interactive-feature>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .ca-capability__surface {
    width:100%;
    background:var(--ca-cap-background);
    color:var(--ca-cap-text);
  }
  .ca-capability__inner {
    min-width:0;
    padding-block:var(--ca-cap-padding-top) var(--ca-cap-padding-bottom);
  }
  .ca-capability__inner--page-width {
    width:var(--full-page-grid-central-column-width);
    margin-inline:auto;
  }
  .ca-capability__inner--full-width {
    width:100%;
    padding-inline:max(var(--page-margin),24px);
  }
  .ca-capability__intro { max-width:1120px; margin:0 auto 34px; }
  .ca-capability__intro--style_1 { max-width:900px; text-align:center; }
  .ca-capability__intro--style_1 .ca-capability__intro-copy { max-width:760px; margin-inline:auto; }
  .ca-capability__intro--style_2 {
    width:100%;
    max-width:none;
    display:grid;
    grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr);
    gap:clamp(28px,5vw,76px);
    align-items:end;
    text-align:left;
  }
  .ca-capability__heading { margin:0 0 14px; color:inherit; font-size:var(--ca-cap-heading-size); line-height:1.08; }
  .ca-capability__description { font-size:var(--ca-cap-body-size); line-height:1.6; }
  .ca-capability__description :is(p,ul,ol),
  .ca-capability-icons__text :is(p,ul,ol) { font-size:inherit; line-height:inherit; }
  .ca-capability__description p,
  .ca-capability-icons__text p { margin:0; }

  .ca-capability-interactive__layout {
    display:grid;
    grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr);
    gap:clamp(28px,5vw,76px);
  }
  .ca-capability-interactive__layout--match_text { align-items:stretch; }
  .ca-capability-interactive__layout--fixed { align-items:center; }
  .ca-capability-interactive__list {
    display:flex;
    flex-direction:column;
    border-top:1px solid color-mix(in srgb,var(--ca-cap-text) 18%,transparent);
  }
  .ca-capability-interactive__item {
    width:100%;
    display:grid;
    grid-template-columns:42px minmax(0,1fr);
    gap:14px;
    align-items:start;
    padding:22px 0;
    text-align:left;
    color:var(--ca-cap-text);
    background:transparent;
    border:0;
    border-bottom:1px solid color-mix(in srgb,var(--ca-cap-text) 18%,transparent);
    cursor:pointer;
    transition:color .22s ease,padding-inline-start .22s ease;
  }
  .ca-capability-interactive__number { font-size:12px; line-height:1.5; letter-spacing:.08em; color:var(--ca-cap-accent); }
  .ca-capability-interactive__copy { display:grid; gap:7px; }
  .ca-capability-interactive__title { display:block; font-size:var(--ca-cap-item-title-size); line-height:1.25; }
  .ca-capability-interactive__text { display:block; font-size:var(--ca-cap-item-body-size); line-height:1.65; opacity:.68; }
  .ca-capability-interactive__item:is(:hover,:focus-visible,.is-active) { padding-inline-start:8px; }
  .ca-capability-interactive__item.is-active .ca-capability-interactive__title { font-weight:600; }
  .ca-capability--no-index .ca-capability-interactive__item { grid-template-columns:minmax(0,1fr); }
  .ca-capability-interactive__item.is-active .ca-capability-interactive__text { color:var(--ca-cap-text); opacity:.78; }
  .ca-capability-interactive__item:focus-visible { outline:2px solid currentColor; outline-offset:3px; }

  .ca-capability-interactive__visual {
    position:relative;
    overflow:hidden;
    background:color-mix(in srgb,var(--ca-cap-text) 4%,transparent);
  }
  .ca-capability-interactive__layout--match_text .ca-capability-interactive__visual {
    min-height:0;
    height:100%;
  }
  .ca-capability-interactive__layout--fixed .ca-capability-interactive__visual {
    width:100%;
    height:var(--ca-cap-visual-height);
  }
  .ca-capability-interactive__panel {
    position:absolute;
    inset:0;
    opacity:0;
    pointer-events:none;
    transition:opacity .36s ease;
  }
  .ca-capability-interactive__panel.is-active { opacity:1; pointer-events:auto; }
  .ca-capability-interactive__image,
  .ca-capability-interactive__placeholder { display:block; width:100%; height:100%; object-fit:cover; }

  .ca-capability-icons__grid {
    display:grid;
    grid-template-columns:repeat(var(--ca-cap-columns),minmax(0,1fr));
    gap:var(--ca-cap-gap);
  }
  .ca-capability-icons__item {
    min-width:0;
    padding:26px 20px;
    border-top:1px solid color-mix(in srgb,var(--ca-cap-text) 18%,transparent);
  }
  .ca-capability-icons__title { margin:0 0 10px; color:inherit; font-size:var(--ca-cap-item-title-size); line-height:1.25; }
  .ca-capability-icons__text { opacity:.76; font-size:var(--ca-cap-item-body-size); line-height:1.6; }

  @media screen and (max-width:749px) {
    .ca-capability__inner--full-width { padding-inline:18px; }
    .ca-capability__intro { text-align:left; margin-bottom:24px; }
    .ca-capability__intro--style_2 { display:block; }
    .ca-capability__intro--style_2 .ca-capability__intro-title { margin-bottom:14px; }
    .ca-capability__heading { font-size:min(var(--ca-cap-heading-size),44px); }
    .ca-capability-interactive__layout { grid-template-columns:minmax(0,1fr); gap:20px; }
    .ca-capability-interactive__item { grid-template-columns:34px minmax(0,1fr); padding:18px 0; }
    .ca-capability--no-index .ca-capability-interactive__item { grid-template-columns:minmax(0,1fr); }
    .ca-capability-interactive__item:is(:hover,:focus-visible,.is-active) { padding-inline-start:0; }
    .ca-capability-interactive__visual { min-height:0; height:auto !important; aspect-ratio:4 / 3; }
    .ca-capability-icons__grid { grid-template-columns:repeat(var(--ca-cap-mobile-columns),minmax(0,1fr)); }
    .ca-capability-icons__item { padding-inline:0; }
  }
  @media (prefers-reduced-motion:reduce) {
    .ca-capability-interactive__item,
    .ca-capability-interactive__panel { transition:none; }
  }

  @media screen and (max-width: 749px) {
    .ca-capability__heading { font-size: var(--ca-cap-heading-size-mobile); }
    .ca-capability__description { font-size: var(--ca-cap-body-size-mobile); }
    .ca-capability-interactive__title { font-size: var(--ca-cap-item-title-size-mobile); }
    .ca-capability-icons__title { font-size: var(--ca-cap-item-title-size-mobile); }
    .ca-capability-interactive__text { font-size: var(--ca-cap-item-body-size-mobile); }
    .ca-capability-icons__text { font-size: var(--ca-cap-item-body-size-mobile); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "交互图文",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "基础设置"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "内容宽度",
      "options": [
        {
          "value": "page-width",
          "label": "页面宽度"
        },
        {
          "value": "full-width",
          "label": "全宽"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "内容设置"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Focused Capabilities for Custom Ring Development"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "正文",
      "default": "<p>Explore the details that shape a ring collection, from materials and setting choices to design development and production review.</p>"
    },
    {
      "type": "header",
      "content": "图片设置"
    },
    {
      "type": "select",
      "id": "visual_height_mode",
      "label": "图片高度方式",
      "options": [
        {
          "value": "match_text",
          "label": "图片跟随文字高度"
        },
        {
          "value": "fixed",
          "label": "固定高度并与文字居中"
        }
      ],
      "default": "match_text",
      "visible_if": "{{ section.settings.layout_mode == 'interactive' }}"
    },
    {
      "type": "range",
      "id": "visual_height",
      "label": "固定图片高度",
      "min": 320,
      "max": 760,
      "step": 20,
      "unit": "px",
      "default": 520,
      "visible_if": "{{ section.settings.visual_height_mode == 'fixed' and section.settings.layout_mode == 'interactive' }}"
    },
    {
      "type": "header",
      "content": "布局与交互"
    },
    {
      "type": "select",
      "id": "layout_mode",
      "label": "展示样式",
      "options": [
        {
          "value": "interactive",
          "label": "交互图文"
        },
        {
          "value": "icons",
          "label": "卡片文字"
        }
      ],
      "default": "interactive"
    },
    {
      "type": "checkbox",
      "id": "show_index",
      "label": "显示编号",
      "default": true,
      "visible_if": "{{ section.settings.layout_mode == 'interactive' }}"
    },
    {
      "type": "select",
      "id": "intro_style",
      "label": "标题布局",
      "options": [
        {
          "value": "style_1",
          "label": "Style 1"
        },
        {
          "value": "style_2",
          "label": "Style 2"
        }
      ],
      "default": "style_1"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "卡片间距",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "电脑端布局"
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "每行显示数量",
      "info": "仅在卡片文字展示模式下生效",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "移动端布局"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "每行显示数量",
      "info": "仅在卡片文字展示模式下生效",
      "options": [
        {
          "value": "1",
          "label": "1 列"
        },
        {
          "value": "2",
          "label": "2 列"
        }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "电脑端字号"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "标题字号",
      "min": 24,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 35
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "正文字号",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "item_title_size",
      "label": "项目标题字号",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "item_body_size",
      "label": "项目正文字号",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "移动端字号"
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "标题字号",
      "min": 24,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 35
    },
    {
      "type": "range",
      "id": "mobile_body_size",
      "label": "正文字号",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_item_title_size",
      "label": "项目标题字号",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_item_body_size",
      "label": "项目正文字号",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "颜色设置"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景颜色",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文字颜色",
      "default": "#17191A"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "编号",
      "default": "#C7A85E",
      "visible_if": "{{ section.settings.layout_mode == 'interactive' and section.settings.show_index }}"
    },
    {
      "type": "header",
      "content": "其它设置"
    },
    {
      "type": "paragraph",
      "content": "入场动画与区块上下间距"
    },
    {
      "type": "select",
      "id": "animation_style",
      "label": "入场动画",
      "options": [
        {
          "value": "fade-up",
          "label": "Fade Up"
        },
        {
          "value": "fade-in",
          "label": "Fade In"
        },
        {
          "value": "soft-zoom",
          "label": "Soft Zoom"
        }
      ],
      "default": "fade-up"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "上边距",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下边距",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "项目",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "标题",
          "default": "Materials & Finishing"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "正文",
          "default": "<p>Review metal choices, surface finishes and stone-setting directions for your design.</p>"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "交互图片"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "交互图文",
      "settings": {
        "layout_mode": "interactive"
      },
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
