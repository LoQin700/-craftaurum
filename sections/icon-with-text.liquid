{% liquid
  assign content_width = section.settings.section_width
  assign desktop_columns = section.settings.desktop_columns
  assign mobile_columns = section.settings.mobile_columns
%}

<section
  id="IconWithText-{{ section.id }}"
  class="ca-icon-text ca-icon-text--{{ section.settings.style_preset }} ca-icon-text--icon-{{ section.settings.icon_position }} section section--full-width"
  style="
    --ca-icon-background: {{ section.settings.background_color }};
    --ca-icon-text: {{ section.settings.text_color }};
    --ca-icon-accent: {{ section.settings.accent_color }};
    --ca-icon-size: {{ section.settings.icon_size }}px;
    --ca-icon-gap: {{ section.settings.icon_gap }}px;
    --ca-column-gap: {{ section.settings.column_gap }}px;
    --ca-desktop-columns: {{ desktop_columns }};
    --ca-mobile-columns: {{ mobile_columns }};
    --ca-padding-top: {{ section.settings.padding_top }}px;
    --ca-padding-bottom: {{ section.settings.padding_bottom }}px;
    --ca-eyebrow-size: {{ section.settings.eyebrow_size | default: 12 }}px;
    --ca-heading-size: {{ section.settings.heading_size | default: 35 }}px;
    --ca-body-size: {{ section.settings.body_size | default: 15 }}px;
    --ca-item-title-size: {{ section.settings.item_title_size | default: 18 }}px;
  "
>
  <div class="ca-icon-text__surface">
    <div class="ca-icon-text__inner ca-icon-text__inner--{{ content_width }}" data-ca-reveal="{{ section.settings.animation_style | default: 'fade-up' }}">
      <header class="ca-icon-text__intro">
        {% if section.settings.eyebrow != blank %}
          <p class="ca-icon-text__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="ca-icon-text__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="ca-icon-text__description rte">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </header>

      <div class="ca-icon-text__grid">
        {% for block in section.blocks %}
          {% liquid
            assign icon_color = block.settings.icon_color
            if icon_color == blank
              assign icon_color = section.settings.accent_color
            endif
            assign icon_class = 'ca-icon-text__media ca-icon-text__media--' | append: block.id
          %}

          <article class="ca-icon-text__item" {{ block.shopify_attributes }}>
            <div class="ca-icon-text__icon-wrap" style="color: {{ icon_color }};">
              {% render 'icon-or-image',
                icon: block.settings.icon,
                image_upload: block.settings.image_upload,
                width: section.settings.icon_size,
                class_name: icon_class
              %}
            </div>

            <div class="ca-icon-text__content">
              {% if block.settings.title != blank %}
                <h3 class="ca-icon-text__title">{{ block.settings.title | escape }}</h3>
              {% endif %}

              {% if block.settings.description != blank %}
                <div class="ca-icon-text__body rte">
                  {{ block.settings.description }}
                </div>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .ca-icon-text {
    background: var(--ca-icon-background);
    color: var(--ca-icon-text);
  }

  .ca-icon-text__surface {
    width: 100%;
    background: var(--ca-icon-background);
  }

  .ca-icon-text__inner {
    padding-block: var(--ca-padding-top) var(--ca-padding-bottom);
  }

  .ca-icon-text__inner--page-width {
    width: var(--full-page-grid-central-column-width);
    margin-inline: auto;
  }

  .ca-icon-text__inner--full-width {
    width: 100%;
    padding-inline: max(var(--page-margin), 24px);
  }

  .ca-icon-text__intro {
    max-width: 820px;
    margin: 0 0 52px;
  }

  .ca-icon-text__eyebrow {
    margin: 0 0 12px;
    color: var(--ca-icon-accent);
    letter-spacing: .12em;
    text-transform: uppercase;
    font-size: var(--ca-eyebrow-size);
  }

  .ca-icon-text__heading {
    margin: 0 0 16px;
    color: inherit;
  }

  .ca-icon-text__description {
    font-size: var(--ca-body-size);
    line-height: 1.6;
    max-width: 760px;
    color: color-mix(in srgb, var(--ca-icon-text) 72%, transparent);
  }

  .ca-icon-text__description :is(p, ul, ol),
  .ca-icon-text__body :is(p, ul, ol) {
    font-size: inherit;
    line-height: inherit;
  }

  .ca-icon-text__description p,
  .ca-icon-text__body p {
    margin: 0;
  }

  .ca-icon-text__grid {
    display: grid;
    grid-template-columns: repeat(var(--ca-desktop-columns), minmax(0, 1fr));
    column-gap: var(--ca-column-gap);
  }

  .ca-icon-text__item {
    min-width: 0;
  }

  .ca-icon-text__media {
    display: block;
    width: var(--ca-icon-size);
    height: auto;
    max-width: var(--ca-icon-size);
    color: currentColor;
    object-fit: contain;
  }

  .ca-icon-text__icon-wrap {
    flex: 0 0 auto;
  }

  .ca-icon-text__title {
    margin: 0 0 8px;
    color: inherit;
    font-size: var(--ca-item-title-size);
    line-height: 1.25;
  }

  .ca-icon-text__body {
    color: color-mix(in srgb, var(--ca-icon-text) 68%, transparent);
  }

  .ca-icon-text--left .ca-icon-text__intro,
  .ca-icon-text--left .ca-icon-text__item {
    text-align: left;
  }

  .ca-icon-text--centered .ca-icon-text__intro {
    margin-inline: auto;
    text-align: center;
  }

  .ca-icon-text--centered .ca-icon-text__item {
    text-align: center;
  }

  .ca-icon-text--centered .ca-icon-text__icon-wrap {
    display: flex;
    justify-content: center;
  }

  .ca-icon-text--icon-top .ca-icon-text__item {
    display: block;
  }

  .ca-icon-text--icon-top .ca-icon-text__icon-wrap {
    margin-bottom: var(--ca-icon-gap);
  }

  .ca-icon-text--icon-left .ca-icon-text__item {
    display: grid;
    grid-template-columns: var(--ca-icon-size) minmax(0, 1fr);
    column-gap: var(--ca-icon-gap);
    align-items: start;
    text-align: left;
  }

  .ca-icon-text--icon-left .ca-icon-text__icon-wrap {
    justify-content: flex-start;
  }

  @media screen and (max-width: 749px) {
    .ca-icon-text__inner--full-width {
      padding-inline: 18px;
    }

    .ca-icon-text__intro {
      margin-bottom: 34px;
    }

    .ca-icon-text__grid {
      grid-template-columns: repeat(var(--ca-mobile-columns), minmax(0, 1fr));
      column-gap: 20px;
    }

    .ca-icon-text--centered .ca-icon-text__intro {
      text-align: center;
    }
  }
{% endstylesheet %}

