{% comment %}Generic icon with text capabilities section.{% endcomment %}
<section
  id="IconWithText-{{ section.id }}"
  class="section section--{{ section.settings.section_width | default: 'page-width' }} spacing-style ca-icon-text"
  style="
    --padding-block-start: {{ section.settings.padding_top }}px;
    --padding-block-end: {{ section.settings.padding_bottom }}px;
    --ca-icon-columns: {{ section.settings.desktop_columns }};
    --ca-icon-mobile-columns: {{ section.settings.mobile_columns }};
    --ca-icon-gap: {{ section.settings.gap }}px;
  "
>
  <div class="ca-icon-text__inner">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.description != blank %}
      <header class="ca-icon-text__intro">
        {% if section.settings.eyebrow != blank %}
          <p class="ca-icon-text__eyebrow {{ section.settings.eyebrow_preset | default: 'h5' }}">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="ca-icon-text__heading {{ section.settings.heading_preset | default: 'h2' }}">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="ca-icon-text__description rte {{ section.settings.body_preset | default: 'h5' }}">{{ section.settings.description }}</div>
        {% endif %}
      </header>
    {% endif %}

    <div class="ca-icon-text__grid">
      {% for block in section.blocks %}
        <article class="ca-icon-text__item" {{ block.shopify_attributes }}>
          <div class="ca-icon-text__icon" aria-hidden="true">
            {% if block.settings.icon_image != blank %}
              {{ block.settings.icon_image | image_url: width: 96 | image_tag: loading: 'lazy', class: 'ca-icon-text__icon-image', widths: '48,72,96', sizes: '48px' }}
            {% else %}
              <span class="ca-icon-text__fallback"></span>
            {% endif %}
          </div>
          {% if block.settings.title != blank %}
            <h3 class="ca-icon-text__title {{ section.settings.item_title_preset | default: 'h4' }}">{{ block.settings.title | escape }}</h3>
          {% endif %}
          {% if block.settings.description != blank %}
            <div class="ca-icon-text__body rte {{ section.settings.body_preset | default: 'h5' }}">{{ block.settings.description }}</div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .ca-icon-text__intro { max-width: 860px; margin: 0 auto 34px; text-align: center; }
  .ca-icon-text__eyebrow { margin: 0 0 10px; color: var(--color-accent, #C7A85E); letter-spacing: .14em; text-transform: uppercase; }
  .ca-icon-text__heading { margin: 0 0 14px; }
  .ca-icon-text__description :is(p,ul,ol),
  .ca-icon-text__body :is(p,ul,ol) { font-size: inherit; line-height: inherit; }
  .ca-icon-text__description p,
  .ca-icon-text__body p { margin: 0; }

  .ca-icon-text__grid {
    display: grid;
    grid-template-columns: repeat(var(--ca-icon-columns), minmax(0,1fr));
    gap: var(--ca-icon-gap);
  }
  .ca-icon-text__item {
    padding: 24px 20px;
    border-top: 1px solid rgb(var(--color-foreground-rgb) / .2);
  }
  .ca-icon-text__icon {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    margin-bottom: 18px;
    color: var(--color-accent, #C7A85E);
  }
  .ca-icon-text__icon-image { width: 100%; height: 100%; object-fit: contain; }
  .ca-icon-text__fallback {
    width: 22px;
    height: 22px;
    border: 1.5px solid currentColor;
    transform: rotate(45deg);
  }
  .ca-icon-text__title { margin: 0 0 10px; }
  .ca-icon-text__body { opacity: .76; }

  @media screen and (max-width: 749px) {
    .ca-icon-text__intro { text-align: left; margin-bottom: 24px; }
    .ca-icon-text__grid { grid-template-columns: repeat(var(--ca-icon-mobile-columns), minmax(0,1fr)); }
    .ca-icon-text__item { padding-inline: 0; }
  }
{% endstylesheet %}

