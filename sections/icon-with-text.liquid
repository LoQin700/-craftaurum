{% liquid
  assign content_width = section.settings.section_width
  assign desktop_columns = section.settings.desktop_columns
  assign mobile_columns = section.settings.mobile_columns
%}

<section
  id="IconWithText-{{ section.id }}"
  class="ca-icon-text section section--{{ content_width }}"
  style="
    --ca-icon-background: {{ section.settings.background_color }};
    --ca-icon-text: {{ section.settings.text_color }};
    --ca-icon-accent: {{ section.settings.accent_color }};
    --ca-icon-desktop-columns: {{ desktop_columns }};
    --ca-icon-mobile-columns: {{ mobile_columns }};
    --ca-icon-gap: {{ section.settings.gap }}px;
    --ca-icon-padding-top: {{ section.settings.padding_top }}px;
    --ca-icon-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="ca-icon-text__surface">
    <div class="ca-icon-text__inner">
      <div class="ca-icon-text__intro">
        {% if section.settings.eyebrow != blank %}
          <p class="ca-icon-text__eyebrow {{ section.settings.eyebrow_preset }}">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="ca-icon-text__heading {{ section.settings.heading_preset }}">{{ section.settings.heading | escape }}</h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="ca-icon-text__description rte {{ section.settings.body_preset }}">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </div>

      <div class="ca-icon-text__grid">
        {% for block in section.blocks %}
          <article class="ca-icon-text__item" {{ block.shopify_attributes }}>
            <div class="ca-icon-text__icon" aria-hidden="true">
              {% if block.settings.icon_image != blank %}
                {{
                  block.settings.icon_image
                  | image_url: width: 120
                  | image_tag:
                    loading: 'lazy',
                    class: 'ca-icon-text__icon-image',
                    widths: '48,72,96,120',
                    sizes: '48px'
                }}
              {% else %}
                <span class="ca-icon-text__fallback"></span>
              {% endif %}
            </div>

            {% if block.settings.title != blank %}
              <h3 class="ca-icon-text__title {{ section.settings.item_title_preset }}">{{ block.settings.title | escape }}</h3>
            {% endif %}

            {% if block.settings.description != blank %}
              <div class="ca-icon-text__body rte {{ section.settings.body_preset }}">
                {{ block.settings.description }}
              </div>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .ca-icon-text {
    background: var(--ca-icon-background);
    color: var(--ca-icon-text);
  }

  .ca-icon-text__surface {
    width: 100%;
    background: var(--ca-icon-background);
  }

  .ca-icon-text__inner {
    padding-block: var(--ca-icon-padding-top) var(--ca-icon-padding-bottom);
  }

  .ca-icon-text__intro {
    max-width: 900px;
    margin: 0 auto 34px;
    text-align: center;
  }

  .ca-icon-text__eyebrow {
    margin: 0 0 10px;
    color: var(--ca-icon-accent);
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .ca-icon-text__heading {
    margin: 0 0 14px;
    color: inherit;
  }

  .ca-icon-text__description :is(p, ul, ol),
  .ca-icon-text__body :is(p, ul, ol) {
    font-size: inherit;
    line-height: inherit;
  }

  .ca-icon-text__description p,
  .ca-icon-text__body p {
    margin: 0;
  }

  .ca-icon-text__grid {
    display: grid;
    grid-template-columns: repeat(var(--ca-icon-desktop-columns), minmax(0, 1fr));
    gap: var(--ca-icon-gap);
  }

  .ca-icon-text__item {
    padding: 26px 20px;
    border-top: 1px solid rgb(var(--color-foreground-rgb) / .18);
  }

  .ca-icon-text__icon {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    margin-bottom: 18px;
    color: var(--ca-icon-accent);
  }

  .ca-icon-text__icon-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ca-icon-text__fallback {
    display: block;
    width: 22px;
    height: 22px;
    border: 1.5px solid currentColor;
    transform: rotate(45deg);
  }

  .ca-icon-text__title {
    margin: 0 0 10px;
    color: inherit;
  }

  .ca-icon-text__body {
    opacity: .76;
  }

  @media screen and (max-width: 749px) {
    .ca-icon-text__intro {
      text-align: left;
      margin-bottom: 24px;
    }

    .ca-icon-text__grid {
      grid-template-columns: repeat(var(--ca-icon-mobile-columns), minmax(0, 1fr));
    }

    .ca-icon-text__item {
      padding-inline: 0;
    }
  }
{% endstylesheet %}

