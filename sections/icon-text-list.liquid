{% comment %}
  Generic icon-with-text capability section.
  Designed for factory-wide strengths that remain useful across product category pages.
{% endcomment %}
<section
  id="IconTextList-{{ section.id }}"
  class="section section--{{ section.settings.section_width | default: 'page-width' }} spacing-style ca-icon-text"
  style="
    --padding-block-start: {{ section.settings.padding_top }}px;
    --padding-block-end: {{ section.settings.padding_bottom }}px;
    --ca-icon-columns: {{ section.settings.desktop_columns }};
    --ca-icon-mobile-columns: {{ section.settings.mobile_columns }};
    --ca-icon-gap: {{ section.settings.gap }}px;
    --ca-icon-eyebrow-size: {{ section.settings.eyebrow_size | default: 12 }}px;
    --ca-icon-heading-size: {{ section.settings.heading_size | default: 35 }}px;
    --ca-icon-body-size: {{ section.settings.body_size | default: 15 }}px;
    --ca-icon-item-title-size: {{ section.settings.item_title_size | default: 18 }}px;
  "
>
  <div class="ca-icon-text__inner" data-ca-reveal="{{ section.settings.animation_style | default: 'fade-up' }}">
    <header class="ca-icon-text__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="ca-icon-text__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="ca-icon-text__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <div class="ca-icon-text__description rte">{{ section.settings.description }}</div>
      {% endif %}
    </header>

    <div class="ca-icon-text__grid">
      {% for block in section.blocks %}
        <article class="ca-icon-text__item" {{ block.shopify_attributes }}>
          <div class="ca-icon-text__icon" aria-hidden="true">
            {% if block.settings.icon_image != blank %}
              {{ block.settings.icon_image | image_url: width: 120 | image_tag: loading: 'lazy', class: 'ca-icon-text__icon-image', widths: '48, 72, 96, 120', sizes: '48px' }}
            {% else %}
              {% case block.settings.icon %}
                {% when 'design' %}
                  <svg viewBox="0 0 32 32"><path d="M6 24 23 7l2 2L8 26H6v-2Z"/><path d="m20 10 2 2M7 21l4 4"/></svg>
                {% when 'sample' %}
                  <svg viewBox="0 0 32 32"><path d="M7 8h18v16H7z"/><path d="M11 13h10M11 17h7M11 21h5"/></svg>
                {% when 'finish' %}
                  <svg viewBox="0 0 32 32"><path d="M16 5 6 10v12l10 5 10-5V10L16 5Z"/><path d="m6 10 10 5 10-5M16 15v12"/></svg>
                {% when 'quality' %}
                  <svg viewBox="0 0 32 32"><path d="M16 5 7 8v7c0 6 3.7 10.1 9 12 5.3-1.9 9-6 9-12V8l-9-3Z"/><path d="m12 16 3 3 6-7"/></svg>
                {% when 'material' %}
                  <svg viewBox="0 0 32 32"><path d="m16 5 8 7-8 15-8-15 8-7Z"/><path d="M8 12h16M12 12l4 15 4-15M12 12l4-7 4 7"/></svg>
                {% else %}
                  <svg viewBox="0 0 32 32"><circle cx="16" cy="16" r="10"/><path d="M11 16h10M16 11v10"/></svg>
              {% endcase %}
            {% endif %}
          </div>
          {% if block.settings.title != blank %}
            <h3 class="ca-icon-text__title">{{ block.settings.title | escape }}</h3>
          {% endif %}
          {% if block.settings.description != blank %}
            <div class="ca-icon-text__body rte">{{ block.settings.description }}</div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .ca-icon-text__intro { text-align: center; max-width: 860px; margin: 0 auto 36px; }
  .ca-icon-text__eyebrow { margin: 0 0 10px; color: var(--color-accent, #C7A85E); letter-spacing: .14em; text-transform: uppercase; }
  .ca-icon-text__heading { margin: 0 0 14px; font-size: var(--ca-icon-heading-size); line-height: 1.08; }
  .ca-icon-text__description :is(p,ul,ol),
  .ca-icon-text__eyebrow { font-size: var(--ca-icon-eyebrow-size); }
  .ca-icon-text__description { font-size: var(--ca-icon-body-size); line-height: 1.6; }
  .ca-icon-text__body { font-size: var(--ca-icon-body-size); line-height: 1.6; }
  .ca-icon-text__body :is(p,ul,ol) { font-size: inherit; line-height: inherit; }
  .ca-icon-text__description p,
  .ca-icon-text__body p { margin: 0; }
  .ca-icon-text__grid {
    display: grid;
    grid-template-columns: repeat(var(--ca-icon-columns), minmax(0,1fr));
    gap: var(--ca-icon-gap);
  }
  .ca-icon-text__item {
    min-width: 0;
    padding: 26px 24px;
    border-top: 1px solid rgb(var(--color-foreground-rgb) / .22);
    background: transparent;
  }
  .ca-icon-text__icon {
    width: 38px;
    height: 38px;
    margin-bottom: 20px;
    color: var(--color-accent, #C7A85E);
  }
  .ca-icon-text__icon svg,
  .ca-icon-text__icon-image {
    display: block; width: 100%; height: 100%;
  }
  .ca-icon-text__icon svg { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .ca-icon-text__icon-image { object-fit: contain; }
  .ca-icon-text__title { margin: 0 0 10px; font-size: var(--ca-icon-item-title-size); line-height: 1.25; }
  .ca-icon-text__body { opacity: .76; }

  @media screen and (max-width: 749px) {
    .ca-icon-text__intro { text-align: left; margin-bottom: 24px; }
    .ca-icon-text__grid { grid-template-columns: repeat(var(--ca-icon-mobile-columns), minmax(0,1fr)); }
    .ca-icon-text__item { padding: 22px 12px 22px 0; }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "旧版图标文字",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "内容宽度",
      "options": [
        {
          "value": "page-width",
          "label": "页面宽度"
        },
        {
          "value": "full-width",
          "label": "全宽"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "小标题",
      "default": "MANUFACTURING SUPPORT"
    },
    {"type":"range","id":"eyebrow_size","label":"小标题字号","min":10,"max":20,"step":1,"unit":"px","default":12},
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Capabilities That Support Every Collection"
    },
    {"type":"range","id":"heading_size","label":"标题字号","min":24,"max":72,"step":1,"unit":"px","default":35},
    {
      "type": "richtext",
      "id": "description",
      "label": "正文",
      "default": "<p>A consistent development process helps move ideas from design direction to sample review and production planning.</p>"
    },
    {"type":"range","id":"body_size","label":"正文字号","min":12,"max":22,"step":1,"unit":"px","default":15},
    {"type":"range","id":"item_title_size","label":"项目标题字号","min":14,"max":30,"step":1,"unit":"px","default":18},
    {"type":"select","id":"animation_style","label":"入场动画","options":[{"value":"fade-up","label":"Fade Up"},{"value":"fade-in","label":"Fade In"},{"value":"soft-zoom","label":"Soft Zoom"}],"default":"fade-up"},
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "桌面端每行数量",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "手机端每行数量",
      "options": [
        {
          "value": "1",
          "label": "1 列"
        },
        {
          "value": "2",
          "label": "2 列"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "间距",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "上边距",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下边距",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "项目",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "图标",
          "options": [
            {
              "value": "design",
              "label": "设计"
            },
            {
              "value": "material",
              "label": "材料"
            },
            {
              "value": "sample",
              "label": "打样"
            },
            {
              "value": "finish",
              "label": "工艺"
            },
            {
              "value": "quality",
              "label": "质检"
            },
            {
              "value": "plus",
              "label": "通用"
            }
          ],
          "default": "design"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "自定义图标"
        },
        {
          "type": "text",
          "id": "title",
          "label": "标题",
          "default": "Design Development"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "正文",
          "default": "<p>Turn references and specifications into a clearer development direction for sampling.</p>"
        }
      ]
    }
  ]
}
{% endschema %}
