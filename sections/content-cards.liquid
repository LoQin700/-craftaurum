    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "小标题字号",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "标题字号",
      "min": 24,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 35
    },
    {
      "type": "range",
