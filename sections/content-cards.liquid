{% liquid
  assign content_width = section.settings.section_width | default: 'page-width'
  assign background_color = section.settings.background_color | default: '#FFFFFF'
  assign text_color = section.settings.text_color | default: '#17191A'
  assign accent_color = section.settings.accent_color | default: '#C7A85E'
  assign desktop_columns = section.settings.desktop_columns | default: 4
  assign mobile_columns = section.settings.mobile_columns | default: 1
  assign gap = section.settings.gap | default: 18
  assign padding_top = section.settings.padding_top | default: 56
  assign padding_bottom = section.settings.padding_bottom | default: 56
  assign ratio = '4 / 5'
  if section.settings.image_ratio == 'square'
    assign ratio = '1 / 1'
  elsif section.settings.image_ratio == 'landscape'
    assign ratio = '4 / 3'
  endif
%}
<section id="ContentCards-{{ section.id }}" class="section section--full-width ca-content-cards"
  style="--ca-cc-bg:{{ background_color }};--ca-cc-text:{{ text_color }};--ca-cc-accent:{{ accent_color }};--ca-cc-desktop:{{ desktop_columns }};--ca-cc-mobile:{{ mobile_columns }};--ca-cc-gap:{{ gap }}px;--ca-cc-ratio:{{ ratio }};--ca-cc-pt:{{ padding_top }}px;--ca-cc-pb:{{ padding_bottom }}px;">
  <div class="ca-content-cards__surface">
    <div class="ca-content-cards__inner ca-content-cards__inner--{{ content_width }}{% if section.settings.desktop_layout == 'carousel' %} is-desktop-carousel{% endif %}{% if section.settings.mobile_layout == 'carousel' %} is-mobile-carousel{% endif %}">
      <header class="ca-content-cards__intro">
        {% if section.settings.eyebrow != blank %}<p class="ca-content-cards__eyebrow {{ section.settings.eyebrow_preset | default:'h5' }}">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        {% if section.settings.heading != blank %}<h2 class="ca-content-cards__heading {{ section.settings.heading_preset | default:'h2' }}">{{ section.settings.heading | escape }}</h2>{% endif %}
        {% if section.settings.description != blank %}<div class="ca-content-cards__description rte {{ section.settings.body_preset | default:'h5' }}">{{ section.settings.description }}</div>{% endif %}
      </header>
      <div class="ca-content-cards__grid">
        {% for block in section.blocks %}
          <article class="ca-content-card" {{ block.shopify_attributes }}>
            <div class="ca-content-card__media">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 1400 | image_tag: loading:'lazy', class:'ca-content-card__image ca-content-card__image--primary', widths:'240,360,520,720,960,1200,1400', sizes:'(min-width: 990px) 25vw, 80vw' }}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'ca-content-card__placeholder' }}
              {% endif %}
              {% if block.settings.hover_image != blank %}
                {{ block.settings.hover_image | image_url: width: 1400 | image_tag: loading:'lazy', class:'ca-content-card__image ca-content-card__image--hover', widths:'240,360,520,720,960,1200,1400', sizes:'(min-width: 990px) 25vw, 80vw' }}
              {% endif %}
            </div>
            <div class="ca-content-card__content">
              {% if block.settings.title != blank %}<h3 class="ca-content-card__title {{ section.settings.card_title_preset | default:'h3' }}">{{ block.settings.title | escape }}</h3>{% endif %}
              {% if block.settings.description != blank %}<div class="ca-content-card__text rte {{ section.settings.body_preset | default:'h5' }}">{{ block.settings.description }}</div>{% endif %}
              {% if block.settings.button_label != blank %}
                <div class="ca-content-card__action">
                  {% render 'craftaurum-cta', label:block.settings.button_label, link:block.settings.link, style_class:block.settings.button_style, static_label:true %}
                </div>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% stylesheet %}
  .ca-content-cards__surface{width:100%;background:var(--ca-cc-bg);color:var(--ca-cc-text)}
  .ca-content-cards__inner{padding-block:var(--ca-cc-pt) var(--ca-cc-pb)}
  .ca-content-cards__inner--page-width{width:var(--full-page-grid-central-column-width);margin-inline:auto}
  .ca-content-cards__inner--full-width{width:100%;padding-inline:max(var(--page-margin),24px)}
  .ca-content-cards__intro{max-width:960px;margin:0 auto 36px;text-align:center}
  .ca-content-cards__eyebrow{margin:0 0 10px;color:var(--ca-cc-accent);letter-spacing:.14em;text-transform:uppercase}
  .ca-content-cards__heading{margin:0 0 14px;color:inherit}
  .ca-content-cards__description :is(p,ul,ol),.ca-content-card__text :is(p,ul,ol){font-size:inherit;line-height:inherit}
  .ca-content-cards__description p,.ca-content-card__text p{margin:0}
  .ca-content-cards__grid{display:grid;grid-template-columns:repeat(var(--ca-cc-desktop),minmax(0,1fr));gap:var(--ca-cc-gap)}
  .ca-content-card__media{position:relative;aspect-ratio:var(--ca-cc-ratio);overflow:hidden;background:rgb(var(--color-foreground-rgb)/.04)}
  .ca-content-card__image,.ca-content-card__placeholder{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:opacity .35s ease,transform .35s ease}
  .ca-content-card__image--hover{opacity:0;transform:scale(1.025)}
  .ca-content-card__content{padding-top:14px}
  .ca-content-card__title{margin:0 0 8px;color:inherit}
  .ca-content-card__action{margin-top:14px}
  .ca-content-cards__inner.is-desktop-carousel .ca-content-cards__grid{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}
  .ca-content-cards__inner.is-desktop-carousel .ca-content-card{flex:0 0 calc((100% - (var(--ca-cc-desktop) - 1)*var(--ca-cc-gap))/var(--ca-cc-desktop));scroll-snap-align:start}
  @media(hover:hover){
    .ca-content-card:hover .ca-content-card__image--primary{opacity:0;transform:scale(1.025)}
    .ca-content-card:hover .ca-content-card__image--hover{opacity:1;transform:scale(1)}
    .ca-content-card:not(:has(.ca-content-card__image--hover)):hover .ca-content-card__image--primary{opacity:1;transform:scale(1.035)}
  }
  @media(max-width:749px){
    .ca-content-cards__inner--full-width{padding-inline:18px}
    .ca-content-cards__intro{text-align:left;margin-bottom:24px}
    .ca-content-cards__grid{grid-template-columns:repeat(var(--ca-cc-mobile),minmax(0,1fr))}
    .ca-content-cards__inner.is-desktop-carousel:not(.is-mobile-carousel) .ca-content-cards__grid{display:grid;overflow:visible}
    .ca-content-cards__inner.is-mobile-carousel .ca-content-cards__grid{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}
    .ca-content-cards__inner.is-mobile-carousel .ca-content-card{flex:0 0 calc((100% - (var(--ca-cc-mobile) - 1)*var(--ca-cc-gap))/var(--ca-cc-mobile));scroll-snap-align:start}
  }
{% endstylesheet %}
