{% liquid
  assign content_width = section.settings.section_width
  assign desktop_columns = section.settings.desktop_columns
  assign mobile_columns = section.settings.mobile_columns
  assign ratio = '4 / 5'

  if section.settings.image_ratio == 'square'
    assign ratio = '1 / 1'
  elsif section.settings.image_ratio == 'landscape'
    assign ratio = '4 / 3'
  endif
%}

<section
  id="ContentCards-{{ section.id }}"
  class="ca-content-cards section section--{{ content_width }}"
  style="
    --ca-cards-background: {{ section.settings.background_color }};
    --ca-cards-text: {{ section.settings.text_color }};
    --ca-cards-accent: {{ section.settings.accent_color }};
    --ca-cards-desktop-columns: {{ desktop_columns }};
    --ca-cards-mobile-columns: {{ mobile_columns }};
    --ca-cards-gap: {{ section.settings.gap }}px;
    --ca-cards-ratio: {{ ratio }};
    --ca-cards-padding-top: {{ section.settings.padding_top }}px;
    --ca-cards-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="ca-content-cards__surface">
    <div class="ca-content-cards__inner">
      <div class="ca-content-cards__intro">
        {% if section.settings.eyebrow != blank %}
          <p class="ca-content-cards__eyebrow {{ section.settings.eyebrow_preset }}">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="ca-content-cards__heading {{ section.settings.heading_preset }}">{{ section.settings.heading | escape }}</h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="ca-content-cards__description rte {{ section.settings.body_preset }}">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </div>

      <div class="ca-content-cards__grid{% if section.settings.desktop_layout == 'carousel' %} ca-content-cards__grid--desktop-carousel{% endif %}{% if section.settings.mobile_layout == 'carousel' %} ca-content-cards__grid--mobile-carousel{% endif %}">
        {% for block in section.blocks %}
          <article class="ca-content-card" {{ block.shopify_attributes }}>
            <div class="ca-content-card__media">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 1400
                  | image_tag:
                    loading: 'lazy',
                    class: 'ca-content-card__image ca-content-card__image--primary',
                    widths: '240,360,520,720,960,1200,1400',
                    sizes: '(min-width: 990px) 25vw, 80vw'
                }}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'ca-content-card__placeholder' }}
              {% endif %}

              {% if block.settings.hover_image != blank %}
                {{
                  block.settings.hover_image
                  | image_url: width: 1400
                  | image_tag:
                    loading: 'lazy',
                    class: 'ca-content-card__image ca-content-card__image--hover',
                    widths: '240,360,520,720,960,1200,1400',
                    sizes: '(min-width: 990px) 25vw, 80vw'
                }}
              {% endif %}
            </div>

            <div class="ca-content-card__content">
              {% if block.settings.title != blank %}
                <h3 class="ca-content-card__title {{ section.settings.card_title_preset }}">{{ block.settings.title | escape }}</h3>
              {% endif %}

              {% if block.settings.description != blank %}
                <div class="ca-content-card__text rte {{ section.settings.body_preset }}">
                  {{ block.settings.description }}
                </div>
              {% endif %}

              {% if block.settings.button_label != blank %}
                <div class="ca-content-card__action">
                  {% render 'craftaurum-cta',
                    label: block.settings.button_label,
                    link: block.settings.link,
                    style_class: block.settings.button_style,
                    static_label: true
                  %}
                </div>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .ca-content-cards {
    background: var(--ca-cards-background);
    color: var(--ca-cards-text);
  }

  .ca-content-cards__surface {
    width: 100%;
    background: var(--ca-cards-background);
  }

  .ca-content-cards__inner {
    padding-block: var(--ca-cards-padding-top) var(--ca-cards-padding-bottom);
  }

  .ca-content-cards__intro {
    max-width: 960px;
    margin: 0 auto 36px;
    text-align: center;
  }

  .ca-content-cards__eyebrow {
    margin: 0 0 10px;
    color: var(--ca-cards-accent);
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .ca-content-cards__heading {
    margin: 0 0 14px;
    color: inherit;
  }

  .ca-content-cards__description :is(p, ul, ol),
  .ca-content-card__text :is(p, ul, ol) {
    font-size: inherit;
    line-height: inherit;
  }

  .ca-content-cards__description p,
  .ca-content-card__text p {
    margin: 0;
  }

  .ca-content-cards__grid {
    display: grid;
    grid-template-columns: repeat(var(--ca-cards-desktop-columns), minmax(0, 1fr));
    gap: var(--ca-cards-gap);
  }

  .ca-content-card__media {
    position: relative;
    aspect-ratio: var(--ca-cards-ratio);
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb) / .04);
  }

  .ca-content-card__image,
  .ca-content-card__placeholder {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity .35s ease, transform .35s ease;
  }

  .ca-content-card__image--hover {
    opacity: 0;
    transform: scale(1.025);
  }

  .ca-content-card__content {
    padding-top: 14px;
  }

  .ca-content-card__title {
    margin: 0 0 8px;
    color: inherit;
  }

  .ca-content-card__action {
    margin-top: 14px;
  }

  .ca-content-cards__grid--desktop-carousel {
    display: flex;
    overflow-x: auto;
    gap: var(--ca-cards-gap);
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .ca-content-cards__grid--desktop-carousel .ca-content-card {
    flex: 0 0 calc((100% - (var(--ca-cards-desktop-columns) - 1) * var(--ca-cards-gap)) / var(--ca-cards-desktop-columns));
    scroll-snap-align: start;
  }

  @media (hover: hover) {
    .ca-content-card:hover .ca-content-card__image--primary {
      opacity: 0;
      transform: scale(1.025);
    }

    .ca-content-card:hover .ca-content-card__image--hover {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media screen and (max-width: 749px) {
    .ca-content-cards__intro {
      text-align: left;
      margin-bottom: 24px;
    }

    .ca-content-cards__grid {
      grid-template-columns: repeat(var(--ca-cards-mobile-columns), minmax(0, 1fr));
    }

    .ca-content-cards__grid--desktop-carousel:not(.ca-content-cards__grid--mobile-carousel) {
      display: grid;
      overflow: visible;
    }

    .ca-content-cards__grid--mobile-carousel {
      display: flex;
      overflow-x: auto;
      gap: var(--ca-cards-gap);
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .ca-content-cards__grid--mobile-carousel .ca-content-card {
      flex: 0 0 calc((100% - (var(--ca-cards-mobile-columns) - 1) * var(--ca-cards-gap)) / var(--ca-cards-mobile-columns));
      scroll-snap-align: start;
    }
  }
{% endstylesheet %}

