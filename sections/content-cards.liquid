{% comment %}
  Generic content cards section.
  Conservative implementation for Shopify section picker compatibility.
{% endcomment %}
<section
  id="ContentCards-{{ section.id }}"
  class="section section--{{ section.settings.section_width | default: 'page-width' }} spacing-style ca-content-cards"
  style="
    --padding-block-start: {{ section.settings.padding_top }}px;
    --padding-block-end: {{ section.settings.padding_bottom }}px;
    --ca-cards-gap: {{ section.settings.gap }}px;
    --ca-cards-desktop: {{ section.settings.desktop_columns }};
    --ca-cards-mobile: {{ section.settings.mobile_columns }};
  "
>
  <div class="ca-content-cards__inner">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.description != blank %}
      <header class="ca-content-cards__intro">
        {% if section.settings.eyebrow != blank %}
          <p class="ca-content-cards__eyebrow {{ section.settings.eyebrow_preset | default: 'h5' }}">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="ca-content-cards__heading {{ section.settings.heading_preset | default: 'h2' }}">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="ca-content-cards__description rte {{ section.settings.body_preset | default: 'h5' }}">{{ section.settings.description }}</div>
        {% endif %}
      </header>
    {% endif %}

    {% if section.settings.mobile_layout == 'carousel' %}
      {% capture mobile_slides %}
        {% for block in section.blocks %}
          {% capture card_content %}
            <article class="ca-content-card">
              <div class="ca-content-card__media">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'ca-content-card__image ca-content-card__image--primary', widths: '240,360,520,720,960,1200', sizes: '90vw' }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'ca-content-card__placeholder' }}
                {% endif %}
                {% if block.settings.hover_image != blank %}
                  {{ block.settings.hover_image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'ca-content-card__image ca-content-card__image--hover', widths: '240,360,520,720,960,1200', sizes: '90vw' }}
                {% endif %}
              </div>
              <div class="ca-content-card__content">
                {% if block.settings.title != blank %}
                  <h3 class="ca-content-card__title {{ section.settings.card_title_preset | default: 'h3' }}">{{ block.settings.title | escape }}</h3>
                {% endif %}
                {% if block.settings.description != blank %}
                  <div class="ca-content-card__text rte {{ section.settings.body_preset | default: 'h5' }}">{{ block.settings.description }}</div>
                {% endif %}
                {% if block.settings.button_label != blank %}
                  <div class="ca-content-card__action">
                    {% render 'craftaurum-cta',
                      label: block.settings.button_label,
                      link: block.settings.link,
                      style_class: block.settings.button_style,
                      static_label: true
                    %}
                  </div>
                {% endif %}
              </div>
            </article>
          {% endcapture %}
          {% render 'slideshow-slide', index: forloop.index0, children: card_content, class: 'ca-content-cards__slide' %}
        {% endfor %}
      {% endcapture %}
    {% endif %}

    <div class="ca-content-cards__grid">
      {% for block in section.blocks %}
        <article class="ca-content-card" {{ block.shopify_attributes }}>
          <div class="ca-content-card__media">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'ca-content-card__image ca-content-card__image--primary', widths: '240,360,520,720,960,1200', sizes: '(min-width: 750px) 25vw, 50vw' }}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'ca-content-card__placeholder' }}
            {% endif %}
            {% if block.settings.hover_image != blank %}
              {{ block.settings.hover_image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'ca-content-card__image ca-content-card__image--hover', widths: '240,360,520,720,960,1200', sizes: '(min-width: 750px) 25vw, 50vw' }}
            {% endif %}
          </div>
          <div class="ca-content-card__content">
            {% if block.settings.title != blank %}
              <h3 class="ca-content-card__title {{ section.settings.card_title_preset | default: 'h3' }}">{{ block.settings.title | escape }}</h3>
            {% endif %}
            {% if block.settings.description != blank %}
              <div class="ca-content-card__text rte {{ section.settings.body_preset | default: 'h5' }}">{{ block.settings.description }}</div>
            {% endif %}
            {% if block.settings.button_label != blank %}
              <div class="ca-content-card__action">
                {% render 'craftaurum-cta',
                  label: block.settings.button_label,
                  link: block.settings.link,
                  style_class: block.settings.button_style,
                  static_label: true
                %}
              </div>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>

    {% if section.settings.mobile_layout == 'carousel' and section.blocks.size > 0 %}
      {% assign can_scroll = false %}
      {% if section.blocks.size > 1 %}{% assign can_scroll = true %}{% endif %}
      <div class="ca-content-cards__mobile-carousel">
        {% render 'slideshow',
          class: 'ca-content-cards__slideshow',
          slides: mobile_slides,
          slide_count: section.blocks.size,
          show_arrows: can_scroll,
          infinite: false,
          icon_style: 'chevron',
          icon_shape: 'none'
        %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .ca-content-cards__intro { max-width: 980px; margin: 0 auto 32px; text-align: center; }
  .ca-content-cards__eyebrow { margin: 0 0 10px; color: var(--color-accent, #C7A85E); letter-spacing: .14em; text-transform: uppercase; }
  .ca-content-cards__heading { margin: 0 0 14px; }
  .ca-content-cards__description :is(p,ul,ol),
  .ca-content-card__text :is(p,ul,ol) { font-size: inherit; line-height: inherit; }
  .ca-content-cards__description p,
  .ca-content-card__text p { margin: 0; }

  .ca-content-cards__grid {
    display: grid;
    grid-template-columns: repeat(var(--ca-cards-desktop), minmax(0,1fr));
    gap: var(--ca-cards-gap);
  }
  .ca-content-card__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb) / .04);
  }
  .ca-content-card__image,
  .ca-content-card__placeholder {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity .35s ease, transform .35s ease;
  }
  .ca-content-card__image--hover { opacity: 0; }
  .ca-content-card__content { padding-top: 14px; }
  .ca-content-card__title { margin: 0 0 8px; }
  .ca-content-card__action { margin-top: 14px; }
  .ca-content-cards__mobile-carousel { display: none; }

  @media (hover:hover) {
    .ca-content-card:hover .ca-content-card__image--primary { opacity: 0; transform: scale(1.02); }
    .ca-content-card:hover .ca-content-card__image--hover { opacity: 1; transform: scale(1.02); }
  }

  @media screen and (max-width: 749px) {
    .ca-content-cards__grid { grid-template-columns: repeat(var(--ca-cards-mobile), minmax(0,1fr)); }
    .ca-content-cards__mobile-carousel { display: none; }
    .ca-content-cards__mobile-carousel slideshow-slides { gap: var(--ca-cards-gap); }
    .ca-content-cards__mobile-carousel slideshow-slide {
      width: calc((100% - (var(--ca-cards-mobile) - 1) * var(--ca-cards-gap)) / var(--ca-cards-mobile));
      flex: 0 0 calc((100% - (var(--ca-cards-mobile) - 1) * var(--ca-cards-gap)) / var(--ca-cards-mobile));
      min-width: 0;
    }
    .ca-content-cards:has(.ca-content-cards__mobile-carousel) .ca-content-cards__grid { display: none; }
    .ca-content-cards:has(.ca-content-cards__mobile-carousel) .ca-content-cards__mobile-carousel { display: block; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ca-content-card__image { transition: none; }
  }
{% endstylesheet %}

