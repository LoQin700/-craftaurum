      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景颜色",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文字颜色",
      "default": "#17191A"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "小标题颜色",
      "default": "#C7A85E"
    },
    {
      "type": "select",
      "id": "intro_style",
      "label": "顶部布局",
      "options": [
        { "value": "style_1", "label": "Style 1" },
        { "value": "style_2", "label": "Style 2" }
