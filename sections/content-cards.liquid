{% liquid
  assign content_width = section.settings.section_width
  assign desktop_columns = section.settings.desktop_columns
  assign mobile_columns = section.settings.mobile_columns
  assign card_text_alignment = section.settings.card_text_alignment | default: 'left'
  assign card_action_alignment = 'flex-start'
  if card_text_alignment == 'center'
    assign card_action_alignment = 'center'
  endif
  assign ratio = '4 / 5'

  if section.settings.image_ratio == 'square'
    assign ratio = '1 / 1'
  elsif section.settings.image_ratio == 'landscape'
    assign ratio = '4 / 3'
  endif
%}

<section
  id="ContentCards-{{ section.id }}"
  class="ca-content-cards section section--{{ content_width }}"
  style="
    --ca-cards-background: {{ section.settings.background_color }};
    --ca-cards-text: {{ section.settings.text_color }};
    --ca-cards-accent: {{ section.settings.accent_color }};
    --ca-cards-desktop-columns: {{ desktop_columns }};
    --ca-cards-mobile-columns: {{ mobile_columns }};
    --ca-cards-gap: {{ section.settings.gap }}px;
    --ca-cards-row-gap: {{ section.settings.row_gap | default: 36 }}px;
    --ca-cards-ratio: {{ ratio }};
    --ca-cards-image-width: {{ section.settings.image_width | default: 100 }}%;
    --ca-cards-card-align: {{ card_text_alignment }};
    --ca-cards-card-action-align: {{ card_action_alignment }};
    --ca-cards-padding-top: {{ section.settings.padding_top }}px;
    --ca-cards-padding-bottom: {{ section.settings.padding_bottom }}px;
    --ca-cards-divider: {{ section.settings.divider_color | default: '#D8D5CE' }};
    --ca-cards-eyebrow-size: {{ section.settings.eyebrow_size | default: 12 }}px;
    --ca-cards-heading-size: {{ section.settings.heading_size | default: 35 }}px;
    --ca-cards-body-size: {{ section.settings.body_size | default: 16 }}px;
    --ca-cards-card-title-size: {{ section.settings.card_title_size | default: 18 }}px;
    --ca-cards-card-body-size: {{ section.settings.card_body_size | default: 15 }}px;
  "
>
  <div class="ca-content-cards__surface">
    <div class="ca-content-cards__inner" data-ca-reveal="{{ section.settings.animation_style | default: 'fade-up' }}">
      <div class="ca-content-cards__intro ca-content-cards__intro--{{ section.settings.intro_style | default: 'style_1' }}{% if section.settings.show_divider %} ca-content-cards__intro--divider{% endif %}">
        <div class="ca-content-cards__intro-title">
          {% if section.settings.eyebrow != blank %}
            <p class="ca-content-cards__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {% endif %}
          {% if section.settings.heading != blank %}
            <h2 class="ca-content-cards__heading">{{ section.settings.heading | escape }}</h2>
          {% endif %}
        </div>

        <div class="ca-content-cards__intro-copy">
          {% if section.settings.description != blank %}
            <div class="ca-content-cards__description rte">
              {{ section.settings.description }}
            </div>
          {% endif %}

          {% if section.settings.intro_button_label != blank %}
            <div class="ca-content-cards__intro-action">
              {% render 'craftaurum-cta',
                label: section.settings.intro_button_label,
                link: section.settings.intro_button_link,
                style_class: section.settings.intro_button_style,
                static_label: true
              %}
            </div>
          {% endif %}
        </div>
      </div>

      <div class="ca-content-cards__grid{% if section.settings.desktop_layout == 'carousel' %} ca-content-cards__grid--desktop-carousel{% endif %}{% if section.settings.mobile_layout == 'carousel' %} ca-content-cards__grid--mobile-carousel{% endif %}">
        {% for block in section.blocks %}
          <article class="ca-content-card" {{ block.shopify_attributes }}>
            <div class="ca-content-card__media">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 1400
                  | image_tag:
                    loading: 'lazy',
                    class: 'ca-content-card__image',
                    widths: '240,360,520,720,960,1200,1400',
                    sizes: '(min-width: 990px) 25vw, 80vw'
                }}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'ca-content-card__placeholder' }}
              {% endif %}
            </div>

            <div class="ca-content-card__content">
              {% if block.settings.title != blank %}
                <h3 class="ca-content-card__title">{{ block.settings.title | escape }}</h3>
              {% endif %}

              {% if block.settings.description != blank %}
                <div class="ca-content-card__text rte">
                  {{ block.settings.description }}
                </div>
              {% endif %}

              {% if block.settings.button_label != blank %}
                <div class="ca-content-card__action">
                  {% render 'craftaurum-cta',
                    label: block.settings.button_label,
                    link: block.settings.link,
                    style_class: block.settings.button_style,
                    static_label: true
                  %}
                </div>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .ca-content-cards {
    color: var(--ca-cards-text);
  }

  .ca-content-cards::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--ca-cards-background);
    pointer-events: none;
  }

  .ca-content-cards__surface {
    position: relative;
    z-index: 1;
    width: 100%;
    background: transparent;
  }

  .ca-content-cards__inner {
    min-width: 0;
    padding-block: var(--ca-cards-padding-top) var(--ca-cards-padding-bottom);
  }

  .ca-content-cards__intro {
    max-width: 1120px;
    margin: 0 auto 36px;
  }

  .ca-content-cards__intro--divider {
    border-top: 1px solid var(--ca-cards-divider);
    padding-top: 24px;
  }

  .ca-content-cards__intro--style_1 {
    max-width: 960px;
    text-align: center;
  }

  .ca-content-cards__intro--style_1 .ca-content-cards__intro-copy {
    max-width: 760px;
    margin-inline: auto;
  }

  .ca-content-cards__intro--style_2 {
    width: 100%;
    max-width: none;
    display: grid;
    grid-template-columns: minmax(0, .78fr) minmax(0, 1.22fr);
    gap: clamp(32px, 6vw, 92px);
    align-items: end;
    text-align: left;
  }

  .ca-content-cards__eyebrow {
    margin: 0 0 10px;
    color: var(--ca-cards-accent);
    letter-spacing: .14em;
    text-transform: uppercase;
    font-size: var(--ca-cards-eyebrow-size);
  }

  .ca-content-cards__heading {
    margin: 0 0 14px;
    color: inherit;
    font-size: var(--ca-cards-heading-size);
    line-height: 1.08;
  }

  .ca-content-cards__description {
    font-size: var(--ca-cards-body-size);
    line-height: 1.6;
  }

  .ca-content-card__text {
    font-size: var(--ca-cards-card-body-size);
    line-height: 1.6;
  }

  .ca-content-cards__description :is(p, ul, ol),
  .ca-content-card__text :is(p, ul, ol) {
    font-size: inherit;
    line-height: inherit;
  }

  .ca-content-cards__description p,
  .ca-content-card__text p {
    margin: 0;
  }

  .ca-content-cards__grid {
    display: grid;
    grid-template-columns: repeat(var(--ca-cards-desktop-columns), minmax(0, 1fr));
    column-gap: var(--ca-cards-gap);
    row-gap: var(--ca-cards-row-gap);
  }

  .ca-content-card__media {
    position: relative;
    width: var(--ca-cards-image-width);
    max-width: 100%;
    margin-inline: auto;
    aspect-ratio: var(--ca-cards-ratio);
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb) / .04);
  }

  .ca-content-card__image,
  .ca-content-card__placeholder {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ca-content-card__content {
    padding-top: 14px;
    text-align: var(--ca-cards-card-align);
  }

  .ca-content-card__title {
    margin: 0 0 8px;
    color: inherit;
    font-size: var(--ca-cards-card-title-size);
    line-height: 1.25;
  }

  .ca-content-card__action {
    display: flex;
    justify-content: var(--ca-cards-card-action-align);
    margin-top: 14px;
  }

  .ca-content-cards__grid--desktop-carousel {
    display: flex;
    overflow-x: auto;
    gap: var(--ca-cards-gap);
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .ca-content-cards__grid--desktop-carousel .ca-content-card {
    flex: 0 0 calc((100% - (var(--ca-cards-desktop-columns) - 1) * var(--ca-cards-gap)) / var(--ca-cards-desktop-columns));
    scroll-snap-align: start;
  }

  .ca-content-cards__intro-action {
    margin-top: 22px;
  }

  @media screen and (max-width: 749px) {
    .ca-content-cards__intro {
      text-align: left;
      margin-bottom: 24px;
    }

    .ca-content-cards__intro--style_2 {
      display: block;
    }

    .ca-content-cards__intro--style_2 .ca-content-cards__intro-title {
      margin-bottom: 14px;
    }

    .ca-content-cards__heading {
      font-size: min(var(--ca-cards-heading-size), 44px);
    }

    .ca-content-cards__grid {
      grid-template-columns: repeat(var(--ca-cards-mobile-columns), minmax(0, 1fr));
    }

    .ca-content-cards__grid--desktop-carousel:not(.ca-content-cards__grid--mobile-carousel) {
      display: grid;
      overflow: visible;
    }

    .ca-content-cards__grid--mobile-carousel {
      display: flex;
      overflow-x: auto;
      gap: var(--ca-cards-gap);
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .ca-content-cards__grid--mobile-carousel .ca-content-card {
      flex: 0 0 calc((100% - (var(--ca-cards-mobile-columns) - 1) * var(--ca-cards-gap)) / var(--ca-cards-mobile-columns));
      scroll-snap-align: start;
    }

    .ca-content-cards__grid--mobile-carousel::-webkit-scrollbar {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "图文卡片",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "内容宽度",
