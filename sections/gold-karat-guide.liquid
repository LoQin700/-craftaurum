{% if section.settings.background_color != blank %}
  {% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}
{% endif %}

<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>

<section
  id="GoldKaratGuide-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} spacing-style ca-karat-guide{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    --padding-block-start: {{ section.settings.padding_top }}px;
    --padding-block-end: {{ section.settings.padding_bottom }}px;
    --ca-karat-accent: {{ section.settings.accent_color }};
    --ca-karat-line: {{ section.settings.line_color }};
    --ca-karat-gap: {{ section.settings.column_gap }}px;
  "
>
  <div class="ca-karat-guide__inner">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.description != blank %}
      <header class="ca-karat-guide__intro">
        {% if section.settings.eyebrow != blank %}
          <p class="ca-karat-guide__eyebrow {{ section.settings.eyebrow_preset }}">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="ca-karat-guide__heading {{ section.settings.heading_preset }}">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="ca-karat-guide__description rte {{ section.settings.body_preset }}">{{ section.settings.description }}</div>
        {% endif %}
      </header>
    {% endif %}

    <div class="ca-karat-guide__layout">
      <div class="ca-karat-guide__list">
        {% for block in section.blocks %}
          <article class="ca-karat-guide__item" {{ block.shopify_attributes }}>
            <div class="ca-karat-guide__item-head">
              {% if block.settings.title != blank %}
                <h3 class="ca-karat-guide__item-title {{ section.settings.item_title_preset }}">{{ block.settings.title | escape }}</h3>
              {% endif %}
              {% if block.settings.gold_content != blank %}
                <span class="ca-karat-guide__purity">{{ block.settings.gold_content | escape }}</span>
              {% endif %}
            </div>
            {% if block.settings.description != blank %}
              <div class="ca-karat-guide__item-copy rte {{ section.settings.body_preset }}">{{ block.settings.description }}</div>
            {% endif %}
          </article>
        {% endfor %}
      </div>

      <aside class="ca-karat-guide__aside">
        <div class="ca-karat-guide__aside-sticky">
          <div class="ca-karat-guide__media">
            {% if section.settings.image != blank %}
              {{
                section.settings.image
                | image_url: width: 1600
                | image_tag:
                  loading: 'lazy',
                  class: 'ca-karat-guide__image',
                  widths: '420,640,840,1100,1400,1600',
                  sizes: '(min-width: 990px) 42vw, 100vw'
              }}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'ca-karat-guide__placeholder' }}
            {% endif %}
          </div>

          {% if section.settings.aside_heading != blank or section.settings.aside_body != blank %}
            <div class="ca-karat-guide__aside-copy">
              {% if section.settings.aside_heading != blank %}
                <h3 class="ca-karat-guide__aside-title {{ section.settings.aside_title_preset }}">{{ section.settings.aside_heading | escape }}</h3>
              {% endif %}
              {% if section.settings.aside_body != blank %}
                <div class="ca-karat-guide__aside-body rte {{ section.settings.body_preset }}">{{ section.settings.aside_body }}</div>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </aside>
    </div>
  </div>
</section>

{% stylesheet %}
  .ca-karat-guide__inner { min-width: 0; }
  .ca-karat-guide__intro {
    max-width: 900px;
    margin-bottom: 44px;
  }
  .ca-karat-guide__eyebrow {
    margin: 0 0 10px;
    color: var(--ca-karat-accent);
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .ca-karat-guide__heading { margin: 0 0 14px; }
  .ca-karat-guide__description p { margin: 0; }

  .ca-karat-guide__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, .9fr);
    gap: var(--ca-karat-gap);
    align-items: start;
  }
  .ca-karat-guide__list {
    border-top: 1px solid var(--ca-karat-line);
  }
  .ca-karat-guide__item {
    padding: 26px 0 28px;
    border-bottom: 1px solid var(--ca-karat-line);
  }
  .ca-karat-guide__item-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 10px;
  }
  .ca-karat-guide__item-title { margin: 0; }
  .ca-karat-guide__purity {
    flex: 0 0 auto;
    color: var(--ca-karat-accent);
    font-size: 12px;
    line-height: 1.3;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .ca-karat-guide__item-copy {
    max-width: 64ch;
  }
  .ca-karat-guide__item-copy p { margin: 0; }

  .ca-karat-guide__aside-sticky {
    position: sticky;
    top: calc(var(--header-height, 0px) + 24px);
  }
  .ca-karat-guide__media {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb) / .04);
  }
  .ca-karat-guide__image,
  .ca-karat-guide__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ca-karat-guide__aside-copy {
    padding-top: 24px;
  }
  .ca-karat-guide__aside-title { margin: 0 0 10px; }
  .ca-karat-guide__aside-body p { margin: 0 0 1em; }
  .ca-karat-guide__aside-body p:last-child { margin-bottom: 0; }

  @media screen and (max-width: 989px) {
    .ca-karat-guide__layout {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .ca-karat-guide__aside-sticky { position: static; }
  }

  @media screen and (max-width: 749px) {
    .ca-karat-guide__intro { margin-bottom: 28px; }
    .ca-karat-guide__item { padding: 22px 0 24px; }
    .ca-karat-guide__item-head {
      display: block;
      margin-bottom: 8px;
    }
    .ca-karat-guide__purity {
      display: inline-block;
      margin-top: 6px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "黄金K数指南",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "内容宽度",
      "options": [
        { "value": "page-width", "label": "页面宽度" },
        { "value": "full-width", "label": "全宽" }
      ],
      "default": "page-width"
    },
    { "type": "color", "id": "background_color", "label": "背景颜色", "default": "#F8F7F4" },
    { "type": "color", "id": "accent_color", "label": "重点颜色", "default": "#C7A85E" },
    { "type": "color", "id": "line_color", "label": "分隔线颜色", "default": "#D8D5CE" },
    { "type": "text", "id": "eyebrow", "label": "小标题", "default": "GOLD KARAT GUIDE" },
    {
      "type": "select",
      "id": "eyebrow_preset",
      "label": "小标题字号",
      "options": [
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h5"
    },
    { "type": "text", "id": "heading", "label": "标题", "default": "Understanding Gold Karat Options" },
    {
      "type": "select",
      "id": "heading_preset",
      "label": "标题字号",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    { "type": "richtext", "id": "description", "label": "介绍文字", "default": "<p>Compare gold content, wear characteristics and positioning across the most common karat options used in jewelry production.</p>" },
    {
      "type": "select",
      "id": "body_preset",
      "label": "正文字号",
      "options": [
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h5"
    },
    {
      "type": "select",
      "id": "item_title_preset",
      "label": "K数标题字号",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h3"
    },
    { "type": "image_picker", "id": "image", "label": "右侧黄金材质图片" },
    { "type": "text", "id": "aside_heading", "label": "右侧说明标题", "default": "What Does Karat Mean in Gold Jewelry?" },
    {
      "type": "select",
      "id": "aside_title_preset",
      "label": "右侧标题字号",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h3"
    },
    { "type": "richtext", "id": "aside_body", "label": "右侧说明正文", "default": "<p>Karat describes the proportion of pure gold within a gold alloy. Higher karat means greater gold content, while lower karat generally provides greater hardness and durability.</p>" },
    { "type": "range", "id": "column_gap", "label": "左右间距", "min": 24, "max": 96, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_top", "label": "上边距", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "下边距", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "karat",
      "name": "K数项目",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "title", "label": "标题", "default": "14K Gold Jewelry" },
        { "type": "text", "id": "gold_content", "label": "含金量", "default": "58.5% GOLD" },
        { "type": "richtext", "id": "description", "label": "正文", "default": "<p>A balanced option combining recognizable gold color with durability for everyday jewelry.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "黄金K数指南",
      "blocks": [
        { "type": "karat", "settings": { "title": "10K Gold Jewelry", "gold_content": "41.7% GOLD" } },
        { "type": "karat", "settings": { "title": "14K Gold Jewelry", "gold_content": "58.5% GOLD" } },
        { "type": "karat", "settings": { "title": "18K Gold Jewelry", "gold_content": "75% GOLD" } },
        { "type": "karat", "settings": { "title": "20K Gold Jewelry", "gold_content": "83.3% GOLD" } },
        { "type": "karat", "settings": { "title": "24K Gold Jewelry", "gold_content": "99.9% GOLD" } }
      ]
    }
  ]
}
{% endschema %}
