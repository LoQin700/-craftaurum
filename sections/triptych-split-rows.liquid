{% if section.settings.background_color != blank %}
  {% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}
{% endif %}

<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>

<section
  id="TriptychSplitRows-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} spacing-style ca-triptych-split{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    --padding-block-start: {{ section.settings.padding_top }}px;
    --padding-block-end: {{ section.settings.padding_bottom }}px;
    --ca-triptych-row-gap: {{ section.settings.row_gap }}px;
    --ca-triptych-panel-gap: {{ section.settings.panel_gap }}px;
    --ca-triptych-image-gap: {{ section.settings.image_gap }}px;
    --ca-triptych-text-pad: {{ section.settings.text_padding }}px;
    --ca-triptych-image-pad: {{ section.settings.image_padding }}px;
    --ca-triptych-text-bg: {{ section.settings.text_background }};
    --ca-triptych-image-bg: {{ section.settings.image_background }};
    --ca-triptych-text-color: {{ section.settings.text_color }};
  "
>
  <div class="ca-triptych-split__rows">
    {% for block in section.blocks %}
      <article
        class="ca-triptych-split__row ca-triptych-split__row--image-{{ section.settings.image_position }}"
        {{ block.shopify_attributes }}
      >
        <div class="ca-triptych-split__copy">
          {% if block.settings.heading != blank %}
            <h3 class="ca-triptych-split__title {{ section.settings.heading_preset }}">{{ block.settings.heading | escape }}</h3>
          {% endif %}
          {% if block.settings.body != blank %}
            <div class="ca-triptych-split__body rte {{ section.settings.body_preset }}">{{ block.settings.body }}</div>
          {% endif %}
        </div>

        <div class="ca-triptych-split__images">
          {% for i in (1..3) %}
            {% liquid
              assign image_key = 'image_' | append: i
              assign image = block.settings[image_key]
            %}
            <div class="ca-triptych-split__image-wrap">
              {% if image != blank %}
                {{
                  image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    class: 'ca-triptych-split__image',
                    widths: '240,360,480,640,800,900',
                    sizes: '(min-width: 990px) 17vw, 31vw'
                }}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'ca-triptych-split__placeholder' }}
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </article>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .ca-triptych-split__rows {
    display: grid;
    gap: var(--ca-triptych-row-gap);
  }

  .ca-triptych-split__row {
    display: grid;
    grid-template-columns: minmax(0, 48fr) minmax(0, 52fr);
    gap: var(--ca-triptych-panel-gap);
    align-items: stretch;
  }

  .ca-triptych-split__row--image-left .ca-triptych-split__images {
    order: 1;
  }

  .ca-triptych-split__row--image-left .ca-triptych-split__copy {
    order: 2;
  }

  .ca-triptych-split__copy,
  .ca-triptych-split__images {
    min-width: 0;
    height: 100%;
  }

  .ca-triptych-split__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--ca-triptych-text-pad);
    background: var(--ca-triptych-text-bg);
    color: var(--ca-triptych-text-color);
  }

  .ca-triptych-split__title {
    margin: 0 0 12px;
    color: inherit;
  }

  .ca-triptych-split__body {
    color: inherit;
    line-height: 1.6;
  }

  .ca-triptych-split__body p {
    margin: 0;
  }

  .ca-triptych-split__images {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--ca-triptych-image-gap);
    align-items: center;
    padding: var(--ca-triptych-image-pad);
    background: var(--ca-triptych-image-bg);
  }

  .ca-triptych-split__image-wrap {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .ca-triptych-split__image,
  .ca-triptych-split__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 749px) {
    .ca-triptych-split__row {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .ca-triptych-split__copy {
      order: 1 !important;
      padding: min(var(--ca-triptych-text-pad), 24px);
    }

    .ca-triptych-split__images {
      order: 2 !important;
      padding: min(var(--ca-triptych-image-pad), 14px);
      gap: min(var(--ca-triptych-image-gap), 10px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "三联图文",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "内容宽度",
      "options": [
        { "value": "page-width", "label": "页面宽度" },
        { "value": "full-width", "label": "全宽" }
      ],
      "default": "page-width"
    },
    { "type": "color", "id": "background_color", "label": "Section 背景", "default": "#FFFFFF" },
    {
      "type": "select",
      "id": "image_position",
      "label": "图片位置",
      "options": [
        { "value": "right", "label": "左文右图" },
        { "value": "left", "label": "左图右文" }
      ],
      "default": "right"
    },
    { "type": "color", "id": "text_background", "label": "文字区域背景", "default": "#E7DED0" },
    { "type": "color", "id": "image_background", "label": "图片区背景", "default": "#F6F2EB" },
    { "type": "color", "id": "text_color", "label": "文字颜色", "default": "#17191A" },
    {
      "type": "select",
      "id": "heading_preset",
      "label": "标题字号",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "body_preset",
      "label": "正文字号",
      "options": [
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h5"
    },
    { "type": "range", "id": "text_padding", "label": "文字区域内边距", "min": 0, "max": 72, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "image_padding", "label": "图片区内边距", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "image_gap", "label": "图片间距", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "panel_gap", "label": "图文间距", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "row_gap", "label": "行间距", "min": 0, "max": 64, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding_top", "label": "上边距", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "下边距", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "三联图文行",
      "settings": [
        { "type": "image_picker", "id": "image_1", "label": "图片 1" },
        { "type": "image_picker", "id": "image_2", "label": "图片 2" },
        { "type": "image_picker", "id": "image_3", "label": "图片 3" },
        { "type": "text", "id": "heading", "label": "标题", "default": "Collection Title" },
        { "type": "richtext", "id": "body", "label": "正文", "default": "<p>Add a short description for this collection.</p>" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "三联图文",
      "blocks": [
        { "type": "row" },
        { "type": "row" }
      ]
    }
  ]
}
{% endschema %}
