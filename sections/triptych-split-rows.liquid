{% if section.settings.background_color != blank %}
  {% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}
{% endif %}

<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>

<section
  id="TriptychSplitRows-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} spacing-style ca-triptych-split{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    --padding-block-start: {{ section.settings.padding_top }}px;
    --padding-block-end: {{ section.settings.padding_bottom }}px;
    --ca-triptych-row-gap: {{ section.settings.row_gap }}px;
    --ca-triptych-panel-gap: {{ section.settings.panel_gap }}px;
    --ca-triptych-image-gap: {{ section.settings.image_gap }}px;
    --ca-triptych-text-pad: {{ section.settings.text_padding }}px;
    --ca-triptych-image-pad: {{ section.settings.image_padding }}px;
    --ca-triptych-text-bg: {{ section.settings.text_background }};
    --ca-triptych-image-bg: {{ section.settings.image_background }};
    --ca-triptych-text-color: {{ section.settings.text_color }};
    --ca-triptych-heading-size: {{ section.settings.heading_size | default: 35 }}px;
    --ca-triptych-body-size: {{ section.settings.body_size | default: 16 }}px;
    --ca-triptych-heading-size-mobile: {{ section.settings.mobile_heading_size | default: 25 }}px;
    --ca-triptych-body-size-mobile: {{ section.settings.mobile_body_size | default: 14 }}px;
    --ca-triptych-copy-width: {{ section.settings.copy_width | default: 48 }}%;
    --ca-triptych-image-ratio: {{ section.settings.image_ratio | default: "square" }};
    --ca-triptych-mobile-image-cols: {{ section.settings.mobile_image_columns | default: "3" }};
  "
>
  <div class="ca-triptych-split__rows" data-ca-reveal="{{ section.settings.animation_style | default: 'fade-up' }}">
    {% for block in section.blocks %}
      {% liquid
        assign row_image_position = section.settings.image_position
        if block.settings.image_position != blank and block.settings.image_position != "inherit"
          assign row_image_position = block.settings.image_position
        endif
      %}
      <article
        class="ca-triptych-split__row ca-triptych-split__row--image-{{ row_image_position }}"
        {{ block.shopify_attributes }}
      >
        <div class="ca-triptych-split__copy">
          {% if block.settings.heading != blank %}
            <h3 class="ca-triptych-split__title">{{ block.settings.heading | escape }}</h3>
          {% endif %}
          {% if block.settings.body != blank %}
            <div class="ca-triptych-split__body rte">{{ block.settings.body }}</div>
          {% endif %}
        </div>

        <div class="ca-triptych-split__images">
          {% for i in (1..3) %}
            {% liquid
              assign image_key = 'image_' | append: i
              assign image = block.settings[image_key]
            %}
            <div class="ca-triptych-split__image-wrap">
              {% if image != blank %}
                {{
                  image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    class: 'ca-triptych-split__image',
                    widths: '240,360,480,640,800,900',
                    sizes: '(min-width: 990px) 17vw, 31vw'
                }}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'ca-triptych-split__placeholder' }}
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </article>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .ca-triptych-split__rows {
    display: grid;
    gap: var(--ca-triptych-row-gap);
  }

  .ca-triptych-split__row {
    display: grid;
    grid-template-columns: minmax(0, var(--ca-triptych-copy-width)) minmax(0, 1fr);
    gap: var(--ca-triptych-panel-gap);
    align-items: stretch;
  }

  .ca-triptych-split__row--image-left .ca-triptych-split__images {
    order: 1;
  }

  .ca-triptych-split__row--image-left .ca-triptych-split__copy {
    order: 2;
  }

  .ca-triptych-split__copy,
  .ca-triptych-split__images {
    min-width: 0;
    height: 100%;
  }

  .ca-triptych-split__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--ca-triptych-text-pad);
    background: var(--ca-triptych-text-bg);
    color: var(--ca-triptych-text-color);
  }

  .ca-triptych-split__title {
    margin: 0 0 12px;
    color: inherit;
    font-size: var(--ca-triptych-heading-size);
    line-height: 1.15;
  }

  .ca-triptych-split__body {
    color: inherit;
    font-size: var(--ca-triptych-body-size);
    line-height: 1.6;
  }

  .ca-triptych-split__body p {
    margin: 0;
  }

  .ca-triptych-split__images {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--ca-triptych-image-gap);
    align-items: center;
    padding: var(--ca-triptych-image-pad);
    background: var(--ca-triptych-image-bg);
  }

  .ca-triptych-split__image-wrap {
    width: 100%;
    aspect-ratio: {% if section.settings.image_ratio == "portrait" %}4 / 5{% elsif section.settings.image_ratio == "landscape" %}4 / 3{% else %}1 / 1{% endif %};
    overflow: hidden;
  }

  .ca-triptych-split__image,
  .ca-triptych-split__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 749px) {
    .ca-triptych-split__title { font-size: var(--ca-triptych-heading-size-mobile); }
    .ca-triptych-split__body { font-size: var(--ca-triptych-body-size-mobile); }
    .ca-triptych-split__body :is(p, ul, ol) { font-size: inherit; }
    .ca-triptych-split__row {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .ca-triptych-split__copy {
      order: {% if section.settings.mobile_image_first %}2{% else %}1{% endif %} !important;
      padding: min(var(--ca-triptych-text-pad), 24px);
    }

    .ca-triptych-split__images {
      grid-template-columns: repeat({{ section.settings.mobile_image_columns | default: "3" }}, minmax(0, 1fr));
      order: {% if section.settings.mobile_image_first %}1{% else %}2{% endif %} !important;
      padding: min(var(--ca-triptych-image-pad), 14px);
      gap: min(var(--ca-triptych-image-gap), 10px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "三联图文",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "基础设置"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "内容宽度",
      "options": [
        {
          "value": "page-width",
          "label": "页面宽度"
        },
        {
          "value": "full-width",
          "label": "全宽"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "图片设置"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "图片位置",
      "options": [
        {
          "value": "right",
          "label": "左文右图"
        },
        {
          "value": "left",
          "label": "左图右文"
        }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "图片比例",
      "options": [
        {
          "value": "square",
          "label": "1:1"
        },
        {
          "value": "landscape",
          "label": "4:3"
        },
        {
          "value": "wide",
          "label": "16:9"
        },
        {
          "value": "portrait",
          "label": "4:5"
        }
      ],
      "default": "square"
    },
    {
      "type": "header",
      "content": "布局与交互"
    },
    {
      "type": "range",
      "id": "copy_width",
      "label": "电脑端文字区域占比",
      "min": 30,
      "max": 70,
      "step": 2,
      "unit": "%",
      "default": 48
    },
    {
      "type": "range",
      "id": "text_padding",
      "label": "文字区域内边距",
      "min": 0,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "image_padding",
      "label": "图片区内边距",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "image_gap",
      "label": "图片间距",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "panel_gap",
      "label": "图文间距",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "行间距",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "手机端布局"
    },
    {
      "type": "checkbox",
      "id": "mobile_image_first",
      "label": "手机端图片放在文字上方",
      "default": false
    },
    {
      "type": "select",
      "id": "mobile_image_columns",
      "label": "手机端每行图片列数",
      "options": [
        {
          "value": "2",
          "label": "2 列"
        },
        {
          "value": "3",
          "label": "3 列"
        }
      ],
      "default": "3"
    },
    {
      "type": "header",
      "content": "电脑端字号"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "标题字号",
      "min": 24,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 35
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "正文字号",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "移动端字号"
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "标题字号",
      "min": 24,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 25
    },
    {
      "type": "range",
      "id": "mobile_body_size",
      "label": "正文字号",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "颜色设置"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section 背景",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_background",
      "label": "文字区域背景",
      "default": "#E7DED0"
    },
    {
      "type": "color",
      "id": "image_background",
      "label": "图片区背景",
      "default": "#F6F2EB"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文字颜色",
      "default": "#17191A"
    },
    {
      "type": "header",
      "content": "其它设置"
    },
    {
      "type": "select",
      "id": "animation_style",
      "label": "入场动画",
      "options": [
        {
          "value": "fade-up",
          "label": "Fade Up"
        },
        {
          "value": "fade-in",
          "label": "Fade In"
        },
        {
          "value": "soft-zoom",
          "label": "Soft Zoom"
        }
      ],
      "default": "fade-up"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "上边距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下边距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "三联图文行",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_1",
          "label": "图片 1"
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "图片 2"
        },
        {
          "type": "image_picker",
          "id": "image_3",
          "label": "图片 3"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "本行图片位置",
          "options": [
            {
              "value": "inherit",
              "label": "跟随整体设置"
            },
            {
              "value": "right",
              "label": "左文右图"
            },
            {
              "value": "left",
              "label": "左图右文"
            }
          ],
          "default": "inherit"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "标题",
          "default": "Collection Title"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "正文",
          "default": "<p>Add a short description for this collection.</p>"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "三联图文",
      "blocks": [
        {
          "type": "row"
        },
        {
          "type": "row"
        }
      ]
    }
  ]
}
{% endschema %}
