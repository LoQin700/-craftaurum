{% if section.settings.background_color != blank %}
  {% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}
{% endif %}

<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>

<section
  id="GoldMaterialComparison-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} spacing-style ca-gold-compare{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    --padding-block-start: {{ section.settings.padding_top }}px;
    --padding-block-end: {{ section.settings.padding_bottom }}px;
    --ca-gold-compare-accent: {{ section.settings.accent_color }};
    --ca-gold-compare-line: {{ section.settings.line_color }};
    --ca-gold-compare-gap: {{ section.settings.column_gap }}px;
  "
>
  <div class="ca-gold-compare__inner">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.description != blank %}
      <header class="ca-gold-compare__intro">
        {% if section.settings.eyebrow != blank %}
          <p class="ca-gold-compare__eyebrow {{ section.settings.eyebrow_preset }}">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="ca-gold-compare__heading {{ section.settings.heading_preset }}">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="ca-gold-compare__description rte {{ section.settings.body_preset }}">{{ section.settings.description }}</div>
        {% endif %}
      </header>
    {% endif %}

    <div class="ca-gold-compare__grid">
      {% for block in section.blocks %}
        <article class="ca-gold-compare__column" {{ block.shopify_attributes }}>
          {% if block.settings.kicker != blank %}
            <p class="ca-gold-compare__kicker">{{ block.settings.kicker | escape }}</p>
          {% endif %}
          {% if block.settings.title != blank %}
            <h3 class="ca-gold-compare__title {{ section.settings.item_title_preset }}">{{ block.settings.title | escape }}</h3>
          {% endif %}
          {% if block.settings.description != blank %}
            <div class="ca-gold-compare__copy rte {{ section.settings.body_preset }}">{{ block.settings.description }}</div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .ca-gold-compare__inner { min-width: 0; }
  .ca-gold-compare__intro {
    max-width: 980px;
    margin: 0 auto 46px;
    text-align: center;
  }
  .ca-gold-compare__eyebrow {
    margin: 0 0 10px;
    color: var(--ca-gold-compare-accent);
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .ca-gold-compare__heading { margin: 0 0 14px; }
  .ca-gold-compare__description p { margin: 0; }
  .ca-gold-compare__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid var(--ca-gold-compare-line);
    border-bottom: 1px solid var(--ca-gold-compare-line);
  }
  .ca-gold-compare__column {
    min-width: 0;
    padding: 34px max(26px, calc(var(--ca-gold-compare-gap) / 2));
  }
  .ca-gold-compare__column + .ca-gold-compare__column {
    border-left: 1px solid var(--ca-gold-compare-line);
  }
  .ca-gold-compare__kicker {
    margin: 0 0 22px;
    color: var(--ca-gold-compare-accent);
    font-size: 12px;
    line-height: 1.3;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .ca-gold-compare__title { margin: 0 0 20px; }
  .ca-gold-compare__copy :is(p, ul, ol) {
    font-size: inherit;
    line-height: inherit;
  }
  .ca-gold-compare__copy ul {
    margin: 0;
    padding-left: 1.15em;
  }
  .ca-gold-compare__copy li + li { margin-top: 12px; }

  @media screen and (max-width: 749px) {
    .ca-gold-compare__intro {
      margin-bottom: 28px;
      text-align: left;
    }
    .ca-gold-compare__grid {
      grid-template-columns: 1fr;
    }
    .ca-gold-compare__column {
      padding: 26px 0;
    }
    .ca-gold-compare__column + .ca-gold-compare__column {
      border-left: 0;
      border-top: 1px solid var(--ca-gold-compare-line);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "黄金材质对比",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "内容宽度",
      "options": [
        { "value": "page-width", "label": "页面宽度" },
        { "value": "full-width", "label": "全宽" }
      ],
      "default": "page-width"
    },
    { "type": "color", "id": "background_color", "label": "背景颜色", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "重点颜色", "default": "#C7A85E" },
    { "type": "color", "id": "line_color", "label": "分隔线颜色", "default": "#D8D5CE" },
    { "type": "text", "id": "eyebrow", "label": "小标题", "default": "GOLD MATERIAL GUIDE" },
    {
      "type": "select",
      "id": "eyebrow_preset",
      "label": "小标题字号",
      "options": [
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h5"
    },
    { "type": "text", "id": "heading", "label": "标题", "default": "Solid Gold VS Gold Vermeil VS Gold Plated Jewelry" },
    {
      "type": "select",
      "id": "heading_preset",
      "label": "标题字号",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    { "type": "richtext", "id": "description", "label": "介绍文字", "default": "<p>Compare composition, process and wear characteristics before choosing the right direction for your collection.</p>" },
    {
      "type": "select",
      "id": "body_preset",
      "label": "正文字号",
      "options": [
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h5"
    },
    {
      "type": "select",
      "id": "item_title_preset",
      "label": "列标题字号",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h3"
    },
    { "type": "range", "id": "column_gap", "label": "列内间距", "min": 24, "max": 80, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_top", "label": "上边距", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "下边距", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "material",
      "name": "材质列",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "kicker", "label": "顶部标签" },
        { "type": "text", "id": "title", "label": "标题", "default": "Solid Gold Jewelry" },
        { "type": "richtext", "id": "description", "label": "正文", "default": "<ul><li>Composition: Gold alloy throughout the piece.</li><li>Process: Alloying, casting, shaping, soldering and finishing.</li><li>Durability: Designed for long-term fine jewelry wear.</li></ul>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "黄金材质对比",
      "blocks": [
        { "type": "material", "settings": { "kicker": "FINE JEWELRY", "title": "Solid Gold Jewelry" } },
        { "type": "material", "settings": { "kicker": "STERLING SILVER BASE", "title": "Gold Vermeil Jewelry" } },
        { "type": "material", "settings": { "kicker": "FASHION JEWELRY", "title": "Gold Plated Jewelry" } }
      ]
    }
  ]
}
{% endschema %}
