{% comment %}Reusable image collection grid with optional mobile carousel. Horizon 4.1.3.{% endcomment %}
<section id="ImageCollectionGrid-{{ section.id }}" class="section section--page-width image-collection-grid" style="--icg-overlay:{{ section.settings.overlay_opacity | divided_by: 100.0 }};--icg-hover-overlay:{{ section.settings.hover_overlay_opacity | divided_by: 100.0 }};--icg-gap:{{ section.settings.gap }}px;--icg-mobile-cols:{{ section.settings.mobile_columns }};--icg-pt:{{ section.settings.padding_top }}px;--icg-pb:{{ section.settings.padding_bottom }}px;">
  <div class="image-collection-grid__intro">
    {% if section.settings.heading != blank %}<h2 class="{{ section.settings.heading_preset | default: 'h2' }}">{{ section.settings.heading | escape }}</h2>{% endif %}
    {% if section.settings.description != blank %}<div class="image-collection-grid__description rte {{ section.settings.body_preset | default: 'h4' }}">{{ section.settings.description }}</div>{% endif %}
  </div>
  <div class="image-collection-grid__viewport{% if section.settings.mobile_layout == 'carousel' %} image-collection-grid__viewport--carousel{% endif %}" data-grid-viewport>
    <div class="image-collection-grid__items">
      {% for block in section.blocks %}
        {% liquid
          assign card_url = block.settings.link
          if block.settings.collection != blank and card_url == blank
            assign card_url = block.settings.collection.url
          endif
          assign card_title = block.settings.title
          if card_title == blank and block.settings.collection != blank
            assign card_title = block.settings.collection.title
          endif
        %}
        <div class="image-collection-grid__item" {{ block.shopify_attributes }}>
          {% if card_url != blank %}<a class="image-collection-grid__card" href="{{ card_url }}" aria-label="{{ card_title | escape }}">
          {% else %}<div class="image-collection-grid__card">
          {% endif %}
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '280, 400, 600, 800, 1200', sizes: '(min-width: 750px) 50vw, 100vw', class: 'image-collection-grid__image' }}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'image-collection-grid__placeholder' }}
            {% endif %}
            <span class="image-collection-grid__shade"></span>
            <span class="image-collection-grid__outline" aria-hidden="true"></span>
            {% if card_title != blank %}<span class="image-collection-grid__card-title {{ section.settings.card_title_preset | default: 'h3' }}" style="font-size:var(--font-{{ section.settings.card_title_preset | default: 'h3' }}--size);font-weight:var(--font-{{ section.settings.card_title_preset | default: 'h3' }}--weight);line-height:var(--font-{{ section.settings.card_title_preset | default: 'h3' }}--line-height);">{{ card_title | escape }}</span>{% endif %}
          {% if card_url != blank %}</a>{% else %}</div>{% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
  {% if section.settings.mobile_layout == 'carousel' and section.blocks.size > 1 %}
    <div class="image-collection-grid__nav">
      <button type="button" class="image-collection-grid__nav-button" data-grid-prev aria-label="Previous items">‹</button>
      <button type="button" class="image-collection-grid__nav-button" data-grid-next aria-label="Next items">›</button>
    </div>
  {% endif %}
</section>
<style>
  #ImageCollectionGrid-{{ section.id }} {padding-block:var(--icg-pt) var(--icg-pb);}
  #ImageCollectionGrid-{{ section.id }} .image-collection-grid__intro{text-align:center;max-width:980px;margin:0 auto 28px;}
  #ImageCollectionGrid-{{ section.id }} .image-collection-grid__intro h2{margin:0 0 14px;}
  #ImageCollectionGrid-{{ section.id }} .image-collection-grid__description p{font-size:inherit;line-height:inherit;margin:0;}
  #ImageCollectionGrid-{{ section.id }} .image-collection-grid__items{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:var(--icg-gap);}
  #ImageCollectionGrid-{{ section.id }} .image-collection-grid__item{grid-column:span 2;min-width:0;}
  #ImageCollectionGrid-{{ section.id }} .image-collection-grid__item:nth-child(-n+2){grid-column:span 3;}
  #ImageCollectionGrid-{{ section.id }} .image-collection-grid__card{display:block;position:relative;overflow:hidden;aspect-ratio:4/3;isolation:isolate;background:rgb(var(--color-foreground-rgb) / .06);color:#fff;text-decoration:none;}
  #ImageCollectionGrid-{{ section.id }} .image-collection-grid__image,#ImageCollectionGrid-{{ section.id }} .image-collection-grid__placeholder{display:block;width:100%;height:100%;object-fit:cover;transition:transform .45s ease;}
  #ImageCollectionGrid-{{ section.id }} .image-collection-grid__shade{position:absolute;inset:0;background:#000;opacity:var(--icg-overlay);transition:opacity .35s ease;}
  #ImageCollectionGrid-{{ section.id }} .image-collection-grid__card-title{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;text-align:center;padding:16px;color:#fff;font-family:var(--font-heading--family,inherit);z-index:1;pointer-events:none;}
  #ImageCollectionGrid-{{ section.id }} .image-collection-grid__outline{position:absolute;inset:12px;border:1px solid rgba(255,255,255,.9);transform:scale(1.06);opacity:0;transition:transform .35s ease,opacity .35s ease;z-index:1;pointer-events:none;}
  @media(hover:hover){#ImageCollectionGrid-{{ section.id }} .image-collection-grid__card:hover .image-collection-grid__shade{opacity:var(--icg-hover-overlay);}
  #ImageCollectionGrid-{{ section.id }} .image-collection-grid__card:hover .image-collection-grid__outline{transform:scale(1);opacity:1;}
  #ImageCollectionGrid-{{ section.id }} .image-collection-grid__card:hover .image-collection-grid__image{transform:scale(1.035);}}
  #ImageCollectionGrid-{{ section.id }} a.image-collection-grid__card:focus-visible{outline:3px solid currentColor;outline-offset:3px;}
  #ImageCollectionGrid-{{ section.id }} .image-collection-grid__nav{display:none;}
  @media(max-width:749px){
    #ImageCollectionGrid-{{ section.id }} .image-collection-grid__intro{margin-bottom:22px;}
    #ImageCollectionGrid-{{ section.id }} .image-collection-grid__items{grid-template-columns:repeat(var(--icg-mobile-cols),minmax(0,1fr));gap:var(--icg-gap);}
    #ImageCollectionGrid-{{ section.id }} .image-collection-grid__item,#ImageCollectionGrid-{{ section.id }} .image-collection-grid__item:nth-child(-n+2){grid-column:span 1;}
    #ImageCollectionGrid-{{ section.id }} .image-collection-grid__card-title{font-size:clamp(10px,calc(var(--font-{{ section.settings.card_title_preset | default: 'h3' }}--size) / var(--icg-mobile-cols) * 1.25),var(--font-{{ section.settings.card_title_preset | default: 'h3' }}--size))!important;padding:5px;overflow-wrap:anywhere;}
    #ImageCollectionGrid-{{ section.id }} .image-collection-grid__viewport--carousel{overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;-webkit-overflow-scrolling:touch;}
    #ImageCollectionGrid-{{ section.id }} .image-collection-grid__viewport--carousel::-webkit-scrollbar{display:none;}
    #ImageCollectionGrid-{{ section.id }} .image-collection-grid__viewport--carousel .image-collection-grid__items{display:flex;gap:var(--icg-gap);}
    #ImageCollectionGrid-{{ section.id }} .image-collection-grid__viewport--carousel .image-collection-grid__item{flex:0 0 calc((100% - (var(--icg-mobile-cols) - 1) * var(--icg-gap)) / var(--icg-mobile-cols));scroll-snap-align:start;}
    #ImageCollectionGrid-{{ section.id }} .image-collection-grid__nav{display:flex;justify-content:center;gap:12px;margin-top:16px;}
    #ImageCollectionGrid-{{ section.id }} .image-collection-grid__nav-button{width:36px;height:36px;border:1px solid currentColor;background:transparent;color:inherit;border-radius:0;cursor:pointer;font-size:25px;line-height:1;}
  }
  @media(prefers-reduced-motion:reduce){#ImageCollectionGrid-{{ section.id }} *{transition:none!important;scroll-behavior:auto;}}
</style>
<script>
  (() => {
    const root=document.getElementById('ImageCollectionGrid-{{ section.id }}');
    if(!root||root.dataset.navReady)return;
    root.dataset.navReady='1';
    const viewport=root.querySelector('[data-grid-viewport]');
    const items=[...root.querySelectorAll('.image-collection-grid__item')];
    if(!viewport||items.length<2)return;
    const navigate=(dir)=>{
      const distance=items[1].offsetLeft-items[0].offsetLeft;
      viewport.scrollBy({left:distance*dir,behavior:'smooth'});
    };
    root.querySelector('[data-grid-prev]')?.addEventListener('click',()=>navigate(-1));
    root.querySelector('[data-grid-next]')?.addEventListener('click',()=>navigate(1));
  })();
</script>
{% schema %}
{
  "name":"珠宝系列图片展示",
  "tag":"section",
  "disabled_on":{"groups":["header","footer"]},
  "settings":[
    {"type":"text","id":"heading","label":"标题","default":"Explore Our Custom Jewelry Collections"},
    {"type":"select","id":"heading_preset","label":"标题字号预设","options":[{"value":"h1","label":"H1"},{"value":"h2","label":"H2"},{"value":"h3","label":"H3"},{"value":"h4","label":"H4"},{"value":"h5","label":"H5"},{"value":"h6","label":"H6"}],"default":"h2"},
    {"type":"richtext","id":"description","label":"介绍文字","default":"<p>Discover Craftaurum's custom jewelry categories, combining thoughtful design and quality craftsmanship for your next collection.</p>"},
    {"type":"select","id":"body_preset","label":"正文字号预设","options":[{"value":"h1","label":"H1"},{"value":"h2","label":"H2"},{"value":"h3","label":"H3"},{"value":"h4","label":"H4"},{"value":"h5","label":"H5"},{"value":"h6","label":"H6"}],"default":"h4"},
    {"type":"select","id":"card_title_preset","label":"卡片标题字号预设","options":[{"value":"h1","label":"H1"},{"value":"h2","label":"H2"},{"value":"h3","label":"H3"},{"value":"h4","label":"H4"},{"value":"h5","label":"H5"},{"value":"h6","label":"H6"}],"default":"h3"},
    {"type":"header","content":"移动端布局"},
    {"type":"range","id":"mobile_columns","label":"每行显示数量","min":1,"max":4,"step":1,"default":2},
    {"type":"select","id":"mobile_layout","label":"展示方式","options":[{"value":"grid","label":"网格"},{"value":"carousel","label":"轮播"}],"default":"grid"},
    {"type":"header","content":"图片效果"},
    {"type":"range","id":"overlay_opacity","label":"默认蒙层深度","min":0,"max":90,"step":5,"unit":"%","default":25},
    {"type":"range","id":"hover_overlay_opacity","label":"悬停蒙层深度","min":0,"max":90,"step":5,"unit":"%","default":50},
    {"type":"range","id":"gap","label":"图片间距","min":0,"max":40,"step":2,"unit":"px","default":16},
    {"type":"range","id":"padding_top","label":"上间距","min":0,"max":100,"step":4,"unit":"px","default":40},
    {"type":"range","id":"padding_bottom","label":"下间距","min":0,"max":100,"step":4,"unit":"px","default":40}
  ],
  "blocks":[{"type":"card","name":"图片卡片","settings":[{"type":"text","id":"title","label":"标题","default":"Custom Jewelry"},{"type":"image_picker","id":"image","label":"图片"},{"type":"collection","id":"collection","label":"产品系列"},{"type":"url","id":"link","label":"自定义链接（优先）"}]}],
  "max_blocks":24,
  "presets":[{"name":"珠宝系列图片展示","blocks":[{"type":"card"},{"type":"card"},{"type":"card"},{"type":"card"},{"type":"card"}]}]
}
{% endschema %}
