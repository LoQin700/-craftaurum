{% comment %}
  Generic image collection display.
  Desktop: 1–6 columns, grid or horizontal carousel.
  Mobile: 1–4 columns, grid or horizontal carousel.
{% endcomment %}

{% if section.settings.background_color != blank %}
  {% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}
{% endif %}

<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>

<div
  id="ImageCollectionGrid-{{ section.id }}"
  class="section section--{{ section.settings.section_width | default: 'page-width' }} spacing-style ca-collection{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    --padding-block-start: {{ section.settings.padding_top }}px;
    --padding-block-end: {{ section.settings.padding_bottom }}px;
    --ca-collection-gap: {{ section.settings.gap }}px;
    --ca-desktop-columns: {{ section.settings.desktop_columns }};
    --ca-mobile-columns: {{ section.settings.mobile_columns }};
    --ca-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --ca-collection-heading-size: {{ section.settings.heading_size | default: 35 }}px;
    --ca-collection-heading-size-mobile: {{ section.settings.mobile_heading_size | default: 35 }}px;
    --ca-collection-body-size: {{ section.settings.body_size | default: 16 }}px;
    --ca-collection-body-size-mobile: {{ section.settings.mobile_body_size | default: 16 }}px;
    --ca-card-type-size: {{ section.settings.card_title_size | default: 18 }}px;
    --ca-card-type-size-mobile: {{ section.settings.mobile_card_title_size | default: 18 }}px;
  "
>
  <div class="ca-collection__inner" data-ca-reveal="{{ section.settings.animation_style | default: 'fade-up' }}">
    {% if section.settings.heading != blank or section.settings.description != blank %}
      <header class="ca-collection__intro">
        {% if section.settings.heading != blank %}
          <h2 class="ca-collection__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="ca-collection__description rte">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </header>
    {% endif %}

    <div class="ca-collection__grid{% if section.settings.desktop_layout == 'carousel' %} ca-collection__grid--desktop-carousel{% endif %}{% if section.settings.mobile_layout == 'carousel' %} ca-collection__grid--mobile-carousel{% endif %}">
      {% for block in section.blocks %}
        {% render 'craftaurum-collection-card',
          block: block,
          attributes: true
        %}
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .ca-collection__inner {
    min-width: 0;
  }

  .ca-collection__heading { font-size: var(--ca-collection-heading-size); line-height: 1.08; }
  .ca-collection__description { font-size: var(--ca-collection-body-size); line-height: 1.6; }

  .ca-collection__intro {
    text-align: center;
    max-width: 980px;
    margin: 0 auto 28px;
  }

  .ca-collection__heading {
    margin: 0 0 14px;
  }

  .ca-collection__description :is(p, ul, ol) {
    font-size: inherit;
    line-height: inherit;
  }

  .ca-collection__description p {
    margin: 0;
  }

  .ca-collection__grid {
    display: grid;
    grid-template-columns: repeat(var(--ca-desktop-columns, 3), minmax(0, 1fr));
    gap: var(--ca-collection-gap, 16px);
  }

  .ca-collection__grid > .ca-collection__item {
    min-width: 0;
  }

  .ca-collection__grid--desktop-carousel {
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .ca-collection__grid--desktop-carousel::-webkit-scrollbar {
    display: none;
  }

  .ca-collection__grid--desktop-carousel > .ca-collection__item {
    flex: 0 0 calc(
      (100% - (var(--ca-desktop-columns, 3) - 1) * var(--ca-collection-gap, 16px))
      / var(--ca-desktop-columns, 3)
    );
    scroll-snap-align: start;
  }

  .ca-collection__card {
    display: block;
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    isolation: isolate;
    background: rgb(var(--color-foreground-rgb) / 0.06);
    color: var(--color-background);
    text-decoration: none;
  }

  .ca-collection__image,
  .ca-collection__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ca-collection__placeholder {
    background: rgb(var(--color-foreground-rgb) / 0.04);
    color: rgb(var(--color-foreground-rgb) / 0.18);
  }

  .ca-collection__shade {
    position: absolute;
    inset: 0;
    background: var(--color-foreground);
    opacity: var(--ca-overlay, .25);
    pointer-events: none;
  }


  .ca-collection__card-title {
    position: absolute;
    z-index: 2;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 12px;
    color: #fff;
    pointer-events: none;
    overflow-wrap: anywhere;
    font-size: var(--ca-card-type-size);
  }


  .ca-collection__card:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  @media screen and (max-width: 749px) {
    .ca-collection__intro {
      margin-bottom: 20px;
    }

    .ca-collection__grid,
    .ca-collection__grid--desktop-carousel {
      display: grid;
      grid-template-columns: repeat(var(--ca-mobile-columns, 2), minmax(0, 1fr));
      overflow: visible;
      scroll-snap-type: none;
    }

    .ca-collection__grid--mobile-carousel {
      display: flex;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .ca-collection__grid--mobile-carousel::-webkit-scrollbar {
      display: none;
    }

    .ca-collection__grid--mobile-carousel > .ca-collection__item {
      flex: 0 0 calc(
        (100% - (var(--ca-mobile-columns, 2) - 1) * var(--ca-collection-gap, 16px))
        / var(--ca-mobile-columns, 2)
      );
      scroll-snap-align: start;
    }

    .ca-collection__card-title {
      font-size: clamp(11px, 3.8vw, var(--ca-card-type-size));
      padding: 5px;
    }
  }


  @media screen and (max-width: 749px) {
    .ca-collection__heading { font-size: var(--ca-collection-heading-size-mobile); }
    .ca-collection__description { font-size: var(--ca-collection-body-size-mobile); }
    .ca-collection__card-title { font-size: var(--ca-card-type-size-mobile); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "分类图片展示",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {"type":"header","content":"基础设置"},
    {
      "type": "select",
      "id": "section_width",
      "label": "内容宽度",
      "options": [
        {
          "value": "page-width",
          "label": "页面宽度"
        },
        {
          "value": "full-width",
          "label": "全宽"
        }
      ],
      "default": "page-width"
    },
    {"type":"header","content":"内容设置"},
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Explore Our Custom Jewelry Collections"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "正文",
      "default": "<p>Discover Craftaurum's custom jewelry categories, combining thoughtful design and quality craftsmanship for your next collection.</p>"
    },
    {"type":"header","content":"图片设置"},
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "默认蒙层深度",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 25
    },
    {"type":"header","content":"布局与交互"},
    {
      "type": "range",
      "id": "gap",
      "label": "图片间距",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {"type":"header","content":"电脑端布局"},
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "每行显示数量",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "展示方式",
      "options": [
        {
          "value": "grid",
          "label": "网格"
        },
        {
          "value": "carousel",
          "label": "轮播"
        }
      ],
      "default": "grid"
    },
    {"type":"header","content":"移动端布局"},
    {
      "type": "range",
      "id": "mobile_columns",
      "label": "每行显示数量",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "展示方式",
      "options": [
        {
          "value": "grid",
          "label": "网格"
        },
        {
          "value": "carousel",
          "label": "轮播"
        }
      ],
      "default": "grid"
    },
    {"type":"header","content":"电脑端字号"},
    {"type":"range","id":"heading_size","label":"标题字号","min":24,"max":72,"step":1,"unit":"px","default":35},
    {"type":"range","id":"body_size","label":"正文字号","min":12,"max":24,"step":1,"unit":"px","default":16},
    {"type":"range","id":"card_title_size","label":"卡片标题字号","min":14,"max":30,"step":1,"unit":"px","default":18},
    {"type":"header","content":"移动端字号"},
    {"type":"range","id":"mobile_heading_size","label":"标题字号","min":24,"max":72,"step":1,"unit":"px","default":35},
    {"type":"range","id":"mobile_body_size","label":"正文字号","min":12,"max":24,"step":1,"unit":"px","default":16},
    {"type":"range","id":"mobile_card_title_size","label":"卡片标题字号","min":14,"max":30,"step":1,"unit":"px","default":18},
    {"type":"header","content":"颜色设置"},
    {
      "type": "color",
      "id": "background_color",
      "label": "背景颜色",
      "default": "#F8F7F4"
    },
    {"type":"header","content":"其它设置"},
    {"type":"paragraph","content":"入场动画与区块上下间距"},
    {"type":"select","id":"animation_style","label":"入场动画","options":[{"value":"fade-up","label":"Fade Up"},{"value":"fade-in","label":"Fade In"},{"value":"soft-zoom","label":"Soft Zoom"}],"default":"fade-up"},
    {
      "type": "range",
      "id": "padding_top",
      "label": "上间距",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下间距",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "图片卡片",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "标题",
          "default": "Custom Jewelry"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "图片"
        },
        {
          "type": "url",
          "id": "link",
          "label": "链接"
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "分类图片展示",
      "blocks": [
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        }
      ]
    }
  ]
}
{% endschema %}
