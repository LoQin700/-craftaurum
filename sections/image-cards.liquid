{% liquid
  assign carousel_desktop = false
  assign carousel_mobile = false
  if section.settings.mobile_layout == 'carousel'
    assign carousel_mobile = true
  endif
  assign has_scroll_controls = false
  if section.blocks.size > 1
    if carousel_desktop or carousel_mobile
      assign has_scroll_controls = true
    endif
  endif
%}
{% if has_scroll_controls %}
  {{ 'craftaurum-scroll-controls.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'craftaurum-scroll-controls.js' | asset_url }}" defer></script>
{% endif %}
{% liquid
  assign ratio = '4 / 3'
  if section.settings.image_ratio == 'wide'
    assign ratio = '16 / 9'
  elsif section.settings.image_ratio == 'square'
    assign ratio = '1 / 1'
  elsif section.settings.image_ratio == 'portrait'
    assign ratio = '4 / 5'
  endif
%}

<section
  id="ImageCards-{{ section.id }}"
  class="ca-image-cards section section--{{ section.settings.section_width }}"
  style="
    --ca-image-cards-bg: {{ section.settings.background_color }};
    --ca-image-cards-text: {{ section.settings.text_color }};
    --ca-image-cards-heading-color: {{ section.settings.heading_color | default: '#17191A' }};
    --ca-image-cards-body-color: {{ section.settings.body_color | default: '#17191A' }};
    --ca-image-cards-card-body-color: {{ section.settings.card_body_color | default: '#FFFFFF' }};
    --ca-image-cards-accent: {{ section.settings.accent_color }};
    --ca-image-cards-gap: {{ section.settings.gap }}px;
    --ca-image-cards-cols: {{ section.settings.desktop_columns }};
    --ca-image-cards-mobile-cols: {{ section.settings.mobile_columns }};
    --ca-image-cards-ratio: {{ ratio }};
    --ca-image-cards-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --ca-image-cards-content-padding: {{ section.settings.content_padding }}px;
    --ca-image-cards-padding-top: {{ section.settings.padding_top }}px;
    --ca-image-cards-padding-bottom: {{ section.settings.padding_bottom }}px;
    --ca-image-cards-heading-size: {{ section.settings.heading_size | default: 35 }}px;
    --ca-image-cards-heading-size-mobile: {{ section.settings.mobile_heading_size | default: 35 }}px;
    --ca-image-cards-body-size: {{ section.settings.body_size | default: 16 }}px;
    --ca-image-cards-body-size-mobile: {{ section.settings.mobile_body_size | default: 16 }}px;
    --ca-image-cards-card-title-size: {{ section.settings.card_title_size | default: 22 }}px;
    --ca-image-cards-card-title-size-mobile: {{ section.settings.mobile_card_title_size | default: 22 }}px;
    --ca-image-cards-card-body-size: {{ section.settings.card_body_size | default: 15 }}px;
    --ca-image-cards-card-body-size-mobile: {{ section.settings.mobile_card_body_size | default: 15 }}px;
  "
>
  <div class="ca-image-cards__surface">
    <div class="ca-image-cards__inner" data-ca-reveal="{{ section.settings.animation_style | default: 'fade-up' }}">
      {% if section.settings.heading != blank or section.settings.description != blank %}
        <header class="ca-image-cards__intro">
          {% if section.settings.heading != blank %}
            <h2 class="ca-image-cards__heading">{{ section.settings.heading | escape }}</h2>
          {% endif %}
          {% if section.settings.description != blank %}
            <div class="ca-image-cards__description rte">
              {{ section.settings.description }}
            </div>
          {% endif %}
        </header>
      {% endif %}

      <div class="ca-carousel-stage">
      <div class="ca-image-cards__grid ca-image-cards__grid--{{ section.settings.layout_style }} ca-image-cards__grid--mobile-cols-{{ section.settings.mobile_columns }}{% if section.settings.mobile_layout == 'carousel' %} ca-image-cards__grid--mobile-carousel{% endif %}">
        {% for block in section.blocks %}
          <article
            class="ca-image-card ca-image-card--h-{{ block.settings.horizontal_alignment }} ca-image-card--v-{{ block.settings.vertical_position }}"
            {{ block.shopify_attributes }}
          >
            <div class="ca-image-card__media">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 1800
                  | image_tag:
                    loading: 'lazy',
                    class: 'ca-image-card__image',
                    widths: '360,520,720,960,1200,1600,1800',
                    sizes: '(min-width: 990px) 33vw, 88vw'
                }}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'ca-image-card__placeholder' }}
              {% endif %}
            </div>

            <span class="ca-image-card__overlay" aria-hidden="true"></span>

            <div class="ca-image-card__content">
              {% if block.settings.title != blank %}
                <h3 class="ca-image-card__title">{{ block.settings.title | escape }}</h3>
              {% endif %}
              {% if block.settings.description != blank %}
                <div class="ca-image-card__text rte">
                  {{ block.settings.description }}
                </div>
              {% endif %}
            </div>

            {% if block.settings.link != blank %}
              <a
                class="ca-image-card__link"
                href="{{ block.settings.link }}"
                aria-label="{{ block.settings.title | escape }}"
              ></a>
            {% endif %}
          </article>
        {% endfor %}
      </div>
      {% if has_scroll_controls %}
        {% render 'craftaurum-scroll-controls', track_selector: '.ca-image-cards__grid', desktop: carousel_desktop, mobile: carousel_mobile , media_selector: '.ca-image-card__media' %}
      {% endif %}
      </div> <!-- /ca-carousel-stage -->
    </div>
  </div>
</section>

{% stylesheet %}
  .ca-image-cards {
    color: var(--ca-image-cards-text);
  }

  .ca-image-cards::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--ca-image-cards-bg);
    pointer-events: none;
  }

  .ca-image-cards__surface {
    position: relative;
    z-index: 1;
    width: 100%;
    background: transparent;
  }

  .ca-image-cards__inner {
    padding-block: var(--ca-image-cards-padding-top) var(--ca-image-cards-padding-bottom);
  }

  .ca-image-cards__intro {
    max-width: 860px;
    margin: 0 auto 36px;
    text-align: center;
  }

  .ca-image-cards__heading {
    color: var(--ca-image-cards-heading-color);
    margin: 0 0 12px;
    font-size: var(--ca-image-cards-heading-size);
    line-height: 1.08;
  }

  .ca-image-cards__description { color: var(--ca-image-cards-body-color); font-size:var(--ca-image-cards-body-size); line-height:1.6; }
  .ca-image-cards__description :is(p,ul,ol) { color:inherit; font-size:inherit; line-height:inherit; }

  .ca-image-cards__description p,
  .ca-image-card__text p {
    margin: 0;
  }

  .ca-image-cards__grid {
    display: grid;
    grid-template-columns: repeat(var(--ca-image-cards-cols), minmax(0, 1fr));
    gap: var(--ca-image-cards-gap);
  }

  .ca-image-cards__grid--showcase {
    grid-template-columns: repeat(12, minmax(0, 1fr));
  }

  .ca-image-cards__grid--showcase > .ca-image-card {
    grid-column: span 4;
  }

  .ca-image-cards__grid--showcase > .ca-image-card:nth-child(4),
  .ca-image-cards__grid--showcase > .ca-image-card:nth-child(5) {
    grid-column: span 6;
    aspect-ratio: 16 / 9;
  }

  .ca-image-card {
    position: relative;
    min-width: 0;
    aspect-ratio: var(--ca-image-cards-ratio);
    overflow: hidden;
    isolation: isolate;
    color: var(--ca-image-cards-text);
    background: #f4f4f4;
  }

  .ca-image-card__media,
  .ca-image-card__image,
  .ca-image-card__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ca-image-card__image,
  .ca-image-card__placeholder {
    display: block;
    object-fit: cover;
  }

  .ca-image-card__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to top, rgba(0,0,0,.88), rgba(0,0,0,.34) 42%, rgba(0,0,0,0) 78%);
    opacity: var(--ca-image-cards-overlay);
    pointer-events: none;
  }

  .ca-image-card__content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    padding: var(--ca-image-cards-content-padding);
    pointer-events: none;
  }

  .ca-image-card--h-left .ca-image-card__content {
    align-items: flex-start;
    text-align: left;
  }

  .ca-image-card--h-center .ca-image-card__content {
    align-items: center;
    text-align: center;
  }

  .ca-image-card--h-right .ca-image-card__content {
    align-items: flex-end;
    text-align: right;
  }

  .ca-image-card--v-top .ca-image-card__content {
    justify-content: flex-start;
  }

  .ca-image-card--v-center .ca-image-card__content {
    justify-content: center;
  }

  .ca-image-card--v-bottom .ca-image-card__content {
    justify-content: flex-end;
  }

  .ca-image-card__title {
    margin: 0 0 8px;
    color: var(--ca-image-cards-text);
    font-size:var(--ca-image-cards-card-title-size);
    line-height:1.2;
  }

  .ca-image-card__text {
    max-width: 42ch;
    color: var(--ca-image-cards-card-body-color);
    font-size:var(--ca-image-cards-card-body-size);
    line-height:1.6;
  }

  .ca-image-card__link {
    position: absolute;
    inset: 0;
    z-index: 4;
  }

  .ca-image-card__link:focus-visible {
    outline: 2px solid var(--ca-image-cards-accent);
    outline-offset: -5px;
  }


  @media screen and (max-width: 749px) {
    .ca-image-cards__intro {
      text-align: left;
      margin-bottom: 24px;
    }

    .ca-image-cards__grid,
    .ca-image-cards__grid--showcase {
      grid-template-columns: repeat(var(--ca-image-cards-mobile-cols), minmax(0, 1fr));
    }

    .ca-image-cards__grid--showcase > .ca-image-card,
    .ca-image-cards__grid--showcase > .ca-image-card:nth-child(4),
    .ca-image-cards__grid--showcase > .ca-image-card:nth-child(5) {
      grid-column: auto;
      aspect-ratio: var(--ca-image-cards-ratio);
    }

    .ca-image-cards__grid--mobile-carousel {
      display: flex;
      overflow-x: auto;
      gap: var(--ca-image-cards-gap);
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .ca-image-cards__grid--mobile-carousel::-webkit-scrollbar {
      display: none;
    }

    .ca-image-cards__grid--mobile-carousel .ca-image-card {
      flex: 0 0 86%;
      scroll-snap-align: start;
    }

    .ca-image-cards__grid--mobile-carousel.ca-image-cards__grid--mobile-cols-2 .ca-image-card {
      flex-basis: calc((100% - var(--ca-image-cards-gap)) / 2);
    }

    .ca-image-card__content {
      padding: min(var(--ca-image-cards-content-padding), 20px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ca-image-card__image,
    .ca-image-card__overlay {
      transition: none;
    }
  }

  @media screen and (max-width: 749px) {
    .ca-image-cards__heading { font-size: var(--ca-image-cards-heading-size-mobile); }
    .ca-image-cards__description { font-size: var(--ca-image-cards-body-size-mobile); }
    .ca-image-card__title { font-size: var(--ca-image-cards-card-title-size-mobile); }
    .ca-image-card__text { font-size: var(--ca-image-cards-card-body-size-mobile); }
  }
{% endstylesheet %}

{% schema %}
