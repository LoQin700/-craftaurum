{% comment %}
  通用图文介绍。背景铺满，内容宽度可选，图片与文字垂直居中。
{% endcomment %}
{% liquid
  assign content_width = section.settings.section_width | default: 'page-width'
  assign background_color = section.settings.background_color | default: '#FFFFFF'
  assign text_color = section.settings.text_color | default: '#17191A'
  assign accent_color = section.settings.accent_color | default: '#C7A85E'
  assign padding_top = section.settings.padding_top | default: 32
  assign padding_bottom = section.settings.padding_bottom | default: 32
  assign image_position = section.settings.image_position | default: 'right'
  assign image_ratio = section.settings.image_ratio | default: 'landscape'
  assign ratio = '4 / 3'
  if image_ratio == 'wide'
    assign ratio = '16 / 9'
  elsif image_ratio == 'square'
    assign ratio = '1 / 1'
  endif
%}
<section
  id="ImageTextFeature-{{ section.id }}"
  class="section section--full-width ca-feature"
  style="
    --ca-feature-background: {{ background_color }};
    --ca-feature-text: {{ text_color }};
    --ca-feature-accent: {{ accent_color }};
    --ca-feature-ratio: {{ ratio }};
    --ca-feature-padding-top: {{ padding_top }}px;
    --ca-feature-padding-bottom: {{ padding_bottom }}px;
    --ca-feature-gap: 5%;
    --ca-feature-heading-size: {{ section.settings.heading_size | default: 40 }}px;
    --ca-feature-heading-size-mobile: {{ section.settings.mobile_heading_size | default: 25 }}px;
    --ca-feature-subtitle-size: {{ section.settings.subtitle_size | default: 12 }}px;
    --ca-feature-subtitle-size-mobile: {{ section.settings.mobile_subtitle_size | default: 12 }}px;
    --ca-feature-body-size: {{ section.settings.body_size | default: 16 }}px;
    --ca-feature-body-size-mobile: {{ section.settings.mobile_body_size | default: 14 }}px;
  "
>
  <div class="ca-feature__surface">
    <div class="ca-feature__inner ca-feature__inner--{{ content_width }}" data-ca-reveal="{{ section.settings.animation_style | default: 'fade-up' }}">
      {% if section.settings.heading_position != 'content' %}
        <header class="ca-feature__header">
          {% if section.settings.heading != blank %}
            {% if section.settings.heading_tag == 'h1' %}
              <h1 class="ca-feature__heading">{{ section.settings.heading | escape }}</h1>
            {% else %}
              <h2 class="ca-feature__heading">{{ section.settings.heading | escape }}</h2>
            {% endif %}
          {% endif %}
          {% if section.settings.subtitle != blank %}
            <p class="ca-feature__subtitle">{{ section.settings.subtitle | escape }}</p>
          {% endif %}
          {% if section.settings.show_buttons != false and section.settings.top_label != blank %}
            <div class="ca-feature__tag">
              {% render 'craftaurum-cta',
                label: section.settings.top_label,
                link: section.settings.top_url,
                style_class: section.settings.top_button_style,
                class: 'ca-feature__top-cta',
                static_label: true
              %}
            </div>
          {% endif %}
        </header>
      {% endif %}

      <div class="ca-feature__columns{% if image_position == 'left' %} ca-feature__columns--reverse{% endif %}">
        <div class="ca-feature__copy">
          {% if section.settings.heading_position == 'content' %}
            {% if section.settings.subtitle != blank %}
              <p class="ca-feature__subtitle">{{ section.settings.subtitle | escape }}</p>
            {% endif %}
            {% if section.settings.heading != blank %}
              {% if section.settings.heading_tag == 'h1' %}
              <h1 class="ca-feature__heading">{{ section.settings.heading | escape }}</h1>
            {% else %}
              <h2 class="ca-feature__heading">{{ section.settings.heading | escape }}</h2>
            {% endif %}
            {% endif %}
          {% endif %}
          {% if section.settings.body != blank %}
            <div class="ca-feature__body rte">{{ section.settings.body }}</div>
          {% endif %}
          {% if section.settings.show_buttons != false and section.settings.cta_label != blank %}
            <div class="ca-feature__bottom-cta">
              {% render 'craftaurum-cta',
                label: section.settings.cta_label,
                link: section.settings.cta_url,
                style_class: section.settings.cta_button_style,
                class: 'ca-feature__action',
                static_label: true
              %}
            </div>
          {% endif %}
        </div>

        <div class="ca-feature__media">
          {% if section.settings.image != blank %}
            {{
              section.settings.image
              | image_url: width: 1800
              | image_tag:
                loading: 'lazy',
                class: 'ca-feature__image',
                widths: '360,540,720,960,1200,1500,1800',
                sizes: '(min-width: 1200px) 46vw, (min-width: 750px) 48vw, 100vw'
            }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'ca-feature__placeholder' }}
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .ca-feature__surface {
    width:100%;
    background:var(--ca-feature-background);
    color:var(--ca-feature-text);
  }
  .ca-feature__inner {
    min-width:0;
    padding-block:var(--ca-feature-padding-top) var(--ca-feature-padding-bottom);
  }
  .ca-feature__inner--page-width {
    width:var(--full-page-grid-central-column-width);
    margin-inline:auto;
  }
  .ca-feature__inner--full-width {
    width:100%;
    padding-inline:max(var(--page-margin),24px);
  }
  .ca-feature__header { text-align:center; margin:0 auto 38px; }
  .ca-feature__heading { margin:0 0 16px; color:inherit; font-size:var(--ca-feature-heading-size); line-height:1.08; }
  .ca-feature__subtitle {
    margin:0 0 16px;
    color:var(--ca-feature-accent);
    letter-spacing:.12em;
    text-transform:uppercase;
    font-size:var(--ca-feature-subtitle-size);
  }
  .ca-feature__tag { display:flex; justify-content:center; }
  .ca-feature__top-cta { min-width:min(300px,100%); }

  .ca-feature__columns {
    display:grid;
    grid-template-columns:minmax(0,1fr) minmax(0,1fr);
    align-items:center;
    gap:var(--ca-feature-gap,48px);
  }
  .ca-feature__copy {
    min-width:0;
    padding-block:4px;
    align-self:center;
  }
  .ca-feature__media {
    width:100%;
    min-width:0;
    aspect-ratio:var(--ca-feature-ratio);
    overflow:hidden;
    align-self:center;
  }
  .ca-feature__body { max-width:100%; font-size:var(--ca-feature-body-size); line-height:1.6; }
  .ca-feature__body :is(p,ul,ol) { font-size:inherit; line-height:inherit; }
  .ca-feature__body p { margin:0 0 1.35em; }
  .ca-feature__body p:last-child { margin-bottom:0; }
  .ca-feature__bottom-cta { display:flex; justify-content:flex-start; margin-top:28px; }
  .ca-feature__action { min-width:min(220px,100%); }

  .ca-feature__image,
  .ca-feature__placeholder { display:block; width:100%; height:100%; object-fit:cover; }
  .ca-feature__placeholder {
    color:rgb(var(--color-foreground-rgb) / .2);
    background-color:rgb(var(--color-foreground-rgb) / .05);
  }
  .ca-feature__columns--reverse .ca-feature__media { grid-column:1; grid-row:1; }
  .ca-feature__columns--reverse .ca-feature__copy { grid-column:2; grid-row:1; }

  @media screen and (max-width:749px) {
    .ca-feature__inner--full-width { padding-inline:18px; }
    .ca-feature__header { margin-bottom:24px; }
    .ca-feature__columns { display:flex; flex-direction:column; gap:22px; }
    .ca-feature__columns--reverse { flex-direction:column; }
    .ca-feature__columns--reverse .ca-feature__media { order:0; }
    .ca-feature__columns--reverse .ca-feature__copy { order:1; }
    .ca-feature__copy,
    .ca-feature__media { width:100%; }
    .ca-feature__bottom-cta { margin-top:24px; }
  }

  @media screen and (max-width: 749px) {
    .ca-feature__heading { font-size: var(--ca-feature-heading-size-mobile); }
    .ca-feature__subtitle { font-size: var(--ca-feature-subtitle-size-mobile); }
    .ca-feature__body { font-size: var(--ca-feature-body-size-mobile); }
  }

  /* Image-only hover: no layout shifts or added scripts. */
  .ca-feature__image { transition: transform .48s cubic-bezier(.2,.7,.2,1); transform: scale(1); }
  @media (hover: hover) and (pointer: fine) {
    .ca-feature__media:hover .ca-feature__image { transform: scale(1.045); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ca-feature__image { transition: none; }
  }
{% endstylesheet %}

{% schema %}
