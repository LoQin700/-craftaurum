{% comment %}
  Craftaurum image + copy. Preserves existing section settings and instance IDs.
  Layout follows Horizon section-width / spacing-style / native type presets.
  CTA output always uses snippets/craftaurum-cta.liquid.
{% endcomment %}
<div
  id="ImageTextFeature-{{ section.id }}"
  class="section section--{{ section.settings.section_width | default: 'page-width' }} spacing-style ca-feature"
  style="
    --padding-block-start: {{ section.settings.padding_top }}px;
    --padding-block-end: {{ section.settings.padding_bottom }}px;
    --ca-feature-gap: 5%;
    --ca-feature-background: {{ section.settings.background_color }};
    --ca-feature-text: {{ section.settings.text_color }};
    --ca-feature-accent: {{ section.settings.accent_color }};
    --ca-feature-ratio: {% case section.settings.image_ratio %}{% when 'wide' %}16 / 9{% when 'square' %}1 / 1{% else %}4 / 3{% endcase %};
  "
>
  <div class="ca-feature__surface"><div class="ca-feature__inner">
    {% if section.settings.heading_position != 'content' %}
      <header class="ca-feature__header">
        {% if section.settings.heading != blank %}
          <h2 class="ca-feature__heading {{ section.settings.heading_preset | default: 'h2' }}">
            {{ section.settings.heading | escape }}
          </h2>
        {% endif %}
        {% if section.settings.subtitle != blank %}
          <p class="ca-feature__subtitle {{ section.settings.subtitle_preset | default: 'h3' }}">{{ section.settings.subtitle | escape }}</p>
        {% endif %}
        {% if section.settings.top_label != blank %}
        <div class="ca-feature__tag">
          {% render 'craftaurum-cta',
            label: section.settings.top_label,
            link: section.settings.top_url,
            style_class: section.settings.top_button_style,
            class: 'ca-feature__top-cta',
            static_label: true
          %}
        </div>
        {% endif %}
      </header>
    {% endif %}

    <div class="ca-feature__columns{% if section.settings.image_position == 'left' %} ca-feature__columns--reverse{% endif %}">
      <div class="ca-feature__copy">
        {% if section.settings.heading_position == 'content' %}
          {% if section.settings.subtitle != blank %}
            <p class="ca-feature__subtitle {{ section.settings.subtitle_preset | default: 'h3' }}">{{ section.settings.subtitle | escape }}</p>
          {% endif %}
          {% if section.settings.heading != blank %}
            <h2 class="ca-feature__heading {{ section.settings.heading_preset | default: 'h2' }}">{{ section.settings.heading | escape }}</h2>
          {% endif %}
        {% endif %}
        {% if section.settings.body != blank %}
          <div class="ca-feature__body rte {{ section.settings.body_preset | default: 'h5' }}">
            {{ section.settings.body }}
          </div>
        {% endif %}
        {% if section.settings.cta_label != blank and section.settings.cta_url != blank %}
          <div class="ca-feature__bottom-cta">
            {% render 'craftaurum-cta',
              label: section.settings.cta_label,
              link: section.settings.cta_url,
              style_class: section.settings.cta_button_style,
              class: 'ca-feature__action'
            %}
          </div>
        {% endif %}
      </div>
      <div class="ca-feature__media">
        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: 1800
            | image_tag:
              loading: 'lazy',
              class: 'ca-feature__image',
              widths: '360, 540, 720, 960, 1200, 1500, 1800',
              sizes: '(min-width: 1200px) 46vw, (min-width: 750px) 48vw, 100vw'
          }}
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'ca-feature__placeholder' }}
        {% endif %}
      </div>
    </div>
  </div></div>
</div>

{% stylesheet %}
  .ca-feature__surface { width: 100%; background: var(--ca-feature-background, #FFFFFF); color: var(--ca-feature-text, #17191A); }
  .ca-feature .ca-feature__inner { min-width: 0; }
  .ca-feature__subtitle { color: var(--ca-feature-accent, #C7A85E); }
  .ca-feature__header { text-align: center; margin: 0 auto 38px; }
  .ca-feature__heading { margin: 0 0 16px; }
  .ca-feature__subtitle { margin: 0 0 16px; }
  .ca-feature__tag { display: flex; justify-content: center; }
  .ca-feature__top-cta { min-width: min(300px, 100%); }
  .ca-feature__columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--ca-feature-gap, 48px);
  }
  .ca-feature__copy {
    min-width: 0;
    padding-block: 4px;
    align-self: center;
  }
  .ca-feature__media {
    align-self: center;
  }
  .ca-feature__body { max-width: 100%; }
  .ca-feature__body :is(p, ul, ol) { font-size: inherit; line-height: inherit; }
  .ca-feature__body p { margin: 0 0 1.35em; }
  .ca-feature__body p:last-child { margin-bottom: 0; }
  .ca-feature__bottom-cta { display: flex; justify-content: center; margin-top: 32px; }
  .ca-feature__action { min-width: min(280px, 100%); }
  .ca-feature__media { width: 100%; min-width: 0; aspect-ratio: var(--ca-feature-ratio, 4 / 3); overflow: hidden; }
  .ca-feature__image, .ca-feature__placeholder {
    display: block; width: 100%; height: 100%; object-fit: cover;
  }
  .ca-feature__placeholder {
    color: rgb(var(--color-foreground-rgb) / 0.2);
    background-color: rgb(var(--color-foreground-rgb) / 0.05);
  }
  .ca-feature__columns--reverse .ca-feature__media { grid-column: 1; grid-row: 1; }
  .ca-feature__columns--reverse .ca-feature__copy { grid-column: 2; grid-row: 1; }
  @media screen and (max-width: 749px) {
    .ca-feature__header { margin-bottom: 24px; }
    .ca-feature__columns { display: flex; flex-direction: column; gap: 22px; }
    .ca-feature__columns--reverse { flex-direction: column; }
    .ca-feature__columns--reverse .ca-feature__media { order: 0; }
    .ca-feature__columns--reverse .ca-feature__copy { order: 1; }
    .ca-feature__copy, .ca-feature__media { width: 100%; }
    .ca-feature__bottom-cta { margin-top: 24px; }
  }
{% endstylesheet %}
