{% comment %}
  Logo image carousel, powered by Horizon slideshow-component.
  Existing block image IDs and setting IDs remain intact.
{% endcomment %}
<div
  id="BrandPartners-{{ section.id }}"
  class="section section--{{ section.settings.section_width | default: 'page-width' }} spacing-style ca-logos"
  style="
    --padding-block-start: {{ section.settings.padding_top }}px;
    --padding-block-end: {{ section.settings.padding_bottom }}px;
    --ca-logo-gap: 10px;
    --ca-logo-mobile-columns: {{ section.settings.mobile_columns | default: 1 }};
    --ca-logo-heading-size: {{ section.settings.heading_size | default: 35 }}px;
    --ca-logo-heading-size-mobile: {{ section.settings.mobile_heading_size | default: 35 }}px;
    --ca-logo-body-size: {{ section.settings.body_size | default: 16 }}px;
    --ca-logo-body-size-mobile: {{ section.settings.mobile_body_size | default: 16 }}px;
    --ca-logo-disclaimer-size: {{ section.settings.disclaimer_size | default: 13 }}px;
    --ca-logo-disclaimer-size-mobile: {{ section.settings.mobile_disclaimer_size | default: 13 }}px;
  "
>
  <div class="ca-logos__inner" data-ca-reveal="{{ section.settings.animation_style | default: 'fade-in' }}">
    <header class="ca-logos__intro">
      {% if section.settings.heading != blank %}
        <h2 class="ca-logos__heading">
          {{ section.settings.heading | escape }}
        </h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <div class="ca-logos__description rte">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </header>
    {% if section.blocks.size > 0 %}
      {% capture logo_slides %}
        {% for block in section.blocks %}
          {% capture logo_content %}
            <div class="ca-logos__tile" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 1000
                  | image_tag:
                    class: 'ca-logos__image',
                    loading: 'lazy',
                    widths: '180, 280, 400, 600, 800, 1000',
                    sizes: '(min-width: 750px) 31vw, 100vw'
                }}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'ca-logos__placeholder' }}
              {% endif %}
            </div>
          {% endcapture %}
          {% render 'slideshow-slide',
            index: forloop.index0,
            children: logo_content,
            class: 'ca-logos__slide'
          %}
        {% endfor %}
      {% endcapture %}
      {% if section.blocks.size > 1 %}
        {% capture logo_controls %}
          {% render 'slideshow-controls',
            style: 'dots',
            item_count: section.blocks.size,
            show_arrows: false,
            autoplay: false,
            pagination_position: 'center'
          %}
        {% endcapture %}
      {% endif %}
      <div class="ca-logos__carousel{% if section.settings.mobile_layout == 'grid' %} ca-logos__carousel--mobile-grid{% endif %}">
        {% render 'slideshow',
          class: 'ca-logos__slideshow',
          slides: logo_slides,
          controls: logo_controls,
          slide_count: section.blocks.size,
          show_arrows: true,
          icon_style: 'chevron',
          icon_shape: 'none',
          infinite: true,
          autoplay: section.settings.autoplay,
          autoplay_speed: section.settings.autoplay_speed
        %}
      </div>
      {% if section.settings.mobile_layout == 'grid' %}
        <div class="ca-logos__mobile-grid">
          {% for block in section.blocks %}
            <div class="ca-logos__tile" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 720
                  | image_tag:
                    class: 'ca-logos__image',
                    loading: 'lazy',
                    widths: '140, 240, 360, 540, 720',
                    sizes: '(max-width: 749px) 50vw, 0px'
                }}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'ca-logos__placeholder' }}
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}
    {% endif %}
    {% if section.settings.disclaimer != blank %}
      <p class="ca-logos__disclaimer">
        {{ section.settings.disclaimer | escape }}
      </p>
    {% endif %}
  </div>
</div>
{% stylesheet %}
  .ca-logos__inner { min-width: 0; }
  .ca-logos__intro { text-align: center; max-width: 1060px; margin: 0 auto 22px; }
  .ca-logos__heading { margin: 0 0 16px; font-size: var(--ca-logo-heading-size); line-height: 1.08; }
  .ca-logos__description { font-size: var(--ca-logo-body-size); line-height: 1.6; }
  .ca-logos__description :is(p, ul, ol) { font-size: inherit; line-height: inherit; }
  .ca-logos__description p { margin: 0; }
  .ca-logos__slideshow slideshow-slides { gap: var(--ca-logo-gap, 10px); }
  .ca-logos__slideshow slideshow-slide {
    flex: 0 0 calc((100% - 2 * var(--ca-logo-gap, 10px)) / 3);
    width: calc((100% - 2 * var(--ca-logo-gap, 10px)) / 3);
    min-width: 0;
    scroll-snap-align: start;
  }
  .ca-logos__tile {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.13);
    background: var(--color-background);
  }
  .ca-logos__image { display: block; width: 100%; height: 100%; object-fit: contain; }
  .ca-logos__placeholder {
    display: block; height: 100%; width: 100%;
    color: rgb(var(--color-foreground-rgb) / 0.2);
    background: rgb(var(--color-foreground-rgb) / 0.04);
  }
  .ca-logos__disclaimer { text-align: center; margin: 18px auto 0; font-size: var(--ca-logo-disclaimer-size); line-height: 1.5; opacity: .68; }
  .ca-logos__mobile-grid { display: none; }
  .ca-logos__carousel slideshow-arrows { pointer-events: none; }
  .ca-logos__carousel slideshow-arrows button { pointer-events: auto; }
  @media screen and (max-width: 749px) {
    .ca-logos__intro { margin-bottom: 18px; }
    .ca-logos__slideshow slideshow-slide {
      flex-basis: calc((100% - (var(--ca-logo-mobile-columns) - 1) * var(--ca-logo-gap)) / var(--ca-logo-mobile-columns));
      width: calc((100% - (var(--ca-logo-mobile-columns) - 1) * var(--ca-logo-gap)) / var(--ca-logo-mobile-columns));
    }
    .ca-logos__carousel--mobile-grid { display: none; }
    .ca-logos__mobile-grid {
      display: grid;
      grid-template-columns: repeat(var(--ca-logo-mobile-columns), minmax(0, 1fr));
      gap: var(--ca-logo-gap, 10px);
    }
    .ca-logos__mobile-grid .ca-logos__tile { min-width: 0; }
  }

  @media screen and (max-width: 749px) {
    .ca-logos__heading { font-size: var(--ca-logo-heading-size-mobile); }
    .ca-logos__description { font-size: var(--ca-logo-body-size-mobile); }
    .ca-logos__disclaimer { font-size: var(--ca-logo-disclaimer-size-mobile); }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "图片轮播",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {"type":"header","content":"基础设置"},
    {
      "type": "select",
      "id": "section_width",
      "label": "内容宽度",
      "options": [
        {
          "value": "page-width",
          "label": "页面宽度"
        },
        {
          "value": "full-width",
          "label": "全宽"
        }
      ],
      "default": "page-width"
    },
    {"type":"header","content":"内容设置"},
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Trusted by Jewelry Partners Worldwide"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "正文",
      "default": "<p>At Craftaurum, we work with jewelry brands and industry partners to bring thoughtful designs and reliable craftsmanship to life. We value long-term collaboration, consistent quality, and solutions tailored to each partner.</p>"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "底部说明",
      "default": "Selected partnerships are shown. Additional collaborations remain confidential under NDA."
    },
    {"type":"header","content":"布局与交互"},
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "自动轮播",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "自动轮播间隔（秒）",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 3
    },
    {"type":"header","content":"移动端布局"},
    {
      "type": "range",
      "id": "mobile_columns",
      "label": "每行显示数量",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 1
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "展示方式",
      "options": [
        {
          "value": "grid",
          "label": "网格"
        },
        {
          "value": "carousel",
          "label": "轮播"
        }
      ],
      "default": "carousel"
    },
    {"type":"header","content":"电脑端字号"},
    {"type":"range","id":"heading_size","label":"标题字号","min":24,"max":72,"step":1,"unit":"px","default":35},
    {"type":"range","id":"body_size","label":"正文字号","min":12,"max":24,"step":1,"unit":"px","default":16},
    {"type":"range","id":"disclaimer_size","label":"底部说明字号","min":10,"max":18,"step":1,"unit":"px","default":13},
    {"type":"header","content":"移动端字号"},
    {"type":"range","id":"mobile_heading_size","label":"标题字号","min":24,"max":72,"step":1,"unit":"px","default":35},
    {"type":"range","id":"mobile_body_size","label":"正文字号","min":12,"max":24,"step":1,"unit":"px","default":16},
    {"type":"range","id":"mobile_disclaimer_size","label":"底部说明字号","min":10,"max":18,"step":1,"unit":"px","default":13},
    {"type":"header","content":"其它设置"},
    {"type":"select","id":"animation_style","label":"入场动画","options":[{"value":"fade-up","label":"Fade Up"},{"value":"fade-in","label":"Fade In"},{"value":"soft-zoom","label":"Soft Zoom"}],"default":"fade-in"},
    {
      "type": "range",
      "id": "padding_top",
      "label": "上边距",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下边距",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "partner",
      "name": "轮播图片",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "图片"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "品牌合作",
      "blocks": [
        {
          "type": "partner"
        },
        {
          "type": "partner"
        },
        {
          "type": "partner"
        },
        {
          "type": "partner"
        },
        {
          "type": "partner"
        },
        {
          "type": "partner"
        }
      ]
    }
  ]
}
{% endschema %}
