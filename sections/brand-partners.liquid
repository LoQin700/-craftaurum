{% comment %}
  Reusable brand partner logo carousel. Images are uploaded in Theme Editor.
  Each instance is isolated and uses native Horizon typography/placeholders.
{% endcomment %}
<section id="BrandPartners-{{ section.id }}" class="brand-partners section section--page-width" style="--bp-gap:10px;--bp-top:{{ section.settings.padding_top }}px;--bp-bottom:{{ section.settings.padding_bottom }}px;" aria-label="{{ section.settings.heading | escape }}">
  <div class="brand-partners__intro">
    {% if section.settings.heading != blank %}
      <h2 class="brand-partners__heading h2">{{ section.settings.heading | escape }}</h2>
    {% endif %}
    {% if section.settings.description != blank %}
      <div class="brand-partners__description rte">{{ section.settings.description }}</div>
    {% endif %}
  </div>
  {% if section.blocks.size > 0 %}
    <div class="brand-partners__carousel" data-bp-carousel>
      <div class="brand-partners__viewport" data-bp-viewport tabindex="0" aria-label="Partner logos">
        <div class="brand-partners__track">
          {% for block in section.blocks %}
            <div class="brand-partners__slide" {{ block.shopify_attributes }}>
              <div class="brand-partners__image">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '200, 400, 600, 800', sizes: '(min-width: 750px) 33vw, 100vw', alt: block.settings.image.alt | default: 'Brand partner logo', class: 'brand-partners__logo' }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'brand-partners__placeholder' }}
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
      {% if section.blocks.size > 1 %}
        <button type="button" class="brand-partners__arrow brand-partners__arrow--prev" data-bp-prev aria-label="Previous logos"><span aria-hidden="true">&#8249;</span></button>
        <button type="button" class="brand-partners__arrow brand-partners__arrow--next" data-bp-next aria-label="Next logos"><span aria-hidden="true">&#8250;</span></button>
        <div class="brand-partners__dots" data-bp-dots aria-label="Logo carousel navigation"></div>
      {% endif %}
    </div>
  {% endif %}
  {% if section.settings.disclaimer != blank %}
    <p class="brand-partners__disclaimer">{{ section.settings.disclaimer | escape }}</p>
  {% endif %}
</section>

<style>
  #BrandPartners-{{ section.id }} {padding-block:var(--bp-top) var(--bp-bottom);}
  #BrandPartners-{{ section.id }} .brand-partners__intro {text-align:center;margin:0 auto 20px;max-width:1120px;}
  #BrandPartners-{{ section.id }} .brand-partners__heading {margin:0 0 15px;}
  #BrandPartners-{{ section.id }} .brand-partners__description {text-align:center;line-height:1.5;}
  #BrandPartners-{{ section.id }} .brand-partners__description p {margin:0;}
  #BrandPartners-{{ section.id }} .brand-partners__carousel {position:relative;}
  #BrandPartners-{{ section.id }} .brand-partners__viewport {overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;scroll-behavior:smooth;overscroll-behavior-inline:contain;}
  #BrandPartners-{{ section.id }} .brand-partners__viewport::-webkit-scrollbar {display:none;}
  #BrandPartners-{{ section.id }} .brand-partners__track {display:flex;gap:var(--bp-gap);}
  #BrandPartners-{{ section.id }} .brand-partners__slide {flex:0 0 calc((100% - 2 * var(--bp-gap)) / 3);min-width:0;scroll-snap-align:start;border:1px solid #e9eaee;aspect-ratio:1/1;}
  #BrandPartners-{{ section.id }} .brand-partners__image {height:100%;width:100%;display:flex;align-items:center;justify-content:center;overflow:hidden;background:var(--color-background);}
  #BrandPartners-{{ section.id }} .brand-partners__logo {display:block;width:100%;height:100%;object-fit:contain;}
  #BrandPartners-{{ section.id }} .brand-partners__placeholder {height:100%;width:100%;background:rgb(var(--color-foreground-rgb) / .04);color:rgb(var(--color-foreground-rgb) / .18);}
  #BrandPartners-{{ section.id }} .brand-partners__arrow {position:absolute;top:calc(50% - 22px);transform:translateY(-50%);z-index:1;border:0;background:transparent;color:var(--color-foreground);font:inherit;font-size:33px;line-height:1;width:36px;height:44px;cursor:pointer;display:flex;align-items:center;justify-content:center;}
  #BrandPartners-{{ section.id }} .brand-partners__arrow--prev {left:0;}
  #BrandPartners-{{ section.id }} .brand-partners__arrow--next {right:0;}
  #BrandPartners-{{ section.id }} .brand-partners__arrow:focus-visible {outline:2px solid currentColor;outline-offset:2px;}
  #BrandPartners-{{ section.id }} .brand-partners__dots {display:flex;align-items:center;justify-content:center;gap:8px;padding-top:14px;}
  #BrandPartners-{{ section.id }} .brand-partners__dot {display:block;width:7px;height:7px;border-radius:50%;border:0;padding:0;background:currentColor;opacity:.25;cursor:pointer;}
  #BrandPartners-{{ section.id }} .brand-partners__dot[aria-current="true"] {opacity:.9;}
  #BrandPartners-{{ section.id }} .brand-partners__disclaimer {text-align:center;margin:16px auto 0;line-height:1.3;color:var(--color-foreground);}
  @media(max-width:749px) {
    #BrandPartners-{{ section.id }} .brand-partners__slide {flex-basis:100%;}
    #BrandPartners-{{ section.id }} .brand-partners__intro {margin-bottom:16px;}
    #BrandPartners-{{ section.id }} .brand-partners__heading {margin-bottom:12px;}
  }
  @media(prefers-reduced-motion:reduce) {
    #BrandPartners-{{ section.id }} .brand-partners__viewport {scroll-behavior:auto;}
  }
</style>
<script>
(function () {
  const root = document.getElementById('BrandPartners-{{ section.id }}');
  if (!root || root.dataset.bpReady === 'true') return;
  root.dataset.bpReady = 'true';
  const viewport = root.querySelector('[data-bp-viewport]');
  const slides = [...root.querySelectorAll('.brand-partners__slide')];
  const dots = root.querySelector('[data-bp-dots]');
  if (!viewport || slides.length < 2) return;
  let timer;
  let current = 0;
  let count = 1;
  const step = () => slides[1].offsetLeft - slides[0].offsetLeft;
  const visible = () => window.matchMedia('(max-width: 749px)').matches ? 1 : 3;
  function refresh() {
    count = Math.max(1, slides.length - visible() + 1);
    current = Math.min(current, count - 1);
    if (dots) {
      dots.replaceChildren();
      for (let i = 0; i < count; i++) {
        const dot = document.createElement('button');
        dot.type = 'button'; dot.className = 'brand-partners__dot';
        dot.setAttribute('aria-label', 'Go to logo ' + (i + 1));
        dot.setAttribute('aria-current', String(i === current));
        dot.addEventListener('click', () => go(i));
        dots.appendChild(dot);
      }
    }
    root.querySelectorAll('.brand-partners__arrow').forEach(b => b.hidden = count < 2);
    viewport.scrollTo({left: current * step(), behavior:'instant'});
  }
  function go(index) {
    current = (index + count) % count;
    viewport.scrollTo({left: current * step(), behavior: 'smooth'});
    dots?.querySelectorAll('button').forEach((b, i) => b.setAttribute('aria-current', String(i === current)));
  }
  root.querySelector('[data-bp-prev]')?.addEventListener('click', () => go(current - 1));
  root.querySelector('[data-bp-next]')?.addEventListener('click', () => go(current + 1));
  let scrollTimeout;
  viewport.addEventListener('scroll', () => {
    clearTimeout(scrollTimeout);
    scrollTimeout = setTimeout(() => {
      current = Math.max(0, Math.min(count - 1, Math.round(viewport.scrollLeft / Math.max(step(),1))));
      dots?.querySelectorAll('button').forEach((b, i) => b.setAttribute('aria-current', String(i === current)));
    }, 90);
  }, {passive:true});
  function stop() {clearInterval(timer);}
  function start() {
    stop();
    if ({{ section.settings.autoplay | json }} && count > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches && !document.hidden)
      timer = setInterval(() => go(current + 1), {{ section.settings.autoplay_speed | times: 1000 | json }});
  }
  viewport.addEventListener('mouseenter', stop);
  viewport.addEventListener('mouseleave', start);
  viewport.addEventListener('focusin', stop);
  viewport.addEventListener('focusout', start);
  const resize = new ResizeObserver(() => {refresh();start();});
  resize.observe(viewport);
  document.addEventListener('visibilitychange', () => document.hidden ? stop() : start());
  document.addEventListener('shopify:section:unload', event => {if (event.detail?.sectionId === {{ section.id | json }}) {stop();resize.disconnect();}});
  refresh(); start();
})();
</script>
{% schema %}
{
  "name": "图片轮播",
  "tag": "section",
  "disabled_on": {"groups":["header","footer"]},
  "settings": [
    {"type":"text","id":"heading","label":"标题","default":"Trusted by Jewelry Partners Worldwide"},
    {"type":"richtext","id":"description","label":"介绍文字","default":"<p>At Craftaurum, we work with jewelry brands and industry partners to bring thoughtful designs and reliable craftsmanship to life. We value long-term collaboration, consistent quality, and solutions tailored to each partner.</p>"},
    {"type":"text","id":"disclaimer","label":"底部说明","default":"Selected partnerships are shown. Additional collaborations remain confidential under NDA."},
    {"type":"checkbox","id":"autoplay","label":"自动轮播","default":true},
    {"type":"range","id":"autoplay_speed","label":"自动轮播间隔（秒）","min":2,"max":10,"step":1,"default":3},
    {"type":"range","id":"padding_top","label":"上边距","min":0,"max":100,"step":4,"unit":"px","default":40},
    {"type":"range","id":"padding_bottom","label":"下边距","min":0,"max":100,"step":4,"unit":"px","default":20}
  ],
  "blocks": [{"type":"partner","name":"轮播图片","settings":[{"type":"image_picker","id":"image","label":"图片"}]}],
  "max_blocks":20,
  "presets":[{"name":"图片轮播","blocks":[{"type":"partner"},{"type":"partner"},{"type":"partner"},{"type":"partner"},{"type":"partner"},{"type":"partner"}]}]
}
{% endschema %}
